# Gemini API key for dream interpretation
GEMINI_API_KEY=xxxxxxxxxxxx

# Supabase PostgreSQL connection string (from Supabase Dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres

# Supabase project URL and service role key (server-side only)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxxxx

NODE_ENV=development
