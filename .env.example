# Gemini API key for dream interpretation
GEMINI_API_KEY=xxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# Optional DeepSeek provider for dream interpretation
INTERPRET_PROVIDER=gemini
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI image generation. Keep this server-side only.
# For OpenAI-compatible third-party gateways, set OPENAI_IMAGE_BASE_URL to that service's /v1 base URL.
# For third-party image APIs with a custom path, set OPENAI_IMAGE_ENDPOINT_URL to the full endpoint.
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_ENDPOINT_URL=https://example.com/v1/draw/completions
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_TIMEOUT_MS=90000
IMAGE_FALLBACK_PROVIDER=pollinations

# Supabase PostgreSQL connection string (from Supabase Dashboard → Settings → Database)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres

# Supabase project URL and service role key (server-side only)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyxxxxxxxxxxxxxxxx

NODE_ENV=development
