/* padding-bottom 交给 app.wxss 的 .screen 统一处理（固定导航 + 安全区），
   这里只覆写左右和顶部内距。之前写死 70rpx 会让主按钮被底部导航切掉。 */
.screen {
  min-height: 100vh;
  padding-top: 48rpx;
  padding-right: 48rpx;
  padding-left: 48rpx;
  color: var(--ink);
}

.brand {
  margin-bottom: var(--space-block);
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 7rpx;
}

.brand-mark {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.profile {
  margin-top: var(--space-group);
}

/* 朱砂只留给 .title-accent 这一处点睛，分享提示条改用旧金细线，
   与 .month-observation / .original-dream 等左边框语言保持一致 */
.share-note {
  display: block;
  margin-top: var(--space-tight);
  padding: 22rpx 24rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.5);
  color: rgba(33, 29, 23, 0.6);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.field-help {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(159, 183, 201, 0.44);
  font-size: var(--fs-label);
  line-height: 1.6;
}

.profile-row {
  display: flex;
  gap: 36rpx;
}

.profile-col {
  flex: 1;
  min-width: 0;
}

.profile-link {
  width: auto !important;
  min-height: var(--tap-min);
  padding: 0 4rpx;
  border-radius: 0;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: var(--tap-min);
}

/* ── 手势采集区：不再是「输入框 + 保存按钮」，整块区域本身就是交互体 ──
   文字区可原地点击编辑；语音圆环常驻，长按说话，下滑提交/上滑取消。
   这一区是全页视觉主角，其余内容（分享横幅、最近的梦）都排在它下方，
   靠滚动可见，不挤占首屏。 */
.capture-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 8rpx;
}

.capture-eyebrow {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
  text-align: center;
}

.capture-textzone {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 260rpx;
  margin-top: var(--space-tight);
  padding: 0 8rpx;
}

.capture-static {
  width: 100%;
  color: var(--ink-55);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  line-height: 1.6;
  text-align: center;
}

.capture-static.has-draft {
  color: var(--ink);
}

/* textarea 默认 height:150px，必须显式给 height 才压得下去；透明背景+
   无边框，编辑态在视觉上尽量贴近静态展示态，减少「切进了另一个控件」的割裂感 */
.capture-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 220rpx;
  background: transparent;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  line-height: 1.6;
  text-align: center;
}

.capture-waveform { display: flex; flex-direction: column; align-items: center; }
.wave-bars { display: flex; align-items: flex-end; justify-content: center; gap: 8rpx; height: 68rpx; }
.wave-bar { width: 6rpx; border-radius: 4rpx; background: rgba(178, 58, 50, 0.6); animation: wave-breathe 0.9s ease-in-out infinite; }
@keyframes wave-breathe {
  0%, 100% { transform: scaleY(0.6); opacity: 0.6; }
  50% { transform: scaleY(1); opacity: 1; }
}
.capture-waveform-note { display: block; margin-top: 14rpx; color: rgba(178, 58, 50, 0.75); font-size: var(--fs-label); text-align: center; }

.capture-recognizing { color: var(--gold-ink); font-size: var(--fs-aux); text-align: center; }

.capture-gesture {
  position: relative;
  margin-top: var(--space-group);
}

.drag-label {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 20rpx);
  white-space: nowrap;
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 1rpx;
  pointer-events: none;
}
.drag-label--submit { color: var(--ink); }
.drag-label--cancel { color: var(--cinnabar-ink); }

/* 正圆语音按钮，全页画面主角。width 必须带 !important，否则会被微信
   button 的内置 184px 压掉，渲染成椭圆（height 不受影响，所以只有宽度
   会失真）——这是项目已踩过的坑。
   极简风格：描边圆环 + 中心一点，颜色随状态切换，不再靠文字标签自证；
   可发现性交给下方的 .capture-hint 一行提示文字承担。
   静止态叠加一圈缓慢的呼吸光晕（3s 一次，box-shadow 外环从 0 扩到
   18rpx 再淡出），幅度克制，读作「呼吸」而非「闪烁」。 */
.voice-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx !important;
  height: 220rpx;
  margin: 0 auto;
  padding: 0;
  border: 2rpx solid rgba(33, 29, 23, 0.32);
  border-radius: 50%;
  background: transparent;
  box-shadow: 0 12rpx 30rpx rgba(109, 79, 38, 0.08), 0 0 0 0 rgba(33, 29, 23, 0.16);
  animation: voice-button-breathe 3s ease-in-out infinite;
  transition: width 0.25s, height 0.25s, border-color 0.25s, background 0.25s;
  touch-action: none;
}
.voice-button::after { border: 0; }

.voice-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(33, 29, 23, 0.4);
  transition: background 0.25s;
}

/* 有草稿、尚未录音：描边与圆心点转旧金，呼应「这段话已经存在」 */
.voice-button.has-draft { border-color: rgba(184, 134, 59, 0.55); }
.voice-button.has-draft .voice-dot { background: var(--gold-ink); }

/* 录音中：只变描边和圆心点的颜色，不再整圆反色，呼吸动画让位给真实的
   录音状态，避免两种动效互相打架 */
.voice-button.is-recording { animation: none; border-color: var(--cinnabar-ink); }
.voice-button.is-recording .voice-dot { background: var(--cinnabar); }

/* 拖拽进入「提交区」：整圆反色，纸色圆心点，视觉上等同「已经确认」 */
.voice-button.is-drag-submit { animation: none; border-color: var(--ink); background: var(--ink); }
.voice-button.is-drag-submit .voice-dot { background: var(--paper); }

/* 拖拽进入「取消区」：朱砂弱化描边，提示「松手即作废」但不过度警告 */
.voice-button.is-drag-cancel { animation: none; border-color: rgba(193, 68, 59, 0.45); }
.voice-button.is-drag-cancel .voice-dot { background: rgba(193, 68, 59, 0.5); }

/* 编辑态：圆环缩小，提示「这只是次要动作，主焦点在打字」，但触摸区域
   仍然是同一个 button，长按说话在编辑中依然可用 */
.voice-button.is-compact { width: 128rpx !important; height: 128rpx; }

.voice-button[disabled] { animation: none; opacity: 0.55; }

@keyframes voice-button-breathe {
  0%, 100% {
    box-shadow: 0 12rpx 30rpx rgba(109, 79, 38, 0.08), 0 0 0 0 rgba(33, 29, 23, 0.16);
  }
  50% {
    box-shadow: 0 12rpx 30rpx rgba(109, 79, 38, 0.08), 0 0 0 18rpx rgba(33, 29, 23, 0);
  }
}

/* 手势最重要的可发现性线索，字号用 --fs-aux 而不是更小的 --fs-label，
   保证「按住说 / 下滑进入解读」这类操作提示在暖纸底上足够清楚 */
.capture-hint {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-aux);
  letter-spacing: 0.5rpx;
  text-align: center;
}

.privacy-note { margin-top: var(--space-tight); color: var(--ink-55); font-size: var(--fs-label); line-height: 1.6; text-align: center; }

.recent-section { margin-top: var(--space-block); }
.recent-heading { display: flex; align-items: center; justify-content: space-between; min-height: var(--tap-min); color: var(--ink-70); font-size: var(--fs-label); letter-spacing: 1rpx; }
.recent-scroll { width: 100%; margin-top: var(--space-tight); white-space: nowrap; }
/* 描边不承担分组职责（卡片本身已用横向滚动+间距分组），换成纸纹底+
   细投影，比一圈灰描边更像一张有厚度的纸片 */
.recent-card { display: inline-flex; flex-direction: column; justify-content: space-between; width: 250rpx; height: 172rpx; margin-right: 16rpx; padding: 20rpx; border: 0; background-color: #fbf6ec; background-image: var(--paper-noise); background-repeat: repeat; background-size: 64rpx 64rpx; box-shadow: 0 4rpx 10rpx rgba(33, 29, 23, 0.08); white-space: normal; }
.recent-card.theme-tide, .recent-card.theme-moon { border-top: 4rpx solid #607f8b; }
.recent-card.theme-threshold, .recent-card.theme-hearth { border-top: 4rpx solid #b8863b; }
.recent-card.theme-shadow, .recent-card.theme-archive { border-top: 4rpx solid #526070; }
.recent-card.theme-falling { border-top: 4rpx solid #b36c62; }
.recent-date { color: var(--ink-55); font-size: var(--fs-label); letter-spacing: 2rpx; }
/* 卡名沿用宋体，呼应梦卡本身的书卷气 */
.recent-title { color: #211d17; font-family: var(--font-serif); font-size: var(--fs-aux); font-weight: 600; line-height: 1.5; }

/* ── 解读进行中的浮层（原 new-dream 页，合并后由首页承载） ── */
.analysis-overlay {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 40rpx 34rpx;
  background: rgba(33, 29, 23, 0.58);
}

.analysis-sheet {
  width: 100%;
  padding: 52rpx 38rpx 42rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.14);
  border-radius: 0;
  background: #f2ecdf;
  box-shadow: 0 28rpx 80rpx rgba(33, 29, 23, 0.28);
}

.analysis-orbit {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 30rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.52);
  border-radius: 50%;
  animation: analysis-spin 3s linear infinite;
}

.analysis-orbit::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 46rpx;
  height: 46rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  border-radius: 50%;
  content: '';
}

/* 解读进行中浮层里唯一的朱砂点睛：轨道上的一粒朱砂，如印泥一点 */
.analysis-orbit-dot {
  position: absolute;
  top: -5rpx;
  left: 28rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  box-shadow: 0 0 18rpx rgba(193, 68, 59, 0.42);
}

@keyframes analysis-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.analysis-eyebrow {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
  text-align: center;
}

.analysis-title {
  display: block;
  margin-top: var(--space-tight);
  color: #211d17;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

.analysis-preview {
  display: block;
  margin-top: var(--space-tight);
  overflow: hidden;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  letter-spacing: 0;
  line-height: 1.7;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「进行中」这条高亮改用旧金，朱砂只留给上方的轨道点 */
.analysis-current {
  margin-top: var(--space-group);
  padding: 28rpx 30rpx;
  border-left: 3rpx solid var(--gold-line);
  background: #fbf6ec;
}

.analysis-current-title {
  display: block;
  color: #211d17;
  font-size: var(--fs-aux);
  letter-spacing: 0;
}

.analysis-current-detail {
  display: block;
  margin-top: 10rpx;
  color: rgba(33, 29, 23, 0.56);
  font-size: var(--fs-label);
  line-height: 1.65;
}

.analysis-elapsed {
  display: block;
  margin-top: 14rpx;
  color: rgba(184, 134, 59, 0.84);
  font-size: var(--fs-label);
  letter-spacing: 0;
}

.analysis-timeline {
  margin-top: var(--space-group);
}

.analysis-step {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 52rpx;
  color: rgba(33, 29, 23, 0.3);
}

.analysis-step:not(:last-child)::before {
  position: absolute;
  top: 35rpx;
  bottom: -17rpx;
  left: 9rpx;
  width: 1rpx;
  background: rgba(33, 29, 23, 0.12);
  content: '';
}

.analysis-step-dot {
  z-index: 1;
  width: 19rpx;
  height: 19rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.24);
  border-radius: 50%;
  background: #f2ecdf;
}

.analysis-step-title {
  font-size: var(--fs-label);
  letter-spacing: 0;
}

.analysis-step.is-done,
.analysis-step.is-active {
  color: rgba(33, 29, 23, 0.72);
}

.analysis-step.is-done .analysis-step-dot {
  border-color: rgba(184, 134, 59, 0.8);
  background: rgba(184, 134, 59, 0.8);
}

.analysis-step.is-active .analysis-step-dot {
  border-color: var(--gold-line);
  box-shadow: 0 0 0 7rpx rgba(184, 134, 59, 0.16);
}

.analysis-note {
  display: block;
  margin-top: var(--space-group);
  color: rgba(33, 29, 23, 0.36);
  font-size: var(--fs-label);
  line-height: 1.6;
  text-align: center;
}
