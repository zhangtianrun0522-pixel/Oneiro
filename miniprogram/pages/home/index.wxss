/* padding-bottom 交给 app.wxss 的 .screen 统一处理（固定导航 + 安全区），
   这里只覆写左右和顶部内距。之前写死 70rpx 会让主按钮被底部导航切掉。 */
.screen {
  min-height: 100vh;
  padding-top: 48rpx;
  padding-right: 48rpx;
  padding-left: 48rpx;
  background: var(--paper);
  color: var(--ink);
}

.brand {
  margin-bottom: var(--space-block);
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 7rpx;
}

.eyebrow {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.title {
  margin-top: var(--space-tight);
  color: #211d17;
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.32;
}

.copy {
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.hero {
  margin-bottom: var(--space-block);
}

.title-accent {
  margin-top: 0;
  color: var(--cinnabar);
}

.hero-note {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-label);
  line-height: 1.6;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100% !important;
  min-height: 108rpx;
  margin-top: 0;
  padding: 0 28rpx;
  border: 0;
  border-radius: 0;
  background: var(--ink);
  color: var(--paper);
  text-align: left;
}

.primary-button-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.primary-button-en {
  color: rgba(242, 236, 223, 0.66);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.primary-button-cn {
  margin-top: 7rpx;
  color: #f2ecdf;
  font-family: var(--font-serif);
  font-size: var(--fs-body);
  font-weight: 600;
}

.primary-button-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid rgba(242, 236, 223, 0.36);
  border-radius: 50%;
  color: #f2ecdf;
  font-size: 28rpx;
  line-height: 1;
}

.profile {
  margin-top: var(--space-group);
}

/* 朱砂只留给 .title-accent 这一处点睛，分享提示条改用旧金细线，
   与 .month-observation / .original-dream 等左边框语言保持一致 */
.share-note {
  display: block;
  margin-top: var(--space-tight);
  padding: 22rpx 24rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.5);
  color: rgba(33, 29, 23, 0.6);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.field-help {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(159, 183, 201, 0.44);
  font-size: var(--fs-label);
  line-height: 1.6;
}

.profile-row {
  display: flex;
  gap: 36rpx;
}

.profile-col {
  flex: 1;
  min-width: 0;
}

.profile-link {
  width: auto !important;
  min-height: var(--tap-min);
  padding: 0 4rpx;
  border-radius: 0;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: var(--tap-min);
}

.capture-surface {
  margin-top: -8rpx;
  padding: 20rpx 0 20rpx;
  border: 0;
}

.capture-surface.has-draft, .capture-surface.is-recording { border: 0; }
.capture-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.capture-label { color: var(--gold-ink); font-size: var(--fs-label); font-weight: 700; letter-spacing: 1rpx; }
.capture-prompt { color: var(--ink-55); font-size: var(--fs-label); }
/* textarea 默认 height:150px，min-height 压不下去，必须显式给 height */
.dream-input { box-sizing: border-box; width: 100%; height: 200rpx; padding: 12rpx 0; background: transparent; color: var(--ink); font-size: var(--fs-body); line-height: 1.8; }
/* 版式节奏用旧金细线，与灰墨分隔线区分开 */
.capture-divider { height: 1rpx; margin: 4rpx 0 20rpx; background: rgba(184, 134, 59, 0.32); }

/* 正圆语音按钮。width 必须带 !important，否则会被微信 button 的
   内置 184px 压掉，渲染成椭圆（height 不受影响，所以只有宽度会失真）。 */
.voice-button {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 188rpx !important;
  height: 188rpx;
  margin: 0 auto;
  padding: 0;
  border: 2rpx solid rgba(184, 134, 59, 0.72);
  border-radius: 50%;
  background: rgba(184, 134, 59, 0.12);
  box-shadow: 0 12rpx 30rpx rgba(109, 79, 38, 0.1), inset 0 0 0 10rpx rgba(251, 246, 236, 0.5);
  color: var(--gold-ink);
  font-size: var(--fs-aux);
  font-weight: 700;
  line-height: 1.45;
}
.voice-button::after { border: 0; }
.voice-button-icon { margin: 0 0 6rpx; font-size: 40rpx; font-weight: 400; line-height: 1; }
.voice-button.recording { border-color: var(--cinnabar-ink); background: var(--cinnabar-ink); color: var(--paper-raised); box-shadow: 0 12rpx 32rpx rgba(169, 86, 75, 0.24), inset 0 0 0 10rpx rgba(251, 246, 236, 0.12); }
.voice-button[disabled] { opacity: 0.55; }
.voice-hint, .recognizing-note, .privacy-note { display: block; margin-top: var(--space-tight); color: var(--ink-55); font-size: var(--fs-label); text-align: center; }
.recognizing-note { color: var(--gold-ink); font-size: var(--fs-aux); }
.privacy-note { margin-top: var(--space-tight); color: var(--ink-55); line-height: 1.6; }

.recent-section { margin-top: var(--space-block); }
.recent-heading { display: flex; align-items: center; justify-content: space-between; min-height: var(--tap-min); color: var(--ink-70); font-size: var(--fs-label); letter-spacing: 1rpx; }
.recent-scroll { width: 100%; margin-top: var(--space-tight); white-space: nowrap; }
.recent-card { display: inline-flex; flex-direction: column; justify-content: space-between; width: 250rpx; height: 172rpx; margin-right: 16rpx; padding: 20rpx; border: 1rpx solid rgba(33, 29, 23, 0.12); background: #fbf6ec; white-space: normal; }
.recent-card.theme-tide, .recent-card.theme-moon { border-top: 4rpx solid #607f8b; }
.recent-card.theme-threshold, .recent-card.theme-hearth { border-top: 4rpx solid #b8863b; }
.recent-card.theme-shadow, .recent-card.theme-archive { border-top: 4rpx solid #526070; }
.recent-card.theme-falling { border-top: 4rpx solid #b36c62; }
.recent-date { color: var(--ink-55); font-size: var(--fs-label); letter-spacing: 2rpx; }
/* 卡名沿用宋体，呼应梦卡本身的书卷气 */
.recent-title { color: #211d17; font-family: var(--font-serif); font-size: var(--fs-aux); font-weight: 600; line-height: 1.5; }

/* ── 解读进行中的浮层（原 new-dream 页，合并后由首页承载） ── */
.analysis-overlay {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 40rpx 34rpx;
  background: rgba(33, 29, 23, 0.58);
}

.analysis-sheet {
  width: 100%;
  padding: 52rpx 38rpx 42rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.14);
  border-radius: 0;
  background: #f2ecdf;
  box-shadow: 0 28rpx 80rpx rgba(33, 29, 23, 0.28);
}

.analysis-orbit {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 30rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.52);
  border-radius: 50%;
  animation: analysis-spin 3s linear infinite;
}

.analysis-orbit::after {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 46rpx;
  height: 46rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  border-radius: 50%;
  content: '';
}

/* 解读进行中浮层里唯一的朱砂点睛：轨道上的一粒朱砂，如印泥一点 */
.analysis-orbit-dot {
  position: absolute;
  top: -5rpx;
  left: 28rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  box-shadow: 0 0 18rpx rgba(193, 68, 59, 0.42);
}

@keyframes analysis-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.analysis-eyebrow {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
  text-align: center;
}

.analysis-title {
  display: block;
  margin-top: var(--space-tight);
  color: #211d17;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

.analysis-preview {
  display: block;
  margin-top: var(--space-tight);
  overflow: hidden;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  letter-spacing: 0;
  line-height: 1.7;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 「进行中」这条高亮改用旧金，朱砂只留给上方的轨道点 */
.analysis-current {
  margin-top: var(--space-group);
  padding: 28rpx 30rpx;
  border-left: 3rpx solid var(--gold-line);
  background: #fbf6ec;
}

.analysis-current-title {
  display: block;
  color: #211d17;
  font-size: var(--fs-aux);
  letter-spacing: 0;
}

.analysis-current-detail {
  display: block;
  margin-top: 10rpx;
  color: rgba(33, 29, 23, 0.56);
  font-size: var(--fs-label);
  line-height: 1.65;
}

.analysis-elapsed {
  display: block;
  margin-top: 14rpx;
  color: rgba(184, 134, 59, 0.84);
  font-size: var(--fs-label);
  letter-spacing: 0;
}

.analysis-timeline {
  margin-top: var(--space-group);
}

.analysis-step {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 52rpx;
  color: rgba(33, 29, 23, 0.3);
}

.analysis-step:not(:last-child)::before {
  position: absolute;
  top: 35rpx;
  bottom: -17rpx;
  left: 9rpx;
  width: 1rpx;
  background: rgba(33, 29, 23, 0.12);
  content: '';
}

.analysis-step-dot {
  z-index: 1;
  width: 19rpx;
  height: 19rpx;
  margin-right: 24rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.24);
  border-radius: 50%;
  background: #f2ecdf;
}

.analysis-step-title {
  font-size: var(--fs-label);
  letter-spacing: 0;
}

.analysis-step.is-done,
.analysis-step.is-active {
  color: rgba(33, 29, 23, 0.72);
}

.analysis-step.is-done .analysis-step-dot {
  border-color: rgba(184, 134, 59, 0.8);
  background: rgba(184, 134, 59, 0.8);
}

.analysis-step.is-active .analysis-step-dot {
  border-color: var(--gold-line);
  box-shadow: 0 0 0 7rpx rgba(184, 134, 59, 0.16);
}

.analysis-note {
  display: block;
  margin-top: var(--space-group);
  color: rgba(33, 29, 23, 0.36);
  font-size: var(--fs-label);
  line-height: 1.6;
  text-align: center;
}
