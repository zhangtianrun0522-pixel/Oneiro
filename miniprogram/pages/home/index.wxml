<view class="screen">
  <view class="brand"><text>ONEIRO</text></view>

  <view class="capture-stage">
    <text class="capture-eyebrow">{{heroCardNo}} · {{heroDate}}</text>

    <view class="capture-textzone">
      <view wx:if="{{recording}}" class="capture-waveform">
        <view class="wave-bars">
          <view class="wave-bar" style="height:24rpx;animation-delay:0s"></view>
          <view class="wave-bar" style="height:52rpx;animation-delay:0.1s"></view>
          <view class="wave-bar" style="height:36rpx;animation-delay:0.2s"></view>
          <view class="wave-bar" style="height:60rpx;animation-delay:0.3s"></view>
          <view class="wave-bar" style="height:32rpx;animation-delay:0.15s"></view>
        </view>
        <text class="capture-waveform-note">{{recordingSeconds}}s · 松开完成</text>
      </view>
      <view wx:elif="{{recognizing}}" class="capture-recognizing">
        <text>正在整理刚才的话…</text>
      </view>
      <textarea
        wx:elif="{{editingDream}}"
        class="capture-textarea"
        value="{{dreamText}}"
        maxlength="1200"
        focus="{{editingDream}}"
        auto-height="{{false}}"
        bindinput="onDreamInput"
        bindblur="onDreamTextBlur"
      />
      <view wx:else class="capture-static {{dreamText ? 'has-draft' : ''}}" bindtap="onDreamTextTap">
        <text>{{dreamText || '今天醒来，还记得什么？'}}</text>
      </view>
    </view>

    <view class="capture-gesture">
      <text
        wx:if="{{dragZone !== 'none'}}"
        class="drag-label {{dragZone === 'submit' ? 'drag-label--submit' : 'drag-label--cancel'}}"
        style="transform: translate(calc(-50% + {{dragDx}}px), {{dragDy}}px);"
      >{{dragZone === 'submit' ? '松开进入解读' : '松开取消'}}</text>
      <button
        class="voice-button {{editingDream ? 'is-compact' : ''}} {{recording ? 'is-recording' : ''}} {{!recording && dreamText ? 'has-draft' : ''}} {{dragZone === 'submit' ? 'is-drag-submit' : ''}} {{dragZone === 'cancel' ? 'is-drag-cancel' : ''}}"
        style="transform: translate({{dragDx}}px, {{dragDy}}px);"
        bindtouchstart="onVoiceTouchStart"
        bindtouchmove="onVoiceTouchMove"
        bindtouchend="onVoiceTouchEnd"
        bindtouchcancel="onVoiceTouchCancel"
        disabled="{{recognizing}}"
      >
        <view class="voice-dot"></view>
      </button>
    </view>

    <text class="capture-hint">
      <block wx:if="{{editingDream}}">轻触圆环外收起 · 仍可按住说</block>
      <block wx:elif="{{recording}}">下滑进入解读 · 上滑取消</block>
      <block wx:elif="{{dreamText}}">按住可继续说 · 下滑进入解读</block>
      <block wx:else>按住说 · 或轻触文字输入</block>
    </text>
  </view>

  <text wx:if="{{fromShare}}" class="share-note">你刚看到的是一张去隐私的梦卡。你也可以从一个画面开始，私密记下自己的梦。</text>
  <text class="privacy-note">原梦会先保存，出生资料完全自愿。</text>

  <view wx:if="{{recentDreams.length}}" class="recent-section">
    <view class="recent-heading">
      <text>最近的梦</text>
      <text bindtap="openArchive">打开梦境档案 →</text>
    </view>
    <scroll-view class="recent-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view wx:for="{{recentDreams}}" wx:key="id" class="recent-card theme-{{item.theme}}" data-id="{{item.id}}" bindtap="openRecentDream">
        <text class="recent-date">{{item.date}}</text>
        <text class="recent-title">{{item.title}}</text>
      </view>
    </scroll-view>
  </view>
</view>

<view wx:if="{{analysisActive}}" class="analysis-overlay">
  <view class="analysis-sheet">
    <view class="analysis-orbit"><view class="analysis-orbit-dot"></view></view>
    <text class="analysis-eyebrow">ONEIRO · DREAM READING</text>
    <text class="analysis-title">正在展开这场梦</text>
    <text class="analysis-preview">“{{analysisPreview}}”</text>

    <view class="analysis-current">
      <text class="analysis-current-title">{{analysisStageTitle}}</text>
      <text class="analysis-current-detail">{{analysisStageDetail}}</text>
      <text class="analysis-elapsed">已用时 {{analysisElapsedSeconds}} 秒</text>
    </view>

    <view class="analysis-timeline">
      <view wx:for="{{analysisStages}}" wx:key="title" class="analysis-step {{index < analysisStageIndex ? 'is-done' : ''}} {{index === analysisStageIndex ? 'is-active' : ''}}">
        <view class="analysis-step-dot"></view>
        <text class="analysis-step-title">{{item.title}}</text>
      </view>
    </view>

    <text class="analysis-note">完整解读正在生成中，内容不会因为等待而被缩短。</text>
  </view>
</view>
