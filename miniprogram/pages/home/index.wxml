<view class="screen">
  <view class="brand">
    <text>ONEIRO</text>
    <button class="profile-link" bindtap="openProfile">我的资料</button>
  </view>

  <view wx:if="{{revisit}}" class="revisit-card">
    <text class="revisit-title">昨天的梦「{{revisit.title}}」</text>
    <text class="revisit-question">{{revisit.question}}</text>
    <view wx:if="{{!revisitAnswering}}" class="revisit-actions">
      <button class="revisit-answer-button" bindtap="startAnswerRevisit">回答</button>
      <button class="revisit-skip-button" bindtap="skipRevisitPrompt">跳过</button>
    </view>
    <text wx:if="{{!revisitAnswering}}" class="revisit-disable-link" bindtap="disableRevisitPrompts">不再提醒</text>
    <view wx:else class="revisit-composer">
      <textarea
        class="revisit-textarea"
        bindinput="onRevisitAnswerInput"
        value="{{revisitAnswerText}}"
        maxlength="300"
        auto-height
      />
      <button class="revisit-send-button" bindtap="submitRevisitAnswer">发送</button>
    </view>
  </view>

  <view class="hero">
    <text class="eyebrow">Private Dream Memory</text>
    <text class="title">它不替你预测命运，但会越来越理解你的梦</text>
    <text wx:if="{{fromShare}}" class="share-note">你刚看到的是一张去隐私的梦卡。你也可以从一个画面开始，私密记下自己的梦。</text>
    <view class="copy">
      <text>先保留原梦，再从梦中事实出发，给出有边界、可以被你否定的理解。</text>
    </view>
  </view>

  <button class="primary-button" bindtap="startDream">记下刚才的梦</button>
  <button class="ghost-button archive-button" bindtap="openArchive">打开梦境档案</button>
</view>
