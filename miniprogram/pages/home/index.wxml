<!-- 页面内不再重复 ONEIRO：微信原生导航栏已经用 index.json 的
     navigationBarTitleText 显示了同样四个字，两处相隔十几个像素出现同一个词，
     读起来是渲染重复，也白占掉首屏最上面一块留白。 -->
<view class="screen">
  <view class="capture-stage">
    <text class="capture-eyebrow">{{heroCardNo}} · {{heroDate}}</text>

    <view class="capture-textzone">
      <!-- 录音/识别状态是独立的一行，不再和已输入的草稿文字互斥切换——草稿
           必须在这两种状态下持续可见，这正是真机验收发现的「下滑时文字被
           挡住/换掉」问题的根因（原来是 wx:elif 整块替换，不是遮罩）。 -->
      <view class="capture-status" wx:if="{{recording || recognizing}}">
        <view wx:if="{{recording}}" class="capture-waveform">
          <view class="wave-bars">
            <view class="wave-bar" style="height:18rpx;animation-delay:0s"></view>
            <view class="wave-bar" style="height:30rpx;animation-delay:0.1s"></view>
            <view class="wave-bar" style="height:22rpx;animation-delay:0.2s"></view>
            <view class="wave-bar" style="height:34rpx;animation-delay:0.3s"></view>
            <view class="wave-bar" style="height:20rpx;animation-delay:0.15s"></view>
          </view>
          <text class="capture-waveform-note">{{recordingSeconds}}s · 松开完成</text>
        </view>
        <text wx:elif="{{recognizing}}" class="capture-recognizing">正在整理刚才的话…</text>
      </view>

      <scroll-view wx:if="{{!editingDream}}" class="capture-textscroll" scroll-y="{{true}}">
        <view class="capture-static {{dreamText ? 'has-draft' : ''}}" bindtap="onDreamTextTap">
          <text>{{dreamText || '今天醒来，还记得什么？'}}</text>
        </view>
      </scroll-view>
      <textarea
        wx:else
        class="capture-textarea"
        value="{{dreamText}}"
        maxlength="1200"
        focus="{{editingDream}}"
        auto-height="{{false}}"
        bindinput="onDreamInput"
        bindblur="onDreamTextBlur"
      />
    </view>

    <view class="capture-gesture">
      <text
        wx:if="{{dragZone === 'cancel'}}"
        class="drag-label drag-label--cancel"
        style="transform: translate(calc(-50% + {{dragDx}}px), {{dragDy}}px);"
      >松开取消</text>
      <button
        class="voice-button {{editingDream ? 'is-compact' : ''}} {{recording ? 'is-recording' : ''}} {{!recording && dreamText ? 'has-draft' : ''}} {{voicePressed ? 'is-pressed' : ''}} {{dragZone === 'submit' ? 'is-drag-submit' : ''}} {{dragZone === 'cancel' ? 'is-drag-cancel' : ''}}"
        style="transform: translate({{dragDx}}px, {{dragDy}}px);"
        bindtouchstart="onVoiceTouchStart"
        catchtouchmove="onVoiceTouchMove"
        bindtouchend="onVoiceTouchEnd"
        bindtouchcancel="onVoiceTouchCancel"
        disabled="{{recognizing}}"
      >
        <view class="voice-dot"></view>
      </button>

      <!-- 圆环下方这块既是「下滑提交」的落点，也是可以直接点的提交按钮。
           内测反馈里最集中的一条就是「不知道要按着圆圈下滑」——一个只能靠
           手势触发的主流程，对第一次用的人等于没有入口。所以这里改成真正的
           button：有草稿时它就是一个写着「解读这个梦」的实体按钮，点一下即可；
           下滑仍然有效，作为已经学会的人的快捷方式，两条路通向同一个方法。

           它必须始终占位：原来用 wx:if 条件渲染，一旦拖过 16px 就凭空插入一个
           176rpx 高的块，把下面的提示文字整体顶下去——手势进行到一半页面自己
           跳一下。现在常驻占位、只切换可见度与可点性。 -->
      <button
        class="confirm-target {{recording ? 'is-target' : ''}} {{!recording && dreamText ? 'is-actionable' : ''}} {{dragZone === 'submit' ? 'is-armed' : ''}} {{dragZone === 'attempt' ? 'is-near' : ''}}"
        disabled="{{recording || recognizing || !dreamText}}"
        bindtap="onSubmitTap"
      >
        <text class="confirm-target-label">{{dragZone === 'submit' ? '松开 · 进入解读' : recording ? '下滑到这里' : '解读这个梦'}}</text>
      </button>
    </view>

    <text class="capture-hint">
      <block wx:if="{{editingDream}}">写完点上方「解读这个梦」· 仍可按住圆环说</block>
      <!-- 录音中这一行是整个手势唯一的说明书，三条出路必须一次说全：落点条
           只讲了下滑，上滑取消和「直接松手就转文字」没有别的地方会说。 -->
      <block wx:elif="{{recording}}">上滑取消 · 下滑直接解读 · 松手转成文字</block>
      <!-- 有草稿时不再只写手势。点击是主路径，下滑降级成「也可以」。 -->
      <block wx:elif="{{dreamText}}">按住圆环可继续说 · 也可按住下滑</block>
      <block wx:else>按住说 · 或轻触文字输入</block>
    </text>
  </view>

  <text wx:if="{{fromShare}}" class="share-note">你刚看到的是一张去隐私的梦卡。你也可以从一个画面开始，私密记下自己的梦。</text>
</view>

<view wx:if="{{analysisActive}}" class="analysis-overlay">
  <view class="analysis-sheet">
    <view class="analysis-orbit"><view class="analysis-orbit-dot"></view></view>
    <text class="analysis-eyebrow">ONEIRO · DREAM READING</text>
    <text class="analysis-title">正在展开这场梦</text>
    <text class="analysis-preview">“{{analysisPreview}}”</text>

    <view class="analysis-current">
      <text class="analysis-current-title">{{analysisStageTitle}}</text>
      <text class="analysis-current-detail">{{analysisStageDetail}}</text>
      <text class="analysis-elapsed">已用时 {{analysisElapsedSeconds}} 秒</text>
    </view>

    <view class="analysis-timeline">
      <view wx:for="{{analysisStages}}" wx:key="title" class="analysis-step {{index < analysisStageIndex ? 'is-done' : ''}} {{index === analysisStageIndex ? 'is-active' : ''}}">
        <view class="analysis-step-dot"></view>
        <text class="analysis-step-title">{{item.title}}</text>
      </view>
    </view>

    <text class="analysis-note">完整解读正在生成中，内容不会因为等待而被缩短。</text>
  </view>
</view>
