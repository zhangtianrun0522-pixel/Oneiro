<view class="artifact-screen">
  <view class="artifact-brand">
    <text>ONEIRO</text>
    <text class="artifact-brand-subtitle">DREAM ARTIFACT</text>
  </view>

  <view class="format-tabs">
    <button
      class="format-tab {{activeFormat === '5x4' ? 'format-tab-active' : ''}}"
      bindtap="switchFormat"
      data-format="5x4"
    >聊天 / 群分享 · 5:4</button>
    <button
      class="format-tab {{activeFormat === '3x4' ? 'format-tab-active' : ''}}"
      bindtap="switchFormat"
      data-format="3x4"
    >朋友圈 / 首图 · 3:4</button>
  </view>

  <view class="canvas-stage">
    <canvas
      type="2d"
      id="artifactCanvas5x4"
      class="artifact-canvas canvas-5x4 {{activeFormat === '5x4' ? '' : 'canvas-hidden'}}"
    ></canvas>
    <canvas
      type="2d"
      id="artifactCanvas3x4"
      class="artifact-canvas canvas-3x4 {{activeFormat === '3x4' ? '' : 'canvas-hidden'}}"
    ></canvas>
  </view>

  <view class="artifact-actions">
    <button class="artifact-save-button" bindtap="saveCurrentFormat">保存到相册</button>
    <button class="artifact-share-button" open-type="share">转发给朋友</button>
  </view>

  <text class="artifact-note">同一份梦境观察，以当前尺寸独立排版生成</text>
</view>
