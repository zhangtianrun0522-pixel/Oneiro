page {
  min-height: 100%;
  background: #050609;
}

.artifact-screen {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 32rpx 56rpx;
  background: #050609;
  color: rgba(255, 255, 255, 0.86);
}

.artifact-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  color: rgba(239, 228, 200, 0.82);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
}

.artifact-brand-subtitle {
  color: rgba(159, 183, 201, 0.42);
  font-size: 16rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.format-tabs {
  display: flex;
  gap: 14rpx;
  margin-top: 38rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(202, 177, 117, 0.12);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.025);
}

.format-tab {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 18rpx 10rpx;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.34);
  font-size: 20rpx;
  line-height: 1.4;
}

.format-tab::after {
  border: 0;
}

.format-tab-active {
  background: rgba(202, 177, 117, 0.16);
  color: rgba(239, 228, 200, 0.86);
}

.canvas-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 850rpx;
  margin-top: 34rpx;
}

.artifact-canvas {
  display: block;
  background: #0d0f16;
  box-shadow: 0 28rpx 80rpx rgba(0, 0, 0, 0.48);
}

.canvas-5x4 {
  width: 686rpx;
  height: 549rpx;
}

.canvas-3x4 {
  width: 600rpx;
  height: 800rpx;
}

.canvas-hidden {
  position: fixed;
  left: -9999px;
}

.artifact-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 32rpx;
}

.artifact-save-button,
.artifact-share-button {
  flex: 1;
  margin: 0;
  padding: 24rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

.artifact-save-button::after,
.artifact-share-button::after {
  border: 0;
}

.artifact-save-button {
  background: rgba(202, 177, 117, 0.16);
  color: rgba(239, 228, 200, 0.9);
}

.artifact-share-button {
  border: 1rpx solid rgba(202, 177, 117, 0.3);
  background: transparent;
  color: rgba(239, 228, 200, 0.72);
}

.artifact-note {
  display: block;
  margin-top: 24rpx;
  color: rgba(255, 255, 255, 0.24);
  font-size: 19rpx;
  line-height: 1.6;
  text-align: center;
}
