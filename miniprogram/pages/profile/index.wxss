.profile-intro {
  display: block;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.42);
  font-size: 24rpx;
  line-height: 1.75;
}

.memory-section {
  margin-top: 34rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.035);
}

.supporting-section {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
}

.supporting-section .memory-title {
  font-size: 26rpx;
}

.supporting-section .memory-summary {
  margin-top: 14rpx;
  font-size: 22rpx;
}

.supporting-section .memory-kicker {
  font-size: 15rpx;
}

.fact-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.fact-copy {
  flex: 1;
  min-width: 0;
  color: rgba(255, 255, 255, 0.58);
  font-size: 23rpx;
  line-height: 1.7;
}

.fact-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 18rpx;
  color: rgba(202, 177, 117, 0.58);
  font-size: 19rpx;
  line-height: 1.7;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.memory-kicker,
.memory-title,
.memory-summary,
.monthly-label,
.monthly-title,
.monthly-copy,
.portrait-status,
.portrait-summary,
.portrait-reason,
.portrait-note,
.history-title,
.form-section-title {
  display: block;
}

.memory-kicker {
  color: rgba(159, 183, 201, 0.42);
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.memory-title {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 31rpx;
  font-weight: 650;
}

.memory-count,
.portrait-version {
  color: rgba(202, 177, 117, 0.72);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.portrait-focus-label {
  color: rgba(202, 177, 117, 0.72);
  font-size: 20rpx;
  font-weight: 800;
}

.memory-summary {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 24rpx;
  line-height: 1.75;
}

.monthly-label,
.portrait-status,
.history-title {
  color: rgba(202, 177, 117, 0.58);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.portrait-card {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(159, 183, 201, 0.14);
  border-radius: 22rpx;
  background: rgba(8, 12, 20, 0.28);
}

.portrait-feature {
  padding: 30rpx 28rpx;
  border-color: rgba(202, 177, 117, 0.22);
  background: rgba(8, 12, 20, 0.36);
}

.portrait-empty-card {
  border-color: rgba(159, 183, 201, 0.1);
}

.portrait-empty-title {
  display: block;
  color: rgba(255, 255, 255, 0.68);
  font-size: 26rpx;
  font-weight: 600;
}

.portrait-empty-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 22rpx;
  line-height: 1.7;
}

.portrait-summary {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 25rpx;
  line-height: 1.78;
}

.portrait-reason,
.portrait-note {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.32);
  font-size: 20rpx;
  line-height: 1.65;
}

.portrait-editor {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(159, 183, 201, 0.2);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.05);
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.7;
}

.portrait-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.portrait-primary,
.portrait-secondary,
.portrait-link,
.portrait-generate {
  width: auto;
  margin: 0;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.5;
}

.portrait-secondary,
.portrait-link {
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: transparent;
  color: rgba(255, 255, 255, 0.56);
}

.portrait-link {
  margin-top: 22rpx;
}

.portrait-generate {
  margin-top: 24rpx;
  border: 1rpx solid rgba(159, 183, 201, 0.22);
  background: rgba(159, 183, 201, 0.1);
  color: rgba(255, 255, 255, 0.7);
}

.portrait-primary::after,
.portrait-secondary::after,
.portrait-link::after,
.portrait-generate::after {
  border: 0;
}

.portrait-history {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.portrait-history-toggle {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  color: rgba(255, 255, 255, 0.38);
  font-size: 20rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.34);
  font-size: 19rpx;
}

.history-copy {
  display: flex;
  flex: 1;
  justify-content: space-between;
  gap: 14rpx;
}

.history-restore {
  flex: 0 0 auto;
  margin: 0;
  padding: 4rpx 14rpx;
  border: 1rpx solid rgba(202, 177, 117, 0.18);
  border-radius: 999rpx;
  background: transparent;
  color: rgba(202, 177, 117, 0.62);
  font-size: 18rpx;
  line-height: 1.5;
}

.history-restore::after {
  border: 0;
}

.form-section-title {
  margin-top: 44rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 30rpx;
  font-weight: 650;
}

.field-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.clear-field {
  height: 54rpx;
  color: rgba(219, 132, 124, 0.62);
  font-size: 20rpx;
  line-height: 54rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.privacy-copy {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.28);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

/* Claude Design profile: a current portrait, life notes, then optional facts. */
.profile-intro { border-color: rgba(33, 29, 23, 0.1); color: rgba(33, 29, 23, 0.58); }
.memory-section { border: 0; border-radius: 0; background: #fbf6ec; }
.portrait-section { border-top: 2rpx solid rgba(184, 134, 59, 0.62); background: #fbf6ec; }
.facts-section { background: transparent; }
.memory-kicker { color: rgba(33, 29, 23, 0.45); }
.memory-title { color: #211d17; }
.memory-count, .portrait-version, .portrait-focus-label { color: #b8863b; }
.memory-summary { color: rgba(33, 29, 23, 0.68); }
.fact-item { border-top-color: rgba(33, 29, 23, 0.1); }
.fact-copy { color: rgba(33, 29, 23, 0.72); }
.fact-actions { color: #b8863b; }
.portrait-card { border-color: rgba(33, 29, 23, 0.13); border-radius: 0; background: transparent; }
.portrait-feature { border-color: rgba(184, 134, 59, 0.42); background: rgba(242, 236, 223, 0.52); }
.portrait-empty-title { color: rgba(33, 29, 23, 0.74); }
.portrait-empty-copy { color: rgba(33, 29, 23, 0.52); }
.portrait-summary { color: #211d17; }
.portrait-reason, .portrait-note { color: rgba(33, 29, 23, 0.44); }
.portrait-editor { border-color: rgba(33, 29, 23, 0.2); border-radius: 0; background: #fdfaf2; color: #211d17; }
.portrait-primary { background: #c1443b; color: #fbf6ec; }
.portrait-secondary, .portrait-link { border-color: rgba(33, 29, 23, 0.18); background: transparent; color: rgba(33, 29, 23, 0.66); }
.portrait-secondary.quiet, .portrait-link { color: rgba(33, 29, 23, 0.54); }
.portrait-generate { border-color: rgba(33, 29, 23, 0.2); background: transparent; color: rgba(33, 29, 23, 0.72); }
.portrait-history, .portrait-history-toggle { border-top-color: rgba(33, 29, 23, 0.1); }
.portrait-history-toggle, .history-item { color: rgba(33, 29, 23, 0.48); }
.history-restore { border-color: rgba(184, 134, 59, 0.36); border-radius: 0; color: #b8863b; }
.form-section-title { color: #211d17; }
.clear-field { color: #c1443b; }
.privacy-copy { color: rgba(33, 29, 23, 0.42); }
.profile-screen { padding-bottom: 148rpx; }

.profile-revisit {
  margin-top: 32rpx;
  padding: 28rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.72);
  background: #fbf6ec;
}

.profile-revisit-kicker,
.profile-revisit-title,
.profile-revisit-question,
.profile-revisit-disable {
  display: block;
}

.profile-revisit-kicker {
  color: #b8863b;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.profile-revisit-title {
  margin-top: 12rpx;
  color: #211d17;
  font-size: 27rpx;
  font-weight: 600;
}

.profile-revisit-question {
  margin-top: 12rpx;
  color: rgba(33, 29, 23, 0.7);
  font-size: 25rpx;
  line-height: 1.75;
}

.profile-revisit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.profile-revisit-answer,
.profile-revisit-skip,
.profile-revisit-send {
  height: 68rpx;
  margin: 0;
  border-radius: 0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 68rpx;
}

.profile-revisit-answer {
  flex: 1;
  background: #211d17;
  color: #fbf6ec;
}

.profile-revisit-skip {
  flex: 1;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  background: transparent;
  color: rgba(33, 29, 23, 0.58);
}

.profile-revisit-disable {
  margin-top: 18rpx;
  color: rgba(33, 29, 23, 0.38);
  font-size: 19rpx;
  text-align: center;
}

.profile-revisit-composer {
  margin-top: 22rpx;
}

.profile-revisit-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  max-height: 260rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.16);
  border-radius: 0;
  background: #fdfaf2;
  color: #211d17;
  font-size: 25rpx;
  line-height: 1.6;
}

.profile-revisit-send {
  display: block;
  width: 150rpx;
  margin-top: 16rpx;
  margin-left: auto;
  background: #211d17;
  color: #fbf6ec;
}

.profile-revisit-answer::after,
.profile-revisit-skip::after,
.profile-revisit-send::after {
  border: 0;
}
