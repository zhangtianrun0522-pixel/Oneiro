.profile-screen { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

.basic-info-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.08);
}

/* 回访的实底暖金卡改由页脚的 .footer-panel 提供底色，这里只留文字样式。
   底色仍是 #EDE4D0，原有核算不变：--ink 13.26:1，--ink-70 5.87:1。 */
.profile-revisit-title,
.profile-revisit-question,
.profile-revisit-disable {
  display: block;
}

.profile-revisit-title {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 600;
}

.profile-revisit-question {
  margin-top: 8rpx;
  font-family: var(--font-serif);
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.profile-revisit-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 20rpx;
}

/* 回答 / 跳过 / 关闭提醒 三个动作全部降为文字链，呼应设计稿的
   扁平语言；button 已被 app.wxss 的 `button{width:auto!important}`
   复位，这里只补文字样式 */
.profile-revisit-answer,
.profile-revisit-skip {
  margin: 0 !important;
  min-height: var(--tap-min);
  font-size: 23rpx;
  line-height: var(--tap-min);
}

.profile-revisit-answer {
  color: var(--ink);
  font-weight: 600;
}

.profile-revisit-skip {
  color: var(--ink-70);
}

.profile-revisit-disable {
  min-height: var(--tap-min);
  color: var(--ink-70);
  font-size: 23rpx;
  line-height: var(--tap-min);
}

.profile-revisit-answer::after,
.profile-revisit-skip::after {
  border: 0;
}

.profile-revisit-composer {
  margin-top: var(--space-group);
}

.profile-revisit-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  max-height: 260rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.16);
  border-radius: 0;
  background: #fdfaf2;
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.profile-revisit-send {
  display: block;
  width: 150rpx !important;
  margin-top: var(--space-tight);
  margin-left: auto;
  background: var(--ink);
  color: var(--paper);
}

.profile-revisit-send::after {
  border: 0;
}

/* ── 画像的加载 / 空 / 失败态 ── */
.portrait-loading-card,
.portrait-empty-card {
  margin-top: var(--space-tight);
}

.portrait-loading-copy,
.portrait-empty-copy {
  display: block;
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.portrait-empty-copy { margin-top: var(--space-tight); }

.portrait-empty-title {
  display: block;
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 600;
}

.portrait-loading-bars {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.portrait-loading-bar {
  height: 22rpx;
  border-radius: 2rpx;
  background: rgba(33, 29, 23, 0.08);
  animation: portrait-loading-pulse 1.2s ease-in-out infinite;
}

.portrait-loading-bar.is-short { width: 60%; }

@keyframes portrait-loading-pulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

.portrait-empty-retry {
  display: inline-block;
  min-height: var(--tap-min);
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

/* ── 基础资料：保留原有的内联表单交互（input + picker + 底部保存按钮），
   现在整个折叠在顶部「我 的」那一行下面，默认收起 ── */
.basic-info-note {
  display: block;
  margin-top: 20rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-hint {
  display: block;
  margin-top: var(--space-tight);
  padding-left: 20rpx;
  border-left: 2rpx solid var(--gold-line);
  color: var(--ink-45, rgba(33, 29, 23, 0.45));
  font-size: 21rpx;
  line-height: 1.7;
}

.clear-field {
  margin: 0 !important;
  width: auto !important;
  min-height: var(--tap-min);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.privacy-copy {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
  text-align: center;
}

/* ══ 新版「我的」：画像即页面 ══════════════════════════════
   层级主要靠字号：全页只有三处大字（底账的数字、画像的名字、画像正文），
   其余一切都在 19–24rpx 之间——差一倍以上才算一级。

   底色只用在该用的地方，一共两处，各自有理由：
     .portrait-sheet  画像主卡，要浮在那叠纸上面，不然叠牌像印偏了
     .footer-panel    有待回访时的暖金块，全页唯一需要用户此刻动手的事
   除此之外的分区一律用细线和间距，不再加盒子。 */

/* 页面标题退成眉标：画像才是这页的标题。 */
.profile-eyebrow {
  display: block;
  color: var(--ink-70);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
}

/* ── 画像纸叠 ─────────────────────────────────────────────
   背后垫 0–3 层纸色偏移卡，攒的版本越多越厚（level-0 完全不垫）。
   和梦册的 .deck-shadow 同一套语言，但更收敛：旋转角更小，因为这叠纸
   要托住一大段正文，歪太多会影响阅读。 */
.portrait-deck {
  position: relative;
  margin-top: 40rpx;
}

/* 每层纸都有自己的投影，越往下越深、越偏——这样三层读起来是「叠起来的纸」
   而不是「三个错开的色块」。底色也逐层加深一点，模拟压在下面的纸吃光。 */
.portrait-deck-shadow {
  position: absolute;
  inset: 0;
  border: 1rpx solid rgba(33, 29, 23, 0.1);
  background: #ebe1cb;
  box-shadow: 0 4rpx 12rpx rgba(33, 29, 23, 0.06);
}

.portrait-deck-shadow.shadow-1 {
  transform: rotate(0.8deg) translate(7rpx, 7rpx);
}

.portrait-deck-shadow.shadow-2 {
  background: #e7dcc4;
  transform: rotate(1.7deg) translate(14rpx, 13rpx);
}

.portrait-deck-shadow.shadow-3 {
  background: #e3d7bd;
  box-shadow: 0 8rpx 20rpx rgba(33, 29, 23, 0.09);
  transform: rotate(2.6deg) translate(21rpx, 19rpx);
}

/* 主卡要明显比垫在下面的纸「浮」起来，否则叠牌看着像印偏了的印刷品。
   左边一条金线是这张卡唯一的装饰，也是整页的视觉锚点。 */
.portrait-sheet {
  position: relative;
  z-index: 2;
  padding: 38rpx 34rpx 34rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.12);
  border-left: 4rpx solid rgba(184, 134, 59, 0.5);
  background: #f4efe2;
  box-shadow: 0 10rpx 30rpx rgba(33, 29, 23, 0.1);
}

.portrait-sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.portrait-sheet-kicker {
  color: var(--gold-ink);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.portrait-sheet-status {
  flex: 0 0 auto;
  color: var(--ink-70);
  font-size: 20rpx;
}

.portrait-sheet-status.is-paused {
  color: var(--ink-55);
}

/* 画像的名字：全页最大的字。参考 Polarsteps「Travel DNA」和 Moonly
   上升星座——先给身份，再给证据。仍是全页最大的字，但收到 36rpx：
   46rpx 一行放不下八个字就要折行，折了行的大标题反而散。 */
.portrait-title {
  display: block;
  margin-top: 28rpx;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: 36rpx;
  line-height: 1.4;
}

/* 有名字时版本退成注脚（小字、淡色）；名字缺席的旧版本走 .is-lead，
   见下面的 .portrait-body。 */
.portrait-sheet-version {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 10rpx;
}

.portrait-version-num {
  color: var(--ink-70);
  font-size: 20rpx;
}

.portrait-version-date {
  color: var(--ink-70);
  font-size: 20rpx;
}

/* 「已更新」是这个产品唯一一个「有新东西可看」的信号，不是徽章装饰。 */
.portrait-version-new {
  padding: 3rpx 14rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.42);
  border-radius: 999rpx;
  color: var(--gold-ink);
  font-size: 18rpx;
  font-weight: 700;
}

/* 正文。不截断、不加 line-clamp——这段话就是用户来这一页要读的东西。
   有名字时它是名字的展开（28rpx，让位给标题）；没有名字的旧版本走
   .is-lead 顶上来当主角（32rpx），不至于整张卡没有重心。 */
.portrait-body {
  display: block;
  margin-top: 26rpx;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: 28rpx;
  line-height: 1.8;
}

.portrait-body.is-lead {
  font-size: 32rpx;
}

/* 一截短金线，收住正文。通栏分割线会把卡切成上下两半，而这段免责话
   本来就该依附在正文尾巴上，不该另起一节。 */
.portrait-rule {
  width: 56rpx;
  height: 2rpx;
  margin-top: 32rpx;
  background: var(--gold-line);
}

/* 原来挂在页面标题下当副标题，现在贴着画像本身——它限定的是这段话，
   不是整个页面。 */
.portrait-caveat {
  display: block;
  margin-top: 18rpx;
  color: var(--ink-70);
  font-size: 20rpx;
  line-height: 1.6;
}

/* ── 顶部：标题行即资料入口 ────────────────────────────────
   这页没有别的设置项了，不值得再为基础资料单开一区，所以「我 的」
   这一行本身就是它的开关。 */
.profile-topbar {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  min-height: var(--tap-min);
}

.profile-topbar-value {
  min-width: 0;
  overflow: hidden;
  color: var(--ink-70);
  font-size: 20rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 梦境回访 ─────────────────────────────────────────────
   排在画像之前。有待办时是全页唯一一块实底（暖金 #EDE4D0，
   --ink 13.26:1 / --ink-70 5.87:1），因为它是唯一一件需要用户
   此刻动手的事；没有待办时收成一行灰字，功能仍在，只是安静。 */
.revisit-panel {
  margin-top: 36rpx;
  padding: 26rpx 30rpx 30rpx;
  border-radius: 4rpx;
  background: #ede4d0;
}

.revisit-kicker {
  display: block;
  color: var(--gold-ink);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.revisit-dormant {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 36rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.1);
}

.revisit-dormant-label {
  flex: 0 0 auto;
  color: var(--ink-70);
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.revisit-dormant-value {
  min-width: 0;
  overflow: hidden;
  color: var(--ink-55);
  font-size: 20rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ── 详情入口 ─────────────────────────────────────────────
   做成卡片底部一整行而不是右上角小箭头：它承接的是「这段话从哪来、
   我认不认」这一整类疑问，值一整行。 */
.portrait-more {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: var(--tap-min);
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
}

.portrait-more-label {
  min-width: 0;
  overflow: hidden;
  color: var(--ink-70);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.portrait-more-icon {
  flex: 0 0 auto;
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
}

/* ── 底账 ─────────────────────────────────────────────────
   参考 Deepstash「Reading Personality」：判断之前先摆证据的体量。
   数字用衬线体、单位用小字——一眼扫过去读到的是「12」「38」，而不是
   两串等宽的说明文字。同时填掉了标题行和回访之间那片空白。
   字号压在画像名字（36rpx）之下，否则一进页面先看见的是计数而不是画像。 */
.ledger {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 30rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.1);
}

.ledger-cell {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.ledger-num {
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: 32rpx;
  line-height: 1;
}

.ledger-unit {
  color: var(--ink-70);
  font-size: 20rpx;
}

/* 两组数字之间的竖线，比 gap 更能说明「这是并列的两笔账」 */
.ledger-rule {
  width: 1rpx;
  height: 28rpx;
  background: rgba(33, 29, 23, 0.16);
}
