.profile-screen { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

/* ── 对齐设计稿 3c：本页不再使用「卡片盒」语言，改为纯文字流 +
   细线分区，只有「昨日梦回访」与「历史版本」两处保留浅色底块。
   下面每条颜色都用相对亮度公式核算过，数值见各分组注释；
   设计稿里 rgba(33,29,23,0.35/0.4/0.45) 与 #B8863B 用作文字时
   在暖纸上只有 2.1–2.7:1，一律替换为已校准 token：
     --gold-ink  #8a5d29  ~4.5–4.85:1  用于强调型小标签/标签文字
     --ink-70    rgba(.72) ~5.9–6.1:1  用于中性小标签/可点文字链
     --ink-55    rgba(.58) ~3.9:1      仅用于「已暂停」这类非关键弱化状态
     --cinnabar-ink #b23a32 ~4.7–5.0:1 用于「删除」这类危险小字
   --gold-line (#b8863b) 即使 100% 不透明在暖纸上也只有 2.74:1，
   达不到文字的 4.5:1，也够不到装饰图形的 3:1，因此全部改为仅用于
   低透明度的点缀边框（历史版本盒左边线、标签描边），不作为任何
   文字色使用；这类点缀细线本身不承载必须信息，移除也不影响内容
   可读，视为纯装饰不做 3:1 强制。 ── */

.profile-header {
  flex-shrink: 0;
}

/* 覆盖 app.wxss 全局 .title（19px 宋体），本页头图更克制：16px 无衬线 */
.profile-header .title {
  font-family: var(--font-sans);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.4;
}

.profile-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.5;
}

/* ── 昨日梦回访：设计稿唯一的实底卡片，暖金底块 + 无边框 ──
   #EDE4D0 是设计稿指定的实色（非 token），核算：
     --gold-ink  on #EDE4D0 = 4.52:1  （标题小标签）
     --ink       on #EDE4D0 = 13.26:1 （正文/问题）
     --ink-70    on #EDE4D0 = 5.87:1  （回答/跳过/关闭提醒可点文字） */
.profile-revisit {
  margin-top: var(--space-group);
  padding: 28rpx 32rpx;
  border-radius: 4rpx;
  background: #ede4d0;
}

.profile-revisit-kicker,
.profile-revisit-title,
.profile-revisit-question,
.profile-revisit-disable {
  display: block;
}

.profile-revisit-kicker {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.profile-revisit-title {
  margin-top: 12rpx;
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 600;
}

.profile-revisit-question {
  margin-top: 8rpx;
  font-family: var(--font-serif);
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.profile-revisit-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 20rpx;
}

/* 回答 / 跳过 / 关闭提醒 三个动作全部降为文字链，呼应设计稿的
   扁平语言；button 已被 app.wxss 的 `button{width:auto!important}`
   复位，这里只补文字样式 */
.profile-revisit-answer,
.profile-revisit-skip {
  margin: 0 !important;
  min-height: var(--tap-min);
  font-size: 23rpx;
  line-height: var(--tap-min);
}

.profile-revisit-answer {
  color: var(--ink);
  font-weight: 600;
}

.profile-revisit-skip {
  color: var(--ink-70);
}

.profile-revisit-disable {
  min-height: var(--tap-min);
  color: var(--ink-70);
  font-size: 23rpx;
  line-height: var(--tap-min);
}

.profile-revisit-answer::after,
.profile-revisit-skip::after {
  border: 0;
}

.profile-revisit-composer {
  margin-top: var(--space-group);
}

.profile-revisit-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  max-height: 260rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.16);
  border-radius: 0;
  background: #fdfaf2;
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.profile-revisit-send {
  display: block;
  width: 150rpx !important;
  margin-top: var(--space-tight);
  margin-left: auto;
  background: var(--ink);
  color: var(--paper);
}

.profile-revisit-send::after {
  border: 0;
}

/* ── 通用：小标签 / 计数 / 分区细线 ──
   --ink-70 on --paper = 6.10:1，覆盖本页所有「阶段画像·V3」
   「最近的线索」「系统提取的现实线索」「基础资料」这类结构性
   眉题，以及「共 3 版」「N 条」这类计数、和全部可点文字链 */
.section-label {
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.section-meta {
  color: var(--ink-70);
  font-size: var(--fs-label);
}

.section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.section-divider {
  margin-top: var(--space-group);
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.08);
}

/* ── 阶段画像入口 ──
   完整面板已搬到「梦册」顶部（见 pages/archive/index.wxss）。这一页只留一个
   只读入口：老用户仍能从熟悉的位置找到它，但不再有两份可编辑的画像 UI，
   也不会让这页表单看起来像是画像的归属地。 */
.portrait-entry {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 44rpx;
  padding: 26rpx 28rpx;
  background: rgba(33, 29, 23, 0.03);
  border-left: 4rpx solid rgba(184, 134, 59, 0.5);
}

.portrait-entry-copy {
  flex: 1;
  min-width: 0;
}

.portrait-entry-head {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.portrait-entry-badge {
  flex: 0 0 auto;
  padding: 2rpx 12rpx;
  background: var(--gold-line);
  color: var(--paper);
  font-size: 19rpx;
  font-weight: 700;
}

/* 预览只留两行：这里是入口不是正文，全文在梦册。 */
.portrait-entry-preview {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  font-family: var(--font-serif);
  color: var(--ink-70);
  font-size: 24rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.portrait-entry-status {
  display: block;
  margin-top: 12rpx;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 700;
}

.portrait-entry-arrow {
  flex: 0 0 auto;
  align-self: center;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
}

/* ── 最近的线索：真实数据是 dreamCount + stageSummary 一段摘要文字，
   不是设计稿画的标签云（页面没有关键词计数的数据源，不能在不动
   index.js 的前提下编出假标签），因此保留原有段落展示，只对齐
   标题/分隔线/字号这一层视觉规格 ── */
.recent-clues-summary {
  display: block;
  margin-top: 20rpx;
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

/* ── 系统提取的现实线索 ── */
.facts-empty {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.facts-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: var(--space-tight);
}

.fact-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.fact-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.fact-actions {
  display: flex;
  flex: 0 0 auto;
  gap: var(--space-tight);
  font-size: var(--fs-label);
}

.fact-edit { color: var(--ink-70); }

/* 「删除」用危险色，--cinnabar 在小字号只有 4.29:1 不够，
   换成已校准的 --cinnabar-ink：4.69–5.03:1 */
.fact-delete { color: var(--cinnabar-ink); }

/* ── 基础资料：产品决定保留现有内联表单交互（input + picker +
   底部保存按钮），这里只对齐标题/说明文案/分隔线的视觉规格。
   去掉了上一轮的 .basic-info-zone 底色块和它的左右内padding——
   那层 padding 让基础资料的字段相对其它分区多缩进了 28rpx，
   现在改用与其它分区相同的 .section-divider（只留 padding-top），
   横向对齐重新与上方各分区一致 ── */
.basic-info-note {
  display: block;
  margin-top: 20rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
}

.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-hint {
  display: block;
  margin-top: var(--space-tight);
  padding-left: 20rpx;
  border-left: 2rpx solid var(--gold-line);
  color: var(--ink-45, rgba(33, 29, 23, 0.45));
  font-size: 21rpx;
  line-height: 1.7;
}

.clear-field {
  margin: 0 !important;
  width: auto !important;
  min-height: var(--tap-min);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.privacy-copy {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
  text-align: center;
}
