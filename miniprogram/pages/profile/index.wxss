.profile-screen {
  padding-bottom: 80rpx;
}

.profile-intro {
  display: block;
  margin-top: 24rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
  color: rgba(255, 255, 255, 0.42);
  font-size: 24rpx;
  line-height: 1.75;
}

.field-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.clear-field {
  height: 54rpx;
  color: rgba(219, 132, 124, 0.62);
  font-size: 20rpx;
  line-height: 54rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.privacy-copy {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.28);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
