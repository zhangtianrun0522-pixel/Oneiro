.profile-screen { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }

/* 页面头部下的第一道版式节奏，改用旧金细线 */
.profile-intro {
  display: block;
  margin-top: var(--space-tight);
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(184, 134, 59, 0.35);
  border-bottom: 1rpx solid rgba(184, 134, 59, 0.35);
  color: rgba(33, 29, 23, 0.58);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

.memory-section {
  margin-top: var(--space-block);
  padding: 30rpx;
  border: 0;
  border-radius: 0;
  background: var(--paper-raised);
}

/* 「阶段画像」是本页最重要的结论，右上角叠一枚极简命理刻度环——
   1rpx 旧金 8% 透明度的圆，从卡角探出，纯装饰、不抢内容。
   z-index:0 让本元素成为新的层叠上下文根，::before/::after 用
   z-index:-1 沉到文字之下、背景之上，不会盖住任何正文。 */
.portrait-section {
  position: relative;
  z-index: 0;
  overflow: hidden;
  border-top: 2rpx solid rgba(184, 134, 59, 0.62);
  background: var(--paper-raised);
}

.portrait-section::before {
  content: '';
  position: absolute;
  z-index: -1;
  top: -70rpx;
  right: -70rpx;
  width: 200rpx;
  height: 200rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.08);
  border-radius: 50%;
  pointer-events: none;
}

.portrait-section::after {
  content: '';
  position: absolute;
  z-index: -1;
  top: 26rpx;
  right: 46rpx;
  width: 12rpx;
  height: 1rpx;
  background: rgba(184, 134, 59, 0.1);
  box-shadow:
    -30rpx 26rpx 0 0 rgba(184, 134, 59, 0.1),
    14rpx 54rpx 0 0 rgba(184, 134, 59, 0.1),
    -46rpx 70rpx 0 0 rgba(184, 134, 59, 0.1);
  pointer-events: none;
}

.facts-section { background: transparent; }

.supporting-section {
  margin-top: var(--space-group);
  padding: 22rpx 24rpx;
}

.supporting-section .memory-title {
  font-size: var(--fs-aux);
}

.supporting-section .memory-summary {
  margin-top: var(--space-tight);
  font-size: var(--fs-aux);
}

.supporting-section .memory-kicker {
  font-size: var(--fs-label);
}

.fact-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-top: 12rpx;
  padding: 12rpx 0;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
}

.fact-copy {
  flex: 1;
  min-width: 0;
  color: rgba(33, 29, 23, 0.72);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.fact-actions {
  display: flex;
  flex: 0 0 auto;
  gap: 26rpx;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  line-height: 1.7;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.memory-kicker,
.memory-title,
.memory-summary,
.monthly-label,
.monthly-title,
.monthly-copy,
.portrait-status,
.portrait-summary,
.portrait-reason,
.portrait-note,
.history-title,
.form-section-title {
  display: block;
}

.memory-kicker {
  color: var(--ink-55);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.memory-title {
  margin-top: 8rpx;
  color: #211d17;
  font-size: var(--fs-body);
  font-weight: 650;
}

/* profile 页唯一的朱砂点睛：阶段画像是本页最重要的结论，标题前落一枚印章方块 */
.portrait-section .memory-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  background: var(--cinnabar);
  vertical-align: middle;
}

.memory-count,
.portrait-version {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.portrait-focus-label {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
}

.memory-summary {
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.68);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

/* 与 .portrait-focus-label 等同类小标签保持一致的旧金墨色，
   之前遗漏未随暖纸主题转换，浅暖金字在纸色背景上几乎不可读 */
.portrait-status {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

/* 「暂停用于解读」与「用于解读中」不能共用同一枚肯定色——
   暂停态改用中性墨灰，与仍在生效的旧金色形成清楚的区分度 */
.portrait-status.is-paused {
  color: var(--ink-55);
}

.portrait-card {
  margin-top: var(--space-tight);
  padding: 26rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.13);
  border-radius: 0;
  background: transparent;
}

.portrait-feature {
  padding: 30rpx 28rpx;
  border-color: rgba(184, 134, 59, 0.42);
  background: rgba(242, 236, 223, 0.52);
}

.portrait-empty-title {
  display: block;
  color: rgba(33, 29, 23, 0.74);
  font-size: var(--fs-aux);
  font-weight: 600;
}

.portrait-empty-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(33, 29, 23, 0.52);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.portrait-summary {
  margin-top: var(--space-tight);
  color: #211d17;
  font-size: var(--fs-aux);
  line-height: 1.78;
}

.portrait-reason,
.portrait-note {
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.44);
  font-size: var(--fs-label);
  line-height: 1.65;
}

.portrait-editor {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: var(--space-tight);
  padding: 18rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.2);
  border-radius: 0;
  background: #fdfaf2;
  color: #211d17;
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.portrait-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-tight);
}

/* 方正、克制的纸本语言：内容区按钮不用胶囊圆角 */
.portrait-primary,
.portrait-secondary,
.portrait-generate {
  width: auto !important;
  min-height: var(--tap-min);
  margin: 0;
  padding: 0 26rpx;
  border-radius: 2rpx;
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: var(--tap-min);
}

.portrait-primary { border: 1rpx solid var(--ink); background: var(--ink); color: var(--paper); }
.portrait-secondary { border: 1rpx solid rgba(33, 29, 23, 0.28); background: transparent; color: var(--ink-70); }
.portrait-secondary.quiet { color: rgba(33, 29, 23, 0.54); }

/* 暂停用于解读：降为文字操作，不再是一颗按钮 */
.portrait-link {
  width: auto !important;
  min-height: var(--tap-min);
  margin: 0;
  padding: 0 4rpx;
  border: 0 !important;
  border-radius: 0;
  background: transparent !important;
  color: rgba(33, 29, 23, 0.54);
  font-size: var(--fs-label);
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.portrait-generate { margin-top: var(--space-tight); border: 1rpx solid rgba(33, 29, 23, 0.28); background: transparent; color: var(--ink-70); }

.portrait-primary::after,
.portrait-secondary::after,
.portrait-link::after,
.portrait-generate::after {
  border: 0;
}

/* 历史版本是阶段画像的从属子列表，不再只用一条上分隔线，
   换成缩进 + 左侧细金线的容器，读出「附属于上方结论」的层级关系 */
.portrait-history {
  margin-top: var(--space-tight);
  padding: 20rpx 20rpx 20rpx 24rpx;
  border-top: 0;
  border-left: 2rpx solid rgba(184, 134, 59, 0.35);
  background: rgba(33, 29, 23, 0.03);
}

.portrait-history .history-item:first-child {
  margin-top: 0;
}

.portrait-history-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
  margin-top: var(--space-tight);
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
  color: rgba(33, 29, 23, 0.48);
  font-size: var(--fs-label);
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.48);
  font-size: var(--fs-label);
}

.history-copy {
  display: flex;
  flex: 1;
  justify-content: space-between;
  gap: 14rpx;
}

/* 历史版本回溯：同样降为文字操作 */
.history-restore {
  flex: 0 0 auto;
  width: auto !important;
  min-height: var(--tap-min);
  margin: 0;
  padding: 0 4rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--gold-line);
  font-size: var(--fs-label);
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.history-restore::after {
  border: 0;
}

/* .clear-field 提到最小触控高度后，flex-end 会让它比标签高出一截，
   改为居中对齐 */
.field-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 「清除」不再用朱砂强调危险，降为深墨文字链，与 .portrait-link /
   .history-restore 的低调操作语言保持一致 */
.clear-field {
  width: auto !important;
  min-height: var(--tap-min);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: var(--tap-min);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.picker-field {
  display: flex;
  align-items: center;
}

.privacy-copy {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  line-height: 1.6;
  text-align: center;
}

.profile-revisit {
  margin-top: var(--space-group);
  padding: 28rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.72);
  background: #fbf6ec;
}

.profile-revisit-kicker,
.profile-revisit-title,
.profile-revisit-question,
.profile-revisit-disable {
  display: block;
}

.profile-revisit-kicker {
  color: #b8863b;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.profile-revisit-title {
  margin-top: var(--space-tight);
  color: #211d17;
  font-size: var(--fs-aux);
  font-weight: 600;
}

.profile-revisit-question {
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.7);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

.profile-revisit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: var(--space-group);
}

.profile-revisit-answer,
.profile-revisit-skip,
.profile-revisit-send {
  height: 68rpx;
  margin: 0;
  border-radius: 0;
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: 68rpx;
}

.profile-revisit-answer {
  flex: 1;
  background: #211d17;
  color: #fbf6ec;
}

.profile-revisit-skip {
  flex: 1;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  background: transparent;
  color: rgba(33, 29, 23, 0.58);
}

.profile-revisit-disable {
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.38);
  font-size: var(--fs-label);
  text-align: center;
}

.profile-revisit-composer {
  margin-top: var(--space-group);
}

.profile-revisit-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 120rpx;
  max-height: 260rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.16);
  border-radius: 0;
  background: #fdfaf2;
  color: #211d17;
  font-size: var(--fs-aux);
  line-height: 1.6;
}

.profile-revisit-send {
  display: block;
  width: 150rpx;
  margin-top: var(--space-tight);
  margin-left: auto;
  background: #211d17;
  color: #fbf6ec;
}

.profile-revisit-answer::after,
.profile-revisit-skip::after,
.profile-revisit-send::after {
  border: 0;
}

/* 「我的基础资料」整体套一层比暖纸略深的底色块，让两大分区从
   「一条线隔开」变成「两张纸」。叠加 2.5% 深墨半透明，对比度重新
   核对过：--gold-ink 字号标签 4.63:1、正文墨色 8.0:1，均仍达标。 */
.basic-info-zone {
  margin-top: var(--space-block);
  padding: var(--space-group) 28rpx;
  background: rgba(33, 29, 23, 0.025);
}

.basic-info-zone .zone-title {
  margin-top: 0;
}

/* ── 页面分为两个明确分区 ── */
.zone-title {
  display: block;
  margin: var(--space-block) 0 0;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid var(--ink);
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.zone-note {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-label);
  line-height: 1.6;
}
