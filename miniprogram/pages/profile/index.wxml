<view class="screen profile-screen">
  <view class="profile-header">
    <text class="title">我的资料</text>
    <text class="profile-subtitle">这是可修改的当下观察，不是对你的定义</text>
  </view>

  <!-- 「次日回访」区域固定占位，不因为当前没有待回访的梦就整块消失——
       否则用户会以为这个功能被下线了。四种状态：已关闭 / 有待回访(默认或作答中) /
       无待回访。真正没有待回访的梦时只说明机制，绝不编造回访问题文案。 -->
  <view class="profile-revisit">
    <text class="profile-revisit-kicker">次日回访</text>

    <block wx:if="{{revisitDisabled}}">
      <text class="profile-revisit-title">回访提醒已关闭</text>
      <text class="profile-revisit-question">记下一个梦后，第二天本该在这里出现一次回访提问，但提醒已被关闭。</text>
      <view class="profile-revisit-actions">
        <text class="profile-revisit-disable" bindtap="enableRevisitPrompts">恢复回访提醒</text>
      </view>
    </block>

    <block wx:elif="{{revisit}}">
      <text class="profile-revisit-title">昨天的梦「{{revisit.title}}」</text>
      <text class="profile-revisit-question">{{revisit.question}}</text>
      <view wx:if="{{!revisitAnswering}}" class="profile-revisit-actions">
        <button class="profile-revisit-answer" bindtap="startAnswerRevisit">回答</button>
        <button class="profile-revisit-skip" bindtap="skipRevisitPrompt">跳过</button>
        <text class="profile-revisit-disable" bindtap="disableRevisitPrompts">关闭提醒</text>
      </view>
      <view wx:else class="profile-revisit-composer">
        <textarea
          class="profile-revisit-textarea"
          bindinput="onRevisitAnswerInput"
          value="{{revisitAnswerText}}"
          maxlength="300"
          auto-height
          placeholder="写下此刻的变化或感受"
          placeholder-class="muted"
        />
        <button class="profile-revisit-send" bindtap="submitRevisitAnswer">发送</button>
      </view>
    </block>

    <block wx:else>
      <text class="profile-revisit-title">暂时没有待回访的梦</text>
      <text class="profile-revisit-question">记下一个梦后，第二天这里会出现一次回访提问，帮你确认梦里的感受有没有照进现实。</text>
    </block>
  </view>

  <view class="portrait-block">
    <view class="section-row">
      <text class="section-label">阶段画像{{memoryState.current ? ' · V' + memoryState.current.version : ''}}</text>
      <!-- 内容存在优先展示；否则读取中显示「读取中」，读取完成后才区分
           「读取失败」与真正的「等待形成」，避免第一帧就武断地判空 -->
      <text class="portrait-focus-label {{memoryState.current ? (memoryState.current.useInFutureReadings === false ? 'is-paused' : 'is-active') : 'is-waiting'}}">{{memoryState.current ? (memoryState.current.useInFutureReadings === false ? '已暂停解读' : '用于解读中') : (!memoryLoaded ? '读取中' : (portraitLoadError ? '读取失败' : '等待形成'))}}</text>
    </view>

    <!-- 内容优先：只要 memoryState.current 有值就展示，不受 memoryLoaded 影响——
         这样刚在本页手动生成的本机草稿也能立刻显示，不会被"读取中"骨架盖住 -->
    <view wx:if="{{memoryState.current}}" class="portrait-body">
      <textarea
        wx:if="{{portraitEditing}}"
        class="portrait-editor"
        value="{{portraitEditSummary}}"
        maxlength="500"
        auto-height
        bindinput="onPortraitSummaryInput"
      />
      <text wx:else class="portrait-summary">{{memoryState.current.summary}}</text>
      <!-- 云端生成失败时不能静默：本机推测版本仍展示，但要明确说明并给出重试 -->
      <view wx:if="{{portraitGenerateFailed && !portraitEditing}}" class="portrait-generate-error">
        <text class="portrait-generate-error-copy">云端生成失败，当前展示的是本机推测版本</text>
        <text class="portrait-generate-error-retry" data-reason="重试生成" bindtap="generatePortrait">重试</text>
      </view>
      <view wx:if="{{portraitEditing}}" class="portrait-actions">
        <button class="portrait-primary" loading="{{portraitSaving}}" bindtap="savePortraitEdit">保存修改</button>
        <button class="portrait-secondary" bindtap="cancelPortraitEdit">取消</button>
      </view>
    </view>

    <!-- 首次进入、云端还没返回：明确的加载态，不是空态 -->
    <view wx:elif="{{!memoryLoaded}}" class="portrait-loading-card">
      <text class="portrait-loading-copy">正在读取 Oneiro 对你的理解…</text>
      <view class="portrait-loading-bars">
        <view class="portrait-loading-bar"></view>
        <view class="portrait-loading-bar"></view>
        <view class="portrait-loading-bar is-short"></view>
      </view>
    </view>

    <!-- 加载完成但请求失败：区别于「真的还没有」，给出可理解的原因和重试 -->
    <view wx:elif="{{portraitLoadError}}" class="portrait-empty-card">
      <text class="portrait-empty-title">阶段画像暂时加载不出来</text>
      <text class="portrait-empty-copy">可能是网络不稳定，不影响你已保存的资料。可以重新加载，或先生成一份本机画像。</text>
      <text class="portrait-empty-retry" bindtap="loadProfileMemory">重新加载</text>
    </view>

    <!-- 加载已完成，确认云端和本机都没有画像：真正的空态 + 下一步引导 -->
    <view wx:else class="portrait-empty-card">
      <text class="portrait-empty-title">还没有形成可查看的阶段画像</text>
      <text class="portrait-empty-copy">先保存基础资料，或记录一个梦。Oneiro 会从这些真实线索开始理解你。</text>
    </view>

    <view wx:if="{{!portraitEditing && (memoryState.current || memoryLoaded)}}" class="portrait-links-row">
      <button wx:if="{{memoryState.current}}" class="portrait-link-btn" bindtap="startPortraitEdit">修改这段理解</button>
      <button wx:if="{{memoryState.current}}" class="portrait-link-btn" bindtap="togglePortraitUse">{{memoryState.current.useInFutureReadings === false ? '恢复用于解读' : '暂停用于解读'}}</button>
      <button class="portrait-link-btn" loading="{{portraitLoading}}" disabled="{{portraitLoading}}" data-reason="手动刷新" bindtap="generatePortrait">{{memoryState.current ? '手动刷新' : '生成第一份阶段画像'}}</button>
    </view>

    <view wx:if="{{memoryState.pastHistory.length}}" class="portrait-history-box">
      <view class="portrait-history-head" bindtap="togglePortraitHistory">
        <text class="section-label">历史版本</text>
        <!-- 折叠态要带「展开」字样：只写「共 N 版」时这个盒子看起来是一块
             读不出可点性的空白区，用户不知道里面还有内容 -->
        <text class="section-meta">{{showPortraitHistory ? '收起' : ('共 ' + memoryState.pastHistory.length + ' 版 · 展开')}}</text>
      </view>
      <view wx:if="{{showPortraitHistory}}" class="portrait-history-list">
        <view wx:for="{{memoryState.pastHistory}}" wx:key="clientId" class="history-item">
          <view class="history-copy">
            <text class="history-version">V{{item.version}} · {{item.status === 'superseded' ? '当时的理解' : '历史画像'}}</text>
            <text wx:if="{{item.userEdited}}" class="history-edited-flag">用户编辑</text>
          </view>
          <button class="history-restore" data-id="{{item.clientId}}" bindtap="restorePortrait">回溯 ›</button>
        </view>
      </view>
    </view>
  </view>

  <view class="recent-clues-block section-divider">
    <view class="section-row">
      <text class="section-label">最近的线索</text>
      <text class="section-meta">{{insights.dreamCount}} 梦</text>
    </view>
    <text class="recent-clues-summary">{{insights.stageSummary}}</text>
  </view>

  <view class="facts-block section-divider">
    <view class="section-row">
      <text class="section-label">系统提取的现实线索</text>
      <text class="section-meta">{{lifeNotes.length}} 条</text>
    </view>
    <text wx:if="{{!lifeNotes.length}}" class="facts-empty">系统会从梦后对话和次日回访中提取有现实落点的线索，普通猜测不会直接成为记忆。</text>
    <view wx:else class="facts-list">
      <view wx:for="{{lifeNotes}}" wx:for-item="note" wx:for-index="noteIndex" wx:key="localKey" class="fact-item">
        <text class="fact-copy">{{note.text}}</text>
        <view class="fact-actions">
          <text data-index="{{noteIndex}}" bindtap="editLifeNote" class="fact-edit">编辑</text>
          <text data-index="{{noteIndex}}" bindtap="deleteLifeNote" class="fact-delete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="basic-info-block section-divider">
    <text class="section-label">基础资料（全部可选）</text>

    <text class="field-label">称呼 / 可选</text>
    <input class="field" value="{{profile.nickname}}" data-key="nickname" bindinput="onInput" maxlength="30" placeholder="怎么称呼你" placeholder-class="muted" />

    <view class="field-heading">
      <text class="field-label">出生日期 / 可选</text>
      <button wx:if="{{profile.birthDate}}" class="clear-field" bindtap="clearBirthDate">清除</button>
    </view>
    <picker mode="date" value="{{profile.birthDate}}" bindchange="onBirthDateChange">
      <view class="field picker-field {{profile.birthDate ? '' : 'muted'}}">{{profile.birthDate || '选择出生日期'}}</view>
    </picker>

    <view class="field-heading">
      <text class="field-label">出生时间 / 可选</text>
      <button wx:if="{{profile.birthTime}}" class="clear-field" bindtap="clearBirthTime">清除</button>
    </view>
    <picker mode="time" value="{{profile.birthTime}}" bindchange="onBirthTimeChange">
      <view class="field picker-field {{profile.birthTime ? '' : 'muted'}}">{{profile.birthTime || '选择时间'}}</view>
    </picker>

    <text class="field-label">性别 / 可选</text>
    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="field picker-field {{profile.gender ? '' : 'muted'}}">{{profile.gender === 'male' ? '男' : profile.gender === 'female' ? '女' : '不填写'}}</view>
    </picker>

    <text class="field-label">出生城市 / 可选</text>
    <input class="field" value="{{profile.birthPlace}}" data-key="birthPlace" bindinput="onInput" maxlength="60" placeholder="例如：上海" placeholder-class="muted" />

    <text class="basic-info-note">不填写不影响写梦和获得基础解读。</text>

    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button>
    <text class="privacy-copy">出生资料完全自愿，可随时修改或清空；命理视角会保留，但不会成为记录和基础解读的门槛。</text>
  </view>
</view>
