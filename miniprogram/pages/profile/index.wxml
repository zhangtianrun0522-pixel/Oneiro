<view class="screen profile-screen">
  <view class="profile-header">
    <text class="title">我的资料</text>
    <text class="profile-subtitle">这是可修改的当下观察，不是对你的定义</text>
  </view>

  <!-- 「次日回访」区域固定占位，不因为当前没有待回访的梦就整块消失——
       否则用户会以为这个功能被下线了。四种状态：已关闭 / 有待回访(默认或作答中) /
       无待回访。真正没有待回访的梦时只说明机制，绝不编造回访问题文案。 -->
  <view class="profile-revisit">
    <text class="profile-revisit-kicker">次日回访</text>

    <block wx:if="{{revisitDisabled}}">
      <text class="profile-revisit-title">回访提醒已关闭</text>
      <text class="profile-revisit-question">记下一个梦后，第二天本该在这里出现一次回访提问，但提醒已被关闭。</text>
      <view class="profile-revisit-actions">
        <text class="profile-revisit-disable" bindtap="enableRevisitPrompts">恢复回访提醒</text>
      </view>
    </block>

    <block wx:elif="{{revisit}}">
      <text class="profile-revisit-title">昨天的梦「{{revisit.title}}」</text>
      <text class="profile-revisit-question">{{revisit.question}}</text>
      <view wx:if="{{!revisitAnswering}}" class="profile-revisit-actions">
        <button class="profile-revisit-answer" bindtap="startAnswerRevisit">回答</button>
        <button class="profile-revisit-skip" bindtap="skipRevisitPrompt">跳过</button>
        <text class="profile-revisit-disable" bindtap="disableRevisitPrompts">关闭提醒</text>
      </view>
      <view wx:else class="profile-revisit-composer">
        <textarea
          class="profile-revisit-textarea"
          bindinput="onRevisitAnswerInput"
          value="{{revisitAnswerText}}"
          maxlength="300"
          auto-height
          placeholder="写下此刻的变化或感受"
          placeholder-class="muted"
        />
        <button class="profile-revisit-send" disabled="{{revisitSubmitting}}" loading="{{revisitSubmitting}}" bindtap="submitRevisitAnswer">发送</button>
      </view>
    </block>

    <block wx:else>
      <text class="profile-revisit-title">暂时没有待回访的梦</text>
      <text class="profile-revisit-question">记下一个梦后，第二天起这里会出现一次回访提问，保留一周，帮你确认梦里的感受有没有照进现实。</text>
    </block>
  </view>

  <!-- 阶段画像的完整面板已经搬到「梦册」顶部。这一页是一整页表单——出生日期、
       性别、保存资料、隐私说明——把产品里最有辨识度的产出摆在表单上方，它会
       被读成一个用户自己填的字段，而不是系统产出的东西。这里只留一个入口：
       老用户仍然能从熟悉的位置找到它，但不再有两份可编辑的画像 UI。 -->
  <view class="portrait-entry" bindtap="openPortrait">
    <view class="portrait-entry-copy">
      <view class="portrait-entry-head">
        <text class="section-label">阶段画像{{portraitVersionLabel ? ' · ' + portraitVersionLabel : ''}}</text>
        <text wx:if="{{portraitHasUpdate}}" class="portrait-entry-badge">已更新</text>
      </view>
      <text class="portrait-entry-preview">{{memoryState.current ? memoryState.current.summary : (memoryLoaded ? '还在为你梳理，记下更多梦后它会成形。' : '正在读取 Oneiro 对你的理解…')}}</text>
      <text class="portrait-entry-status">{{portraitStatusLabel}}</text>
    </view>
    <text class="portrait-entry-arrow">在梦册查看 ›</text>
  </view>

  <view class="recent-clues-block section-divider">
    <view class="section-row">
      <text class="section-label">最近的线索</text>
      <text class="section-meta">{{insights.dreamCount}} 梦</text>
    </view>
    <text class="recent-clues-summary">{{insights.stageSummary}}</text>
  </view>

  <view class="facts-block section-divider">
    <view class="section-row">
      <text class="section-label">系统提取的现实线索</text>
      <text class="section-meta">{{lifeNotes.length}} 条</text>
    </view>
    <text wx:if="{{!lifeNotes.length}}" class="facts-empty">系统会从梦后对话和次日回访中提取有现实落点的线索，普通猜测不会直接成为记忆。</text>
    <view wx:else class="facts-list">
      <view wx:for="{{lifeNotes}}" wx:for-item="note" wx:for-index="noteIndex" wx:key="localKey" class="fact-item">
        <text class="fact-copy">{{note.text}}</text>
        <view class="fact-actions">
          <text data-index="{{noteIndex}}" bindtap="editLifeNote" class="fact-edit">编辑</text>
          <text data-index="{{noteIndex}}" bindtap="deleteLifeNote" class="fact-delete">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="basic-info-block section-divider">
    <text class="section-label">基础资料（全部可选）</text>

    <text class="field-label">称呼 / 可选</text>
    <input class="field" value="{{profile.nickname}}" data-key="nickname" bindinput="onInput" maxlength="30" placeholder="怎么称呼你" placeholder-class="muted" />

    <view class="field-heading">
      <text class="field-label">出生日期 / 可选</text>
      <button wx:if="{{profile.birthDate}}" class="clear-field" bindtap="clearBirthDate">清除</button>
    </view>
    <picker mode="date" value="{{profile.birthDate}}" bindchange="onBirthDateChange">
      <view class="field picker-field {{profile.birthDate ? '' : 'muted'}}">{{profile.birthDate || '选择出生日期'}}</view>
    </picker>

    <view class="field-heading">
      <text class="field-label">出生时间 / 可选</text>
      <button wx:if="{{profile.birthTime}}" class="clear-field" bindtap="clearBirthTime">清除</button>
    </view>
    <picker mode="time" value="{{profile.birthTime}}" bindchange="onBirthTimeChange">
      <view class="field picker-field {{profile.birthTime ? '' : 'muted'}}">{{profile.birthTime || '选择时间'}}</view>
    </picker>
    <!-- 整份资料都是可选的，但「命理视角」非这三样不可。以前只标「可选」，
         用户填了日期和城市就以为够了，功能却一直不出来，也说不出为什么。 -->
    <text wx:if="{{!profile.birthDate || !profile.birthTime || !profile.birthPlace}}" class="field-hint">出生日期、时间、城市三样齐全，结果页的「命理视角」才能生成；出生时间决定时柱，缺它排不出完整四柱。不填不影响其他解读。</text>

    <text class="field-label">性别 / 可选</text>
    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="field picker-field {{profile.gender ? '' : 'muted'}}">{{profile.gender === 'male' ? '男' : profile.gender === 'female' ? '女' : '不填写'}}</view>
    </picker>

    <text class="field-label">出生城市 / 可选</text>
    <input class="field" value="{{profile.birthPlace}}" data-key="birthPlace" bindinput="onInput" maxlength="60" placeholder="例如：上海" placeholder-class="muted" />

    <text class="basic-info-note">不填写不影响写梦和获得基础解读。</text>

    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button>
    <text class="privacy-copy">出生资料完全自愿，可随时修改或清空；命理视角会保留，但不会成为记录和基础解读的门槛。</text>
  </view>
</view>
