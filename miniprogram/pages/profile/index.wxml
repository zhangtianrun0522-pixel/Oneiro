<!-- 「我的」= 一段关于你的话，仅此而已。
     核对材料（溯源／历史版本／修正入口／最近的线索／关于你的记录）全部
     收进画像详情二级页——首屏的任务是「读」，二级页的任务是「查」。
     基础资料收进顶部「我 的」那一行，梦境回访排在画像之前：它是唯一
     需要用户此刻动手的事，而画像是读完就走的东西。 -->
<view class="screen profile-screen">
  <!-- 标题行本身就是资料入口：这页没有别的设置项了，不值得再为它单开一区。 -->
  <view class="profile-topbar" bindtap="toggleProfileEdit">
    <text class="profile-eyebrow">我 的</text>
    <text class="profile-topbar-value">{{profile.nickname ? profile.nickname : '未填称呼'}}{{profile.birthDate || profile.birthTime || profile.birthPlace || profile.gender ? ' · 资料已填' : ' · 资料未填'}}{{showProfileEdit ? ' 收起 ↑' : ' 编辑 ›'}}</text>
  </view>

  <view wx:if="{{showProfileEdit}}" class="basic-info-block">
    <text class="field-label">称呼 / 可选</text>
    <input class="field" value="{{profile.nickname}}" data-key="nickname" bindinput="onInput" maxlength="30" placeholder="怎么称呼你" placeholder-class="muted" />

    <view class="field-heading">
      <text class="field-label">出生日期 / 可选</text>
      <button wx:if="{{profile.birthDate}}" class="clear-field" bindtap="clearBirthDate">清除</button>
    </view>
    <picker mode="date" value="{{profile.birthDate}}" bindchange="onBirthDateChange">
      <view class="field picker-field {{profile.birthDate ? '' : 'muted'}}">{{profile.birthDate || '选择出生日期'}}</view>
    </picker>

    <view class="field-heading">
      <text class="field-label">出生时间 / 可选</text>
      <button wx:if="{{profile.birthTime}}" class="clear-field" bindtap="clearBirthTime">清除</button>
    </view>
    <picker mode="time" value="{{profile.birthTime}}" bindchange="onBirthTimeChange">
      <view class="field picker-field {{profile.birthTime ? '' : 'muted'}}">{{profile.birthTime || '选择时间'}}</view>
    </picker>
    <!-- 整份资料都是可选的，但「命理视角」非这三样不可。以前只标「可选」，
         用户填了日期和城市就以为够了，功能却一直不出来，也说不出为什么。 -->
    <text wx:if="{{!profile.birthDate || !profile.birthTime || !profile.birthPlace}}" class="field-hint">出生日期、时间、城市三样齐全，结果页的「命理视角」才能生成；出生时间决定时柱，缺它排不出完整四柱。不填不影响其他解读。</text>

    <text class="field-label">性别 / 可选</text>
    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="field picker-field {{profile.gender ? '' : 'muted'}}">{{profile.gender === 'male' ? '男' : profile.gender === 'female' ? '女' : '不填写'}}</view>
    </picker>

    <text class="field-label">出生城市 / 可选</text>
    <input class="field" value="{{profile.birthPlace}}" data-key="birthPlace" bindinput="onInput" maxlength="60" placeholder="例如：上海" placeholder-class="muted" />

    <text class="basic-info-note">不填写不影响写梦和获得基础解读。</text>

    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">保存资料</button>
    <text class="privacy-copy">出生资料完全自愿，可随时修改或清空；命理视角会保留，但不会成为记录和基础解读的门槛。</text>
  </view>

  <!-- ── 底账 ─────────────────────────────────────────────
       「我 的」和回访之间原本是一片空白。这里放两个数字（参考 Deepstash
       「Reading Personality」：先摆证据的体量，再下判断），既填了那个空档，
       也给下面那段画像打了底——读者知道这个判断是从多少材料里来的。
       一个梦都还没有时整行不出现：那时候它只会显示两个 0。 -->
  <view wx:if="{{insights.dreamCount}}" class="ledger">
    <view class="ledger-cell">
      <text class="ledger-num">{{insights.dreamCount}}</text>
      <text class="ledger-unit">个梦</text>
    </view>
    <view class="ledger-rule"></view>
    <view class="ledger-cell">
      <text class="ledger-num">{{portraitVersion || '—'}}</text>
      <text class="ledger-unit">版画像</text>
    </view>
  </view>

  <!-- ── 梦境回访 ─────────────────────────────────────────
       排在画像之前，因为它是这页唯一需要用户此刻动手的事，而画像是读完
       就走的。没有待回访时收成一行休眠态，但绝不整块消失——否则用户会
       以为这个功能被下线了。 -->
  <block wx:if="{{revisitDisabled || revisit}}">
    <view class="revisit-panel">
      <text class="revisit-kicker">梦境回访</text>
      <block wx:if="{{revisitDisabled}}">
        <text class="profile-revisit-question">记下一个梦后，第二天本该在这里出现一次回访提问，但提醒已被关闭。</text>
        <view class="profile-revisit-actions">
          <text class="profile-revisit-disable" bindtap="enableRevisitPrompts">恢复回访提醒</text>
        </view>
      </block>
      <block wx:else>
        <text class="profile-revisit-title">昨天的梦「{{revisit.title}}」</text>
        <text class="profile-revisit-question">{{revisit.question}}</text>
        <view wx:if="{{!revisitAnswering}}" class="profile-revisit-actions">
          <button class="profile-revisit-answer" bindtap="startAnswerRevisit">回答</button>
          <button class="profile-revisit-skip" bindtap="skipRevisitPrompt">跳过</button>
          <text class="profile-revisit-disable" bindtap="disableRevisitPrompts">关闭提醒</text>
        </view>
        <view wx:else class="profile-revisit-composer">
          <textarea
            class="profile-revisit-textarea"
            bindinput="onRevisitAnswerInput"
            value="{{revisitAnswerText}}"
            maxlength="300"
            auto-height
            placeholder="写下此刻的变化或感受"
            placeholder-class="muted"
          />
          <button class="profile-revisit-send" disabled="{{revisitSubmitting}}" loading="{{revisitSubmitting}}" bindtap="submitRevisitAnswer">发送</button>
        </view>
      </block>
    </view>
  </block>
  <view wx:else class="revisit-dormant">
    <text class="revisit-dormant-label">梦境回访</text>
    <text class="revisit-dormant-value">记一个梦，第二天这里会出现一次提问</text>
  </view>

  <!-- ── 阶段画像主体 ──────────────────────────────────────
       .portrait-deck 背后垫 0–3 层纸色偏移卡：攒的版本越多，这叠纸越厚。
       版本数少时一层都不垫，新用户不会看到一叠假的「积累」。 -->
  <view class="portrait-deck">
    <view wx:if="{{portraitDeckLevel >= 3}}" class="portrait-deck-shadow shadow-3"></view>
    <view wx:if="{{portraitDeckLevel >= 2}}" class="portrait-deck-shadow shadow-2"></view>
    <view wx:if="{{portraitDeckLevel >= 1}}" class="portrait-deck-shadow shadow-1"></view>

    <view class="portrait-sheet">
      <view class="portrait-sheet-head">
        <text class="portrait-sheet-kicker">阶段画像</text>
        <text class="portrait-sheet-status {{portraitPaused ? 'is-paused' : ''}}">{{portraitStatusLabel}}</text>
      </view>

      <block wx:if="{{memoryState.current}}">
        <!-- 名字是这张卡的主角（参考 Polarsteps「Travel DNA」、Moonly 上升
             星座那套「小眉标 → 大名字 → 正文」）。一段无题的散文读完留不下
             东西，一个名字能被记住、被复述。V38 之前的快照没有名字，那时
             正文直接顶上来当主角，不占位也不显示「未命名」。 -->
        <text wx:if="{{memoryState.current.title}}" class="portrait-title">{{memoryState.current.title}}</text>

        <!-- 版本退成名字下面一行小字：它是「这判断攒了多久」的注脚，
             不该跟名字抢。 -->
        <view class="portrait-sheet-version">
          <text class="portrait-version-num">{{portraitVersionText}}</text>
          <text wx:if="{{portraitUpdatedLabel}}" class="portrait-version-date">{{portraitUpdatedLabel}}</text>
          <text wx:if="{{portraitHasUpdate}}" class="portrait-version-new">已更新</text>
        </view>

        <text class="portrait-body {{memoryState.current.title ? '' : 'is-lead'}}">{{memoryState.current.summary}}</text>

        <!-- 一截短金线收住正文（stoic. 那种做法）。整条通栏的分割线会把这张
             卡切成上下两半，而这段免责话本来就该依附在正文尾巴上。 -->
        <view class="portrait-rule"></view>
        <text class="portrait-caveat">这是可修改的当下观察，不是对你的定义</text>

        <!-- 详情入口做成卡片底部的一整行，而不是右上角一个小箭头：
             它要承接的是「这段话从哪来、我认不认」这一整类疑问。 -->
        <view class="portrait-more" bindtap="openPortraitDetail">
          <text class="portrait-more-label">看它从哪来，或者告诉我不对</text>
          <text class="portrait-more-icon">详情 ›</text>
        </view>
      </block>

      <!-- 首次进入、云端还没返回：明确的加载态，不是空态 -->
      <view wx:elif="{{!memoryLoaded}}" class="portrait-loading-card">
        <text class="portrait-loading-copy">正在读取 Oneiro 对你的理解…</text>
        <view class="portrait-loading-bars">
          <view class="portrait-loading-bar"></view>
          <view class="portrait-loading-bar"></view>
          <view class="portrait-loading-bar is-short"></view>
        </view>
      </view>

      <view wx:elif="{{portraitLoadError || portraitGenerateFailed}}" class="portrait-empty-card">
        <text class="portrait-empty-title">暂时没连上，点击重试</text>
        <text class="portrait-empty-copy">你的资料不会受影响，连上后我会继续为你梳理。</text>
        <text class="portrait-empty-retry" bindtap="retryPortrait">重试</text>
      </view>

      <view wx:else class="portrait-empty-card">
        <text class="portrait-empty-title">正在为你梳理</text>
        <text class="portrait-empty-copy">我会从你留下的资料、梦和生活片段开始，先整理一版简短的当下观察。</text>
      </view>
    </view>
  </view>
</view>
