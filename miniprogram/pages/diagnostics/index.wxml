<view class="diagnostics-screen">
  <view class="brand">
    <text>ONEIRO</text>
    <text>STATUS</text>
  </view>

  <text class="eyebrow">CLOUDBASE</text>
  <text class="title">运行诊断</text>
  <text class="copy">Env {{cloudHealth.env || 'cloud1-d9gb0sjvg6a8d9864'}} · {{updatedAt}}</text>

  <view class="status-grid">
    <view class="status-row">
      <text class="label">云环境</text>
      <text class="value {{cloudStatus.cloudReady ? 'ok' : 'warn'}}">{{cloudStatus.mode}}</text>
    </view>
    <view class="status-row">
      <text class="label">函数健康</text>
      <text class="value {{cloudHealth.ok ? 'ok' : 'warn'}}">{{cloudHealth.ok ? 'ok' : 'pending'}}</text>
    </view>
    <view class="status-row">
      <text class="label">AI Provider</text>
      <text class="value {{aiHealth.providerConfigured ? 'ok' : 'warn'}}">{{aiHealth.provider}}</text>
    </view>
    <view class="status-row">
      <text class="label">Provider Ready</text>
      <text class="value {{aiHealth.providerConfigured ? 'ok' : 'warn'}}">{{aiHealth.providerConfigured ? 'true' : 'false'}}</text>
    </view>
  </view>

  <view class="panel identity-panel">
    <view class="panel-row">
      <text class="panel-label">当前 openid</text>
      <text class="panel-value">{{identity.openid || '-'}}</text>
    </view>
    <text class="identity-note">把这个 openid 填进 saveDream 云函数的环境变量 ADMIN_OPENIDS，即可解锁下面的内测观测面板；需要看梦境原文摘要时再另外设置 ADMIN_FEEDBACK_EXCERPTS=true。</text>
  </view>

  <view wx:if="{{internalStats || feedbackStats}}" class="panel metrics-panel">
    <view class="feedback-panel-heading">
      <view>
        <text class="panel-title">内测观测</text>
        <text class="feedback-total">{{internalStats.generatedAt || updatedAt}}</text>
      </view>
      <button class="panel-refresh" bindtap="refreshStats" disabled="{{statsLoading}}">{{statsLoading ? '刷新中' : '刷新'}}</button>
    </view>

    <view wx:if="{{internalStats.memoryEcho}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">记忆呼应命中率</text>
        <text class="metric-figure">{{internalStats.memoryEcho.hitRateText}}</text>
      </view>
      <text class="metric-detail">{{internalStats.memoryEcho.detail}}</text>
      <view class="metric-head metric-head-sub">
        <text class="metric-sub-name">呼应使用率</text>
        <text class="metric-sub-figure">{{internalStats.memoryEcho.echoUseRateText}}</text>
      </view>
      <text class="metric-detail">{{internalStats.memoryEcho.echoDetail}}</text>
      <text class="metric-note">分母只算系统确实找到了历史重复的解读。今晚的梦与历史无重合时保持沉默是正确行为，不计入。</text>
    </view>

    <view wx:if="{{internalStats.readingDepth}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">折叠区展开率</text>
        <text class="metric-figure">{{internalStats.readingDepth.expandRateText}}</text>
      </view>
      <text class="metric-detail">{{internalStats.readingDepth.detail}}</text>
      <text class="metric-note">这个数要反着读：正片已经搬到折叠外，展开率下降才是成功。展开率高说明外面留的东西不够，用户还得自己去翻。</text>
    </view>

    <view wx:if="{{internalStats.retention}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">留存漏斗</text>
        <text class="metric-figure">{{internalStats.retention.atLeast1}} 人</text>
      </view>
      <view class="funnel-grid">
        <view class="funnel-step">
          <text class="funnel-count">{{internalStats.retention.atLeast1}}</text>
          <text class="funnel-label">≥ 1 个梦</text>
          <text class="funnel-rate">100%</text>
        </view>
        <view class="funnel-step">
          <text class="funnel-count">{{internalStats.retention.atLeast3}}</text>
          <text class="funnel-label">≥ 3 个梦</text>
          <text class="funnel-rate">{{internalStats.retention.rate3Text}}</text>
        </view>
        <view class="funnel-step">
          <text class="funnel-count">{{internalStats.retention.atLeast5}}</text>
          <text class="funnel-label">≥ 5 个梦</text>
          <text class="funnel-rate">{{internalStats.retention.rate5Text}}</text>
        </view>
      </view>
      <text class="metric-detail">共 {{internalStats.retention.totalDreams}} 个梦 · 人均 {{internalStats.retention.dreamsPerUser}} 个</text>
      <text class="metric-note">跨梦线索要到第 3 个梦才开始出现，第 5 个才谈得上习惯。这两级掉得厉害说明留不住人，而不是解读不好。</text>
    </view>

    <view wx:if="{{internalStats.interpretation}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">解读失败率</text>
        <text class="metric-figure {{internalStats.interpretation.failureRateText === '样本不足' ? '' : 'metric-alert'}}">{{internalStats.interpretation.failureRateText}}</text>
      </view>
      <text class="metric-detail">{{internalStats.interpretation.detail}}</text>
    </view>

    <view wx:if="{{internalStats.image}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">生图失败率</text>
        <text class="metric-figure {{internalStats.image.failureRateText === '样本不足' ? '' : 'metric-alert'}}">{{internalStats.image.failureRateText}}</text>
      </view>
      <text class="metric-detail">{{internalStats.image.detail}}</text>
      <text class="metric-note">失败率按尝试次数计，重试成功仍然记一次失败——否则「第一次总是超时」会被洗白。</text>
    </view>

    <view wx:if="{{feedbackStats}}" class="metric-block">
      <view class="metric-head">
        <text class="metric-name">解读反馈</text>
        <text class="metric-figure">共 {{feedbackStats.total}} 条</text>
      </view>
      <view class="feedback-count-grid">
        <view class="feedback-count"><text>有感觉</text><text>{{feedbackStats.counts.inspiring}}</text></view>
        <view class="feedback-count"><text>有点泛</text><text>{{feedbackStats.counts.too_generic}}</text></view>
        <view class="feedback-count"><text>太玄了</text><text>{{feedbackStats.counts.too_mystical}}</text></view>
        <view class="feedback-count"><text>不贴合</text><text>{{feedbackStats.counts.not_grounded}}</text></view>
      </view>
      <view wx:if="{{feedbackStats.recent.length}}" class="feedback-recent-list">
        <view wx:for="{{feedbackStats.recent}}" wx:key="index" class="feedback-recent-item">
          <view class="feedback-recent-meta">
            <text class="feedback-type">{{item.feedbackLabel}}</text>
            <text class="feedback-time">{{item.feedbackTime}}</text>
          </view>
          <text wx:if="{{item.dreamExcerpt}}" class="feedback-excerpt">{{item.dreamExcerpt}}</text>
          <text class="feedback-version">{{item.promptVersion || 'promptVersion 未记录'}}</text>
        </view>
      </view>
      <text wx:else class="feedback-empty">暂时还没有解读反馈</text>
      <text wx:if="{{!feedbackStats.excerptsEnabled}}" class="metric-note">梦境原文摘要默认不返回。需要时设置 ADMIN_FEEDBACK_EXCERPTS=true。</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-row">
      <text class="panel-label">hasApiKey</text>
      <text class="panel-value">{{aiHealth.hasApiKey ? 'true' : 'false'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">model</text>
      <text class="panel-value">{{aiHealth.model || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">baseUrlHost</text>
      <text class="panel-value">{{aiHealth.baseUrlHost || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">requestTimeoutMs</text>
      <text class="panel-value">{{aiHealth.requestTimeoutMs}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">fallback</text>
      <text class="panel-value">{{aiHealth.fallbackProvider || '-'}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-row">
      <text class="panel-label">image provider</text>
      <text class="panel-value">{{imageHealth.provider || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image ready</text>
      <text class="panel-value">{{imageHealth.providerConfigured ? 'true' : 'false'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image reason</text>
      <text class="panel-value">{{imageHealth.reason || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image message</text>
      <text class="panel-value">{{imageHealth.message || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image function</text>
      <text class="panel-value">{{imageHealth.functionName || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image key</text>
      <text class="panel-value">{{imageHealth.hasApiKey ? 'true' : 'false'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">requested model</text>
      <text class="panel-value">{{imageHealth.requestedModel || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image model</text>
      <text class="panel-value">{{imageHealth.model || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image host</text>
      <text class="panel-value">{{imageHealth.endpointHost || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">requested size</text>
      <text class="panel-value">{{imageHealth.requestedSize || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">requested aspect</text>
      <text class="panel-value">{{imageHealth.requestedAspectRatio || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image size</text>
      <text class="panel-value">{{imageHealth.size || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image aspect</text>
      <text class="panel-value">{{imageHealth.aspectRatio || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image quality</text>
      <text class="panel-value">{{imageHealth.quality || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image timeout</text>
      <text class="panel-value">{{imageHealth.requestTimeoutMs}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-row">
      <text class="panel-label">appid</text>
      <text class="panel-value">{{cloudHealth.appid || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">collections</text>
      <text class="panel-value">{{cloudHealth.collections.length}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">storage</text>
      <text class="panel-value">{{cloudHealth.storage ? 'ok' : '-'}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-row">
      <text class="panel-label">smoke ok</text>
      <text class="panel-value">{{smokeTest.ok ? 'true' : 'false'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">smoke provider</text>
      <text class="panel-value">{{smokeTest.provider || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">reason</text>
      <text class="panel-value">{{smokeTest.reason || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">title</text>
      <text class="panel-value">{{smokeTest.title || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">symbols</text>
      <text class="panel-value">{{smokeTest.symbolCount}}</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-row">
      <text class="panel-label">image ok</text>
      <text class="panel-value">{{imageTest.ok ? 'true' : 'false'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image reason</text>
      <text class="panel-value">{{imageTest.reason || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image message</text>
      <text class="panel-value">{{imageTest.message || '-'}}</text>
    </view>
    <view class="panel-row">
      <text class="panel-label">image url</text>
      <text class="panel-value">{{imageTest.imageUrl ? 'ready' : '-'}}</text>
    </view>
  </view>

  <button class="primary-button" loading="{{loading}}" bindtap="refresh">刷新状态</button>
  <button class="ghost-button smoke-button" loading="{{smokeLoading}}" bindtap="runSmokeTest">AI SMOKE TEST</button>
  <button class="ghost-button smoke-button" loading="{{imageLoading}}" bindtap="runImageTest">IMAGE TEST</button>
  <view class="panel diagnostics-admin-panel">
    <text class="panel-label">管理员区块 · 阶段画像</text>
    <text class="panel-value">{{portraitResult.ok ? '已重新生成' : portraitResult.reason}}</text>
    <button class="ghost-button smoke-button" loading="{{portraitLoading}}" disabled="{{portraitLoading}}" bindtap="regeneratePortrait">重新生成画像</button>
  </view>
</view>
