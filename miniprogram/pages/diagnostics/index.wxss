.diagnostics-screen {
  min-height: 100vh;
  padding: 64rpx 44rpx 56rpx;
  background: #050609;
}

.status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 44rpx;
}

.status-row,
.panel {
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.035);
}

.status-row {
  min-height: 132rpx;
  padding: 26rpx 24rpx;
}

.label,
.panel-label {
  display: block;
  color: rgba(255, 255, 255, 0.22);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.value {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.value.ok {
  color: #b9d9c5;
}

.value.warn {
  color: #e3c98f;
}

.panel {
  margin-top: 26rpx;
  padding: 10rpx 24rpx;
}

.identity-note {
  display: block;
  padding: 20rpx 0 10rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
  line-height: 1.65;
}

.feedback-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 12rpx;
}

.panel-title {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 800;
}

.feedback-total {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.38);
  font-size: 20rpx;
}

.panel-refresh {
  min-width: 112rpx;
  height: 58rpx;
  margin: 0 !important;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 4rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 56rpx;
}

.panel-refresh::after { border: 0; }

.metric-block {
  padding: 22rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.metric-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.metric-head-sub {
  margin-top: 16rpx;
}

.metric-name {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  font-weight: 700;
}

.metric-sub-name {
  color: rgba(255, 255, 255, 0.5);
  font-size: 21rpx;
}

.metric-figure {
  color: #e3c98f;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.metric-sub-figure {
  color: rgba(227, 201, 143, 0.8);
  font-size: 24rpx;
  font-weight: 700;
}

.metric-alert {
  color: #e3c98f;
}

.metric-detail {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 20rpx;
  line-height: 1.6;
}

.metric-note {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.32);
  font-size: 18rpx;
  line-height: 1.7;
}

.funnel-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.funnel-step {
  flex: 1;
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 4rpx;
  text-align: center;
}

.funnel-count {
  display: block;
  color: #e3c98f;
  font-size: 32rpx;
  font-weight: 800;
}

.funnel-label {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 19rpx;
}

.funnel-rate {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.36);
  font-size: 18rpx;
}

/* 失败原因清单：一行一个原因，右边是次数和占比。等宽字体让原因码对齐，
   扫一眼就能看出哪一条压倒性地多。 */
.reason-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx 0 8rpx;
}

.reason-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.reason-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-family: var(--font-mono, monospace);
  font-size: 24rpx;
}

.reason-count {
  flex: 0 0 auto;
  font-size: 24rpx;
  opacity: 0.7;
}

.feedback-count-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 16rpx 0 20rpx;
}

.feedback-count {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  border-radius: 4rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 20rpx;
}

.feedback-count text:last-child {
  color: #e3c98f;
  font-size: 28rpx;
  font-weight: 800;
}

.feedback-recent-list {
  border-top: 1rpx solid rgba(255, 255, 255, 0.055);
}

.feedback-recent-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.feedback-recent-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.feedback-type {
  color: #e3c98f;
  font-size: 21rpx;
  font-weight: 800;
}

.feedback-time,
.feedback-version {
  color: rgba(255, 255, 255, 0.38);
  font-size: 18rpx;
}

.feedback-excerpt {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
  line-height: 1.6;
}

.feedback-version {
  display: block;
  margin-top: 6rpx;
}

.feedback-empty {
  display: block;
  padding: 18rpx 0 22rpx;
  color: rgba(255, 255, 255, 0.4);
  font-size: 20rpx;
}

.panel-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.055);
}

.panel-row:last-child {
  border-bottom: 0;
}

.panel-label {
  flex: 0 0 260rpx;
}

.panel-value {
  flex: 1;
  color: rgba(255, 255, 255, 0.64);
  font-size: 22rpx;
  font-weight: 700;
  text-align: right;
  word-break: break-all;
}

.smoke-button {
  margin-top: 22rpx;
}
