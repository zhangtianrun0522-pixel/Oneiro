.dream-input {
  width: 100%;
  min-height: 360rpx;
  margin: 52rpx 0 26rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.035);
  color: rgba(255, 255, 255, 0.76);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  line-height: 1.8;
}

.privacy-note {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.34);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
