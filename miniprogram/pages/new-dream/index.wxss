.dream-input {
  width: 100%;
  min-height: 360rpx;
  margin: 52rpx 0 26rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.035);
  color: rgba(255, 255, 255, 0.76);
  font-size: 28rpx;
  letter-spacing: 4rpx;
  line-height: 1.8;
}

.voice-button {
  width: 100%;
  height: 84rpx;
  margin: 0 0 24rpx;
  border: 1rpx solid rgba(183, 164, 255, 0.28);
  border-radius: 42rpx;
  background: rgba(111, 91, 157, 0.2);
  color: rgba(238, 232, 255, 0.82);
  font-size: 27rpx;
  letter-spacing: 3rpx;
  line-height: 84rpx;
}

.voice-button::after {
  border: 0;
}

.voice-button.recording {
  border-color: rgba(226, 143, 166, 0.72);
  background: rgba(126, 65, 91, 0.42);
  color: rgba(255, 224, 231, 0.95);
  animation: voice-breathing 1.5s ease-in-out infinite;
}

.voice-button[disabled] {
  opacity: 0.55;
}

.recognizing-note {
  display: block;
  margin: -8rpx 0 22rpx;
  color: rgba(220, 210, 248, 0.65);
  font-size: 23rpx;
  letter-spacing: 2rpx;
  text-align: center;
}

@keyframes voice-breathing {
  0% {
    box-shadow: 0 0 0 0 rgba(226, 143, 166, 0.28);
  }

  70% {
    box-shadow: 0 0 0 18rpx rgba(226, 143, 166, 0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(226, 143, 166, 0);
  }
}

.privacy-note {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.34);
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}
