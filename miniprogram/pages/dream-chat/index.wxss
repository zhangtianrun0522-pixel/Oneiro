/* 整屏 flex 纵向：消息区自适应剩余空间，输入器作为最后一个 flex 子项。
   原本消息区写死 height: calc(100vh - 548rpx)、输入器 position:fixed，
   既在空对话时留下大片空白，键盘弹出时也不会重排。 */
.chat-screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 40rpx 40rpx 0;
  background: var(--paper);
  color: var(--ink);
}

.chat-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 48rpx;
  color: #211d17;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.chat-brand text:last-child {
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.chat-context {
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.14);
}

.context-label,
.message-role,
.guide-label {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.context-title {
  display: block;
  margin-top: 12rpx;
  color: #211d17;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
}

.context-dream {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: rgba(33, 29, 23, 0.56);
  font-size: 23rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.guide-list { white-space: nowrap; margin-bottom: 16rpx; }
.guide-chip { display: inline-block; margin-right: 12rpx; padding: 14rpx 18rpx; border: 1rpx solid rgba(184, 134, 59, 0.5); color: var(--ink-70); font-size: var(--fs-label); line-height: 1.35; }

.message-list {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
}

.message-stack {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100%;
  padding-top: 20rpx;
}

.message-row {
  max-width: 88%;
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 0;
}

.is-assistant { margin-right: auto; border-left: 3rpx solid rgba(184, 134, 59, 0.68); background: #fbf6ec; }
.is-user { margin-left: auto; border-right: 3rpx solid rgba(33, 29, 23, 0.58); background: rgba(33, 29, 23, 0.055); }
.is-user .message-role { color: rgba(33, 29, 23, 0.52); }

.message-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(33, 29, 23, 0.78);
  font-size: 27rpx;
  line-height: 1.75;
}

.is-loading { opacity: 0.62; }

.chat-composer {
  flex: 0 0 auto;
  margin: 0 -40rpx;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(33, 29, 23, 0.16);
  background: var(--paper);
}

.composer-row { display: flex; align-items: flex-end; gap: 12rpx; }
.turn-limit { flex: 0 0 auto; color: var(--ink-55); font-size: var(--fs-label); }

.chat-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: var(--tap-min);
  max-height: 160rpx;
  padding: 17rpx 12rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.24);
  border-radius: 0;
  background: transparent;
  color: #211d17;
  font-size: var(--fs-body);
  line-height: 1.5;
}

.voice-button,
.send-button {
  flex: 0 0 var(--tap-min);
  width: var(--tap-min) !important;
  height: var(--tap-min);
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: var(--tap-min);
}

.voice-button { border: 1rpx solid rgba(184, 134, 59, 0.62); background: transparent; color: #8a5d29; }
.voice-button.recording { border-color: #a86d2c; background: #a86d2c; color: #fbf6ec; animation: voice-breathing 1.5s ease-in-out infinite; }
.send-button { border: 1rpx solid #211d17; background: #211d17; color: #f2ecdf; }
.voice-button::after, .send-button::after { border: 0; }
.voice-button[disabled], .send-button[disabled] { opacity: 0.36; }
.composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.voice-note { color: var(--ink-55); font-size: var(--fs-label); }

@keyframes voice-breathing {
  0% { box-shadow: 0 0 0 0 rgba(168, 109, 44, 0.22); }
  70% { box-shadow: 0 0 0 16rpx rgba(168, 109, 44, 0); }
  100% { box-shadow: 0 0 0 0 rgba(168, 109, 44, 0); }
}
