.chat-screen {
  min-height: 100vh;
  padding: 48rpx 40rpx 270rpx;
  background: #f2ecdf;
  color: #211d17;
}

.chat-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 48rpx;
  color: #211d17;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}

.chat-brand text:last-child {
  color: rgba(33, 29, 23, 0.4);
  font-size: 15rpx;
  letter-spacing: 2rpx;
}

.chat-context {
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.14);
}

.context-label,
.message-role,
.guide-label {
  display: block;
  color: #b8863b;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.context-title {
  display: block;
  margin-top: 12rpx;
  color: #211d17;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
}

.context-dream {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: rgba(33, 29, 23, 0.56);
  font-size: 23rpx;
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.guide-section { margin-top: 28rpx; }
.guide-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.guide-chip { padding: 11rpx 14rpx; border: 1rpx solid rgba(184, 134, 59, 0.5); color: rgba(33, 29, 23, 0.68); font-size: 20rpx; line-height: 1.35; }

.message-list {
  height: calc(100vh - 548rpx);
  margin-top: 30rpx;
}

.message-row {
  max-width: 88%;
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 0;
}

.is-assistant { margin-right: auto; border-left: 3rpx solid rgba(184, 134, 59, 0.68); background: #fbf6ec; }
.is-user { margin-left: auto; border-right: 3rpx solid rgba(33, 29, 23, 0.58); background: rgba(33, 29, 23, 0.055); }
.is-user .message-role { color: rgba(33, 29, 23, 0.52); }

.message-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(33, 29, 23, 0.78);
  font-size: 27rpx;
  line-height: 1.75;
}

.is-loading { opacity: 0.62; }

.chat-composer {
  position: fixed;
  z-index: 5;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(33, 29, 23, 0.16);
  background: #f2ecdf;
}

.memory-note { display: block; margin: 0 12rpx 14rpx; color: rgba(33, 29, 23, 0.46); font-size: 19rpx; line-height: 1.55; }
.composer-row { display: flex; align-items: flex-end; gap: 12rpx; }
.turn-limit { flex: 0 0 54rpx; height: 72rpx; color: rgba(33, 29, 23, 0.38); font-size: 17rpx; line-height: 72rpx; text-align: center; }

.chat-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 72rpx;
  max-height: 160rpx;
  padding: 17rpx 12rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.24);
  border-radius: 0;
  background: transparent;
  color: #211d17;
  font-size: 24rpx;
  line-height: 1.5;
}

.voice-button,
.send-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.voice-button { border: 1rpx solid rgba(184, 134, 59, 0.62); background: transparent; color: #8a5d29; }
.voice-button.recording { border-color: #a86d2c; background: #a86d2c; color: #fbf6ec; animation: voice-breathing 1.5s ease-in-out infinite; }
.send-button { border: 1rpx solid #211d17; background: #211d17; color: #f2ecdf; }
.voice-button::after, .send-button::after { border: 0; }
.voice-button[disabled], .send-button[disabled] { opacity: 0.36; }
.voice-note { display: block; margin-top: 10rpx; color: rgba(33, 29, 23, 0.4); font-size: 18rpx; text-align: center; }

@keyframes voice-breathing {
  0% { box-shadow: 0 0 0 0 rgba(168, 109, 44, 0.22); }
  70% { box-shadow: 0 0 0 16rpx rgba(168, 109, 44, 0); }
  100% { box-shadow: 0 0 0 0 rgba(168, 109, 44, 0); }
}
