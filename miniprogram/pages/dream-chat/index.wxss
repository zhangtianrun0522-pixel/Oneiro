.chat-screen {
  min-height: 100vh;
  padding: 30rpx 30rpx 210rpx;
  background: #050609;
}

.chat-context {
  padding: 24rpx 26rpx;
  border-left: 4rpx solid rgba(202, 177, 117, 0.5);
  background: rgba(255, 255, 255, 0.035);
}

.context-label,
.message-role {
  display: block;
  color: rgba(159, 183, 201, 0.52);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.context-title {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 32rpx;
  font-weight: 700;
}

.context-dream {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.38);
  font-size: 22rpx;
  line-height: 1.6;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.message-list {
  height: calc(100vh - 390rpx);
  margin-top: 28rpx;
}

.message-row {
  max-width: 84%;
  margin-bottom: 24rpx;
  padding: 24rpx 26rpx;
  border-radius: 8rpx;
}

.is-assistant {
  margin-right: auto;
  background: rgba(159, 183, 201, 0.1);
}

.is-user {
  margin-left: auto;
  background: rgba(202, 177, 117, 0.13);
}

.is-user .message-role {
  color: rgba(202, 177, 117, 0.64);
}

.message-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 27rpx;
  line-height: 1.75;
}

.is-loading {
  opacity: 0.62;
}

.chat-composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: end;
  gap: 14rpx;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(255, 255, 255, 0.07);
  background: #090b0e;
}

.turn-limit {
  flex: 0 0 56rpx;
  height: 72rpx;
  color: rgba(255, 255, 255, 0.24);
  font-size: 18rpx;
  line-height: 72rpx;
  text-align: center;
}

.chat-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 72rpx;
  max-height: 180rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.74);
  font-size: 25rpx;
  line-height: 1.45;
}

.send-button {
  flex: 0 0 104rpx;
  width: 104rpx;
  height: 72rpx;
  border-radius: 8rpx;
  background: rgba(202, 177, 117, 0.16);
  color: rgba(239, 228, 200, 0.86);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.send-button[disabled] {
  opacity: 0.35;
}
