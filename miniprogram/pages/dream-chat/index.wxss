/* 整屏 flex 纵向：消息区自适应剩余空间，输入器作为最后一个 flex 子项。
   原本消息区写死 height: calc(100vh - 548rpx)、输入器 position:fixed，
   既在空对话时留下大片空白，键盘弹出时也不会重排。 */
.chat-screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 40rpx 40rpx 0;
  background: var(--paper);
  color: var(--ink);
}

.chat-brand {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--space-block);
  color: #211d17;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 6rpx;
}

.chat-brand text:last-child {
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

/* 语境卡与消息区之间是本页最大的一处版式节奏，改用旧金细线 */
.chat-context {
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid rgba(184, 134, 59, 0.4);
}

.context-label,
.message-role,
.guide-label {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.context-title {
  display: block;
  margin-top: var(--space-tight);
  color: #211d17;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.35;
}

.context-dream {
  display: -webkit-box;
  margin-top: var(--space-tight);
  overflow: hidden;
  color: rgba(33, 29, 23, 0.56);
  font-size: var(--fs-label);
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.guide-list { white-space: nowrap; margin-bottom: 16rpx; }
.guide-chip { display: inline-block; margin-right: 12rpx; padding: 14rpx 18rpx; border: 1rpx solid rgba(184, 134, 59, 0.5); color: var(--ink-70); font-size: var(--fs-label); line-height: 1.35; }

.message-list {
  flex: 1;
  min-height: 0;
  margin-top: var(--space-tight);
}

.message-stack {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100%;
  padding-top: 20rpx;
}

/* 内边距/间距对齐参考稿的疏朗感：12px/14px 的气泡内边距，
   消息之间 16px 的呼吸区（气泡结构本身不改，仍是不对称小圆角） */
.message-row {
  max-width: 88%;
  margin-bottom: 32rpx;
  padding: 24rpx 28rpx;
}

/* 不对称小圆角给出方向感：AI 消息左上直角贴着旧金强调边，
   用户消息右上直角贴着深墨强调边，克制不做气泡尾巴 */
.is-assistant { margin-right: auto; border-left: 3rpx solid rgba(184, 134, 59, 0.68); border-radius: 0 16rpx 16rpx 16rpx; background: #fbf6ec; }
.is-user { margin-left: auto; border-right: 3rpx solid rgba(33, 29, 23, 0.58); border-radius: 16rpx 0 16rpx 16rpx; background: rgba(33, 29, 23, 0.055); }
.is-user .message-role { color: rgba(33, 29, 23, 0.52); }

/* 每条 AI 回复不再用「ONEIRO」文字重复标签，换成小印——
   角色标识变成品牌印记，也省下一行大写字母的视觉噪音 */
.message-role-seal {
  margin-bottom: 10rpx;
}

.message-copy {
  display: block;
  margin-top: 12rpx;
  color: rgba(33, 29, 23, 0.78);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

.is-loading { opacity: 0.62; }

/* 输入器与消息区之间同样是版式节奏，与上方 .chat-context 呼应 */
.chat-composer {
  flex: 0 0 auto;
  margin: 0 -40rpx;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(184, 134, 59, 0.4);
  background: var(--paper);
}

.composer-row { display: flex; align-items: flex-end; gap: 12rpx; }
.turn-limit { flex: 0 0 auto; color: var(--ink-55); font-size: var(--fs-label); }

/* 胶囊输入框：参考稿是浅底色圆角胶囊而非下划线单线，这里换成
   同类的浅墨色底 + 全圆角，视觉上更贴近「说点什么…」的疏朗感 */
.chat-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: var(--tap-min);
  max-height: 160rpx;
  padding: 17rpx 28rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(33, 29, 23, 0.05);
  color: #211d17;
  font-size: var(--fs-body);
  line-height: 1.5;
}

/* 圆形提交按钮：说 / 发送两个按钮宽高相等，直接改成正圆即可对齐
   参考稿的圆形提交按钮版式，不涉及任何手势逻辑改动 */
.voice-button,
.send-button {
  flex: 0 0 var(--tap-min);
  width: var(--tap-min) !important;
  height: var(--tap-min);
  margin: 0;
  padding: 0;
  border-radius: 50%;
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: var(--tap-min);
}

.voice-button { border: 1rpx solid rgba(184, 134, 59, 0.62); background: transparent; color: var(--gold-ink); }
/* dream-chat 页唯一的朱砂点睛：录音激活态。此前是与朱砂无关的琥珀色，
   现改为朱砂，呼应 home 页语音按钮录音态的同一处理 */
.voice-button.recording { border-color: var(--cinnabar-ink); background: var(--cinnabar-ink); color: var(--paper-raised); animation: voice-breathing 1.5s ease-in-out infinite; }
.send-button { border: 1rpx solid #211d17; background: #211d17; color: #f2ecdf; }
.voice-button::after, .send-button::after { border: 0; }
.voice-button[disabled], .send-button[disabled] { opacity: 0.36; }
.composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.voice-note { color: var(--ink-55); font-size: var(--fs-label); }

@keyframes voice-breathing {
  0% { box-shadow: 0 0 0 0 rgba(178, 58, 50, 0.24); }
  70% { box-shadow: 0 0 0 16rpx rgba(178, 58, 50, 0); }
  100% { box-shadow: 0 0 0 0 rgba(178, 58, 50, 0); }
}
