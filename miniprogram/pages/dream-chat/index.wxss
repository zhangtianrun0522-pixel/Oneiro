/* 整屏 flex 纵向：消息区自适应剩余空间，输入器作为最后一个 flex 子项。
   原本消息区写死 height: calc(100vh - 548rpx)、输入器 position:fixed，
   既在空对话时留下大片空白，键盘弹出时也不会重排。 */
.chat-screen {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 40rpx 40rpx 0;
  background-color: var(--paper);
  /* 这三个根节点都是不透明的满屏块，会盖住 page 上铺的 --paper-noise。
     原本只写 background: var(--paper)，纸纹到这三屏就断了 —— 解读页与
     分享页恰恰是最需要纸感的两屏。与 app.wxss 的 .screen 保持同一套写法。 */
  background-image: var(--paper-noise);
  background-repeat: repeat;
  background-size: 64rpx 64rpx;
  color: var(--ink);
}

/* 顶部只保留设计稿要的「编号 · 梦名」一行，去掉英文栏目眉与品牌行，
   字号对齐设计稿的 10.5px 说明文字 */
.chat-context {
  padding: 0 0 24rpx;
  border-bottom: 1rpx solid rgba(184, 134, 59, 0.4);
}

.guide-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.context-title {
  display: block;
  color: var(--ink-70);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.context-dream {
  display: -webkit-box;
  margin-top: var(--space-tight);
  overflow: hidden;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.7;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.guide-list { white-space: nowrap; margin-bottom: 16rpx; }
.guide-chip { display: inline-block; margin-right: 12rpx; padding: 12rpx 16rpx; border: 1rpx solid rgba(184, 134, 59, 0.5); border-radius: 4rpx; color: var(--ink-70); font-size: 20rpx; line-height: 1.35; }

.message-list {
  flex: 1;
  min-height: 0;
  margin-top: var(--space-tight);
}

.message-stack {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 100%;
  padding-top: 20rpx;
}

/* 消息间距对齐设计稿：78% 最大宽度，消息之间 16px 呼吸区。
   标签（你/追问/回应）落在气泡外面，气泡本身改成设计稿的近直角
   border-radius:2px，不再是旧的不对称小圆角 + 侧边强调线 */
.message-row {
  max-width: 78%;
  margin-bottom: 32rpx;
}

.is-user { margin-left: auto; }
.is-question,
.is-response { margin-right: auto; }

/* 「追问」「回应」标签同色：设计稿字面量 rgba(184,134,59,0.9) 在暖纸上
   只有约 2.45:1，改用已校准的 --gold-ink（4.84:1） */
.message-role {
  display: block;
  margin-bottom: 10rpx;
  color: var(--gold-ink);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 「你」标签：设计稿没画（用户气泡没有标签），产品所有者明确要求保留，
   字面量对照 rgba(33,29,23,0.52) 约 3:1 不够，改用 --ink-70（6.1:1） */
.is-user .message-role { color: var(--ink-70); }

.message-copy { display: block; }

/* 追问：唯一一个带底色的气泡，宋体斜体 */
.is-question .message-copy {
  padding: 24rpx 28rpx;
  border-radius: 4rpx;
  background: #ede4d0;
  color: #211d17;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 27rpx;
  line-height: 1.7;
}

/* 用户消息：深墨底、暖纸字，右对齐 */
.is-user .message-copy {
  padding: 24rpx 28rpx;
  border-radius: 4rpx;
  background: #211d17;
  color: #f5f2e9;
  font-size: 26rpx;
  line-height: 1.7;
}

/* 回应：无气泡，纯文字，与追问/用户两种"有底色"的消息形成对比 */
.is-response .message-copy {
  color: rgba(33, 29, 23, 0.75);
  font-size: 26rpx;
  line-height: 1.8;
}

.is-loading { opacity: 0.62; }

/* 输入器与消息区之间同样是版式节奏，与上方 .chat-context 呼应 */
.chat-composer {
  flex: 0 0 auto;
  margin: 0 -40rpx;
  padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(184, 134, 59, 0.4);
  background: var(--paper);
}

.composer-row { display: flex; align-items: flex-end; gap: 12rpx; }
/* 字面量 --ink-55（约 3.95:1）在 11px 小字上不够稳，统一换成 --ink-70 */
.turn-limit { flex: 0 0 auto; color: var(--ink-70); font-size: var(--fs-label); }

/* 胶囊输入框：对齐设计稿 border-radius:20px / padding:11px 16px /
   12.5px 字号（已是圆角胶囊，这里只收紧内边距与字号） */
.chat-input {
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: var(--tap-min);
  max-height: 160rpx;
  padding: 22rpx 32rpx;
  border: 0;
  border-radius: 40rpx;
  background: rgba(33, 29, 23, 0.05);
  color: #211d17;
  font-size: 25rpx;
  line-height: 1.5;
}

/* 圆形提交按钮：设计稿是 34px 正圆，这里保持 --tap-min（88rpx/44pt）
   触控最小尺寸不缩小，只让说 / 发送两个按钮的形状与配色贴近设计稿——
   语音是真实功能（按住说话→识别），设计稿没画，予以保留，只换皮 */
.voice-button,
.send-button {
  flex: 0 0 var(--tap-min);
  width: var(--tap-min) !important;
  height: var(--tap-min);
  margin: 0 !important;
  padding: 0;
  border-radius: 50%;
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: var(--tap-min);
}

.voice-button { border: 1rpx solid rgba(184, 134, 59, 0.62); background: transparent; color: var(--gold-ink); }
/* dream-chat 页唯一的朱砂点睛：录音激活态。此前是与朱砂无关的琥珀色，
   现改为朱砂，呼应 home 页语音按钮录音态的同一处理 */
.voice-button.recording { border-color: var(--cinnabar-ink); background: var(--cinnabar-ink); color: var(--paper-raised); animation: voice-breathing 1.5s ease-in-out infinite; }
/* 发送按钮：设计稿是黑底圆钮内含「↑」，箭头稍微放大一档更易读 */
.send-button { border: 1rpx solid #211d17; background: #211d17; color: #f2ecdf; font-size: 28rpx; }
.voice-button::after, .send-button::after { border: 0; }
.voice-button[disabled], .send-button[disabled] { opacity: 0.36; }
.composer-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.voice-note { color: var(--ink-70); font-size: var(--fs-label); }
/* 倒数只加重同一句话，不另起一种颜色语言。 */
.voice-note.is-limit { color: var(--cinnabar-ink); font-weight: 600; }

/* 聊满轮次上限后的收束态。这里刻意不是一条灰色提示，而是一个有出口的
   结束卡片——一个不能再输入的界面必须自己说清为什么，并把用户送到下一步，
   否则读起来就是发不出去。 */
.chat-ended {
  padding: 28rpx 8rpx 4rpx;
}
.chat-ended-title {
  display: block;
  color: var(--ink);
  font-size: var(--fs-body);
  font-weight: 700;
}
.chat-ended-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
}
.chat-ended-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.chat-ended-primary,
.chat-ended-secondary {
  flex: 1;
  min-height: var(--tap-min);
  margin: 0;
  padding: 0 16rpx;
  border-radius: 40rpx;
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: var(--tap-min);
}
.chat-ended-primary::after,
.chat-ended-secondary::after { border: 0; }
.chat-ended-primary {
  border: 1rpx solid rgba(33, 29, 23, 0.72);
  background: var(--paper-raised);
  color: var(--ink);
}
.chat-ended-secondary {
  border: 1rpx solid rgba(184, 134, 59, 0.5);
  background: transparent;
  color: var(--ink-70);
}

@keyframes voice-breathing {
  0% { box-shadow: 0 0 0 0 rgba(178, 58, 50, 0.24); }
  70% { box-shadow: 0 0 0 16rpx rgba(178, 58, 50, 0); }
  100% { box-shadow: 0 0 0 0 rgba(178, 58, 50, 0); }
}
