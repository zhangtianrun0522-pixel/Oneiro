.empty {
  margin-top: 80rpx;
  padding: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 28rpx;
  color: rgba(255, 255, 255, 0.35);
  font-size: 26rpx;
  line-height: 1.8;
}

.archive-list {
  margin-top: 52rpx;
}

.archive-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.035);
  text-align: left;
}

.archive-title {
  display: block;
  color: rgba(255, 255, 255, 0.66);
  font-size: 30rpx;
  letter-spacing: 6rpx;
}

.archive-copy {
  display: block;
  width: 430rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.26);
  font-size: 22rpx;
  letter-spacing: 3rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-date {
  color: rgba(255, 255, 255, 0.18);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}
