.empty {
  margin-top: var(--space-block);
  padding: 36rpx 0;
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
  border-right: 0;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.12);
  border-left: 0;
  border-radius: 0;
  color: rgba(33, 29, 23, 0.5);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

.archive-list {
  margin-top: var(--space-block);
}

.timeline-month {
  margin-top: var(--space-block);
}

.timeline-month:first-child {
  margin-top: 0;
}

.timeline-month-label {
  display: block;
  color: #211d17;
  font-size: var(--fs-body);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.timeline-track {
  position: relative;
  margin-top: 10rpx;
}

.timeline-track::before {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 19rpx;
  width: 1rpx;
  background: rgba(33, 29, 23, 0.16);
  content: '';
}

.timeline-entry {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 168rpx;
  margin: 0;
  padding: 18rpx 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.timeline-entry::after {
  border: 0;
}

.timeline-rail {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  flex: 0 0 36rpx;
  align-self: stretch;
}

.timeline-node {
  position: relative;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  border: 4rpx solid var(--gold-line);
  border-radius: 50%;
  background: var(--paper);
}

.timeline-node.is-key-node {
  width: 15rpx;
  height: 15rpx;
  border-color: var(--gold-line);
  background: var(--gold-line);
  box-shadow: 0 0 0 5rpx rgba(184, 134, 59, 0.12);
}

/* 「一叠牌」暗示：frame 是不裁切的定位容器，::before 在其身后垫一张
   偏移的纸色底卡（细描边即可，不需要投影），archive-thumb 本身裁切
   缩略图并叠一层轻投影，读作最上面那张牌盖住了底下一叠 */
.archive-thumb-frame {
  position: relative;
  width: 106rpx;
  height: 132rpx;
  flex: 0 0 106rpx;
}

.archive-thumb-frame::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 106rpx;
  height: 132rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.3);
  background: var(--paper-raised);
}

.archive-thumb {
  position: relative;
  z-index: 1;
  width: 106rpx;
  height: 132rpx;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  box-shadow: 0 4rpx 10rpx rgba(33, 29, 23, 0.16);
  background: linear-gradient(145deg, #18202a, #68737c 62%, #e4e4dc);
}

.archive-thumb.theme-tide { background: linear-gradient(145deg, #102832, #356f78 62%, #d5e8df); }
.archive-thumb.theme-threshold { background: linear-gradient(145deg, #1c2130, #73634a 62%, #ead9aa); }
.archive-thumb.theme-shadow { background: linear-gradient(145deg, #0d0f16, #273049 62%, #a8b2c3); }
.archive-thumb.theme-falling { background: linear-gradient(145deg, #191729, #555070 62%, #ead0be); }
.archive-thumb.theme-archive { background: linear-gradient(145deg, #172033, #5c6573 62%, #e0d8c4); }
.archive-thumb.theme-hearth { background: linear-gradient(145deg, #201819, #755243 62%, #efd2a6); }
.archive-thumb.theme-moon { background: linear-gradient(145deg, #10182b, #3e517a 62%, #dfe7f1); }

.archive-thumb-image {
  width: 100%;
  height: 100%;
  background: transparent;
}

/* 无缩略图时的兜底占位：叠在彩色主题渐变（.archive-thumb 的 artwork
   底色）之上，因此仍需浅色文字来保持可读，与页面纸色主题无关 */
.archive-thumb-placeholder {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(5, 7, 12, 0.48));
  color: rgba(255, 255, 255, 0.72);
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.timeline-copy {
  min-width: 0;
  flex: 1;
  padding: 0 16rpx;
}

.timeline-repeat {
  display: block;
  margin-top: 8rpx;
  color: rgba(184, 134, 59, 0.86);
  font-size: var(--fs-label);
}

.deck-count {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 5rpx;
}

.insight-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-tight);
}

/* .insight-key / .insight-value 只出现在深色的 .mo-tags 里，因此按
   暗底校准：--gold-line 在 #211d17 上 5.2:1，胶囊底用低透明度旧金
   （flatten 后约 #392e1d）配 92% 暖纸字，实测约 9.6:1，远超 4.5:1 门槛。 */
.insight-key {
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 800;
}

.insight-value {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.35);
  border-radius: 0;
  background: rgba(184, 134, 59, 0.16);
  color: rgba(242, 236, 223, 0.92);
  font-size: var(--fs-label);
}

.filter-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: var(--space-tight);
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.54);
  background: var(--paper-raised);
  color: rgba(33, 29, 23, 0.62);
  font-size: var(--fs-label);
}

.filter-clear {
  flex: 0 0 auto;
  color: var(--gold-line);
  font-size: var(--fs-label);
}

.archetype-banner-arrow {
  color: var(--gold-line);
}

/* .archive-title 在「关键时刻」条目内外最终显示效果一致（键时刻的
   .timeline-entry.is-key-moment .archive-title 特化色已并入这条通用规则） */
.archive-title {
  display: block;
  color: #211d17;
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.archive-weather {
  display: block;
  width: 360rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-date {
  margin-left: auto;
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 4rpx;
}

.timeline-copy .archive-date {
  display: block;
  margin-left: 0;
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.timeline-copy .archive-weather {
  width: auto;
  margin-top: 8rpx;
}

/* ── 本月观察：合并原「阶段观察 / 本月主牌 / 阶段原型」三张卡 ──
   现在是全页唯一的反色卡片（深墨底 var(--ink) + 暖纸字 var(--paper)），
   用来把「本月观察」立成全页视觉主角。.month-observation-deck 是定位
   容器，背后两层 .deck-shadow（纸色、旋转偏移）垫出「一叠牌」的厚度，
   .month-observation 本身是叠在最上面那张牌。数据上只有当月这一张卡
   （dreamMemory.buildMonthlyCard 不产出历史月份数组），所以只做叠牌厚度
   的静态视觉，不做左右翻页圆点或滑动交互——避免呈现不存在的翻页能力。 */
.month-observation-deck {
  position: relative;
  margin-top: var(--space-block);
  margin-bottom: 20rpx;
}

.deck-shadow {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 1rpx solid rgba(184, 134, 59, 0.26);
  background-color: var(--paper-raised);
  background-image: var(--paper-noise);
  background-repeat: repeat;
  background-size: 64rpx 64rpx;
  box-shadow: 0 6rpx 16rpx rgba(33, 29, 23, 0.1);
}

.deck-shadow-2 {
  z-index: 0;
  transform: rotate(2.6deg) translate(6rpx, 8rpx);
}

.deck-shadow-1 {
  z-index: 1;
  transform: rotate(1.1deg) translate(3rpx, 4rpx);
}

.month-observation {
  position: relative;
  z-index: 2;
  padding: var(--space-group);
  border: 1rpx solid rgba(184, 134, 59, 0.4);
  background-color: var(--ink);
  box-shadow: 0 14rpx 30rpx rgba(33, 29, 23, 0.28);
}

/* archive 页唯一的朱砂点睛：标题前一枚 8rpx 印章方块，纯 CSS 伪元素，
   不需要改 WXML。深卡底上标签一律用 --gold-line（在 #211d17 上 5.2:1），
   而不是给浅纸背景校准过的 --gold-ink（在深底上对比度会塌陷）。 */
.mo-label {
  display: block;
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.mo-label::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  background: var(--cinnabar);
  vertical-align: middle;
}

.mo-title {
  display: block;
  margin-top: var(--space-tight);
  color: var(--paper);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.mo-divider {
  width: 44rpx;
  height: 1rpx;
  margin: var(--space-tight) 0 12rpx;
  background: rgba(184, 134, 59, 0.5);
}

.mo-copy {
  display: block;
  color: rgba(242, 236, 223, 0.85);
  font-size: var(--fs-aux);
  line-height: 1.72;
}

.mo-tags { margin-top: var(--space-group); }

.mo-archetype {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-tight);
  padding-top: var(--space-tight);
  border-top: 1rpx solid rgba(184, 134, 59, 0.3);
}

.mo-archetype-copy { color: rgba(242, 236, 223, 0.85); font-size: var(--fs-aux); font-weight: 700; }
.mo-archetype-arrow { flex: 0 0 auto; color: var(--gold-line); font-size: var(--fs-label); font-weight: 700; }

/* 重复线索：insights.recurringSymbols 是既有数据字段，与卡内「情绪/场景/
   人物」互不重复；坐落在普通纸面背景上，复用与页面其余部分一致的
   旧金浅底胶囊（--gold-ink 在 --paper 上 4.85:1，已由 app.wxss 顶部注释校准）。 */
.recurring-clues { margin-top: var(--space-block); }

.recurring-clues-label {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.recurring-clues-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: var(--space-tight);
}

.recurring-clue-tag {
  padding: 8rpx 16rpx;
  border-radius: 0;
  background: rgba(184, 134, 59, 0.12);
  color: var(--gold-ink);
  font-size: var(--fs-label);
}
