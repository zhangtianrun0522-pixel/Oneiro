.empty {
  margin-top: var(--space-block);
  padding: 36rpx 0;
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
  border-right: 0;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.12);
  border-left: 0;
  border-radius: 0;
  color: rgba(33, 29, 23, 0.5);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

.archive-list {
  margin-top: var(--space-block);
}

.timeline-month {
  margin-top: var(--space-block);
}

.timeline-month:first-child {
  margin-top: 0;
}

.timeline-month-label {
  display: block;
  color: #211d17;
  font-size: var(--fs-body);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.timeline-track {
  position: relative;
  margin-top: 10rpx;
}

.timeline-track::before {
  position: absolute;
  top: 18rpx;
  bottom: 18rpx;
  left: 19rpx;
  width: 1rpx;
  background: rgba(33, 29, 23, 0.16);
  content: '';
}

.timeline-entry {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 168rpx;
  margin: 0;
  padding: 18rpx 0;
  border: 0;
  background: transparent;
  text-align: left;
}

.timeline-entry::after {
  border: 0;
}

.timeline-rail {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  flex: 0 0 36rpx;
  align-self: stretch;
}

.timeline-node {
  position: relative;
  z-index: 1;
  width: 11rpx;
  height: 11rpx;
  border: 4rpx solid var(--gold-line);
  border-radius: 50%;
  background: var(--paper);
}

.timeline-node.is-key-node {
  width: 15rpx;
  height: 15rpx;
  border-color: var(--gold-line);
  background: var(--gold-line);
  box-shadow: 0 0 0 5rpx rgba(184, 134, 59, 0.12);
}

.archive-thumb {
  position: relative;
  width: 106rpx;
  height: 132rpx;
  flex: 0 0 106rpx;
  overflow: hidden;
  border: 0;
  border-radius: 0;
  background: linear-gradient(145deg, #18202a, #68737c 62%, #e4e4dc);
}

.archive-thumb.theme-tide { background: linear-gradient(145deg, #102832, #356f78 62%, #d5e8df); }
.archive-thumb.theme-threshold { background: linear-gradient(145deg, #1c2130, #73634a 62%, #ead9aa); }
.archive-thumb.theme-shadow { background: linear-gradient(145deg, #0d0f16, #273049 62%, #a8b2c3); }
.archive-thumb.theme-falling { background: linear-gradient(145deg, #191729, #555070 62%, #ead0be); }
.archive-thumb.theme-archive { background: linear-gradient(145deg, #172033, #5c6573 62%, #e0d8c4); }
.archive-thumb.theme-hearth { background: linear-gradient(145deg, #201819, #755243 62%, #efd2a6); }
.archive-thumb.theme-moon { background: linear-gradient(145deg, #10182b, #3e517a 62%, #dfe7f1); }

.archive-thumb-image {
  width: 100%;
  height: 100%;
  background: transparent;
}

/* 无缩略图时的兜底占位：叠在彩色主题渐变（.archive-thumb 的 artwork
   底色）之上，因此仍需浅色文字来保持可读，与页面纸色主题无关 */
.archive-thumb-placeholder {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  padding: 12rpx 10rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(5, 7, 12, 0.48));
  color: rgba(255, 255, 255, 0.72);
  font-size: 15rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.timeline-copy {
  min-width: 0;
  flex: 1;
  padding: 0 16rpx;
}

.timeline-repeat {
  display: block;
  margin-top: 8rpx;
  color: rgba(184, 134, 59, 0.86);
  font-size: var(--fs-label);
}

.deck-count {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 5rpx;
}

.insight-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: var(--space-tight);
}

.insight-key {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
}

.insight-value {
  padding: 7rpx 14rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.14);
  border-radius: 0;
  background: transparent;
  color: var(--ink-70);
  font-size: var(--fs-label);
}

.filter-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: var(--space-tight);
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.54);
  background: var(--paper-raised);
  color: rgba(33, 29, 23, 0.62);
  font-size: var(--fs-label);
}

.filter-clear {
  flex: 0 0 auto;
  color: var(--gold-line);
  font-size: var(--fs-label);
}

.archetype-banner-arrow {
  color: var(--gold-line);
}

/* .archive-title 在「关键时刻」条目内外最终显示效果一致（键时刻的
   .timeline-entry.is-key-moment .archive-title 特化色已并入这条通用规则） */
.archive-title {
  display: block;
  color: #211d17;
  font-size: var(--fs-body);
  font-weight: 600;
  letter-spacing: 1rpx;
}

.archive-weather {
  display: block;
  width: 360rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.archive-date {
  margin-left: auto;
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 4rpx;
}

.timeline-copy .archive-date {
  display: block;
  margin-left: 0;
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.timeline-copy .archive-weather {
  width: auto;
  margin-top: 8rpx;
}

/* ── 本月观察：合并原「阶段观察 / 本月主牌 / 阶段原型」三张卡 ── */
.month-observation {
  margin-top: var(--space-block);
  padding: 30rpx 28rpx;
  border-left: 3rpx solid var(--gold-line);
  background: var(--paper-raised);
}

/* archive 页唯一的朱砂点睛：标题前一枚 8rpx 印章方块，纯 CSS 伪元素，
   不需要改 WXML */
.mo-label {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
}

.mo-label::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  background: var(--cinnabar);
  vertical-align: middle;
}

.mo-title {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 2rpx;
}

.mo-copy {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.72;
}

.mo-tags { margin-top: var(--space-group); }

.mo-archetype {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-tight);
  padding-top: var(--space-tight);
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
}

.mo-archetype-copy { color: var(--ink-70); font-size: var(--fs-aux); font-weight: 700; }
.mo-archetype-arrow { flex: 0 0 auto; color: var(--gold-ink); font-size: var(--fs-label); font-weight: 700; }
