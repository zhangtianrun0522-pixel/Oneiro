/* ── 头部：单行「标题 + 计数」，baseline 对齐、两端对齐 ──
   设计稿 4a 去掉了 ONEIRO/ARCHIVE 品牌行与 Private Dream Archive 英文眉，
   .archive-header 是页面专属的头部行，不复用 app.wxss 的 .brand/.eyebrow/.title */
.archive-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.archive-header-title {
  color: #211d17;
  font-size: 32rpx;
  font-weight: 600;
}

/* 设计稿字面值 rgba(33,29,23,0.4) 在 --paper(#F2ECDF) 上实测约 2.4:1，
   11px 小字远达不到 4.5:1；改用已有的 --ink-70 token（同一底色下约 6.1:1）。 */
.archive-header-count {
  color: var(--ink-70);
  font-size: 22rpx;
}

.filter-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: var(--space-tight);
  padding: 18rpx 20rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.54);
  background: var(--paper-raised);
  color: rgba(33, 29, 23, 0.62);
  font-size: var(--fs-label);
}

.filter-clear {
  flex: 0 0 auto;
  color: var(--gold-line);
  font-size: var(--fs-label);
}

.empty {
  margin-top: var(--space-block);
  padding: 36rpx 0;
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.12);
  color: rgba(33, 29, 23, 0.5);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

/* ── 本月观察牌组 ──────────────────────────────────────────
   .month-observation-deck 是定位容器，背后两层 .deck-shadow（纸色、旋转
   偏移）垫出「一叠牌」的厚度，.month-observation 是叠在最上面那张深墨卡。
   数据上只有当月这一张卡（dreamMemory.buildMonthlyCard 不产出历史月份
   数组），所以只做叠牌厚度的静态视觉，不做设计稿里的左右翻页圆点或
   「‹ 滑动翻阅其他月份 ›」滑动提示——那会呈现出并不存在的翻页能力。
   卡片本身给了一个明确的 rpx 高度（对应设计稿 214px），因为绝对定位的
   .deck-shadow 需要一个有具体高度的定位祖先才能用百分比撑开；卡内文案
   全部来自 dreamMemory 的模板字符串，长度有界，不会撑爆这个高度。 */
.month-observation-deck {
  position: relative;
  height: 428rpx;
  margin-top: 40rpx;
  margin-bottom: 36rpx;
}

.deck-shadow {
  position: absolute;
  border: 2rpx solid rgba(33, 29, 23, 0.1);
  box-shadow: 0 12rpx 32rpx rgba(33, 29, 23, 0.1);
}

.deck-shadow-2 {
  top: 24rpx;
  left: 28rpx;
  z-index: 0;
  width: calc(100% - 28rpx);
  height: calc(100% - 24rpx);
  background: #e8dfc9;
  transform: rotate(3.5deg);
}

.deck-shadow-1 {
  top: 12rpx;
  left: 14rpx;
  z-index: 1;
  width: calc(100% - 14rpx);
  height: calc(100% - 12rpx);
  background: #ede4d0;
  transform: rotate(1.5deg);
}

.month-observation {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: space-between;
  padding: 40rpx;
  background: var(--ink);
  color: #f5f2e9;
  box-shadow: 0 28rpx 60rpx rgba(33, 29, 23, 0.28);
}

.mo-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

/* 深卡上的对比度核算（bg #211d17，相对亮度 L≈0.0127）：
   - 设计稿字面值 rgba(184,134,59,0.85) 精确核算约 4.13:1，够不到 4.5:1
     （简报估算的约 4.8:1 有偏差）；改用不透明 --gold-line（#B8863B）,
     实测约 5.20:1，与本文件其余深卡金色标签保持一致。 */
.mo-eyebrow {
  display: block;
  color: var(--gold-line);
  font-size: 19rpx;
  letter-spacing: 6rpx;
}

/* 设计稿字面值 rgba(245,242,233,0.4) 约 3.51:1，不达标；
   提到 0.5 后约 4.71:1，通过。卡内其余次级文字统一复用这个不透明度。 */
.mo-meta {
  display: block;
  margin-top: 6rpx;
  color: rgba(245, 242, 233, 0.5);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

/* 环形徽标是纯装饰图形，按“装饰图形 ≥3:1”核算：设计稿边框用 0.5 透明度
   的旧金在深卡上只有约 2.29:1，不够；改成不透明 --gold-line（约 5.20:1）。 */
.mo-badge {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border: 2rpx solid var(--gold-line);
  border-radius: 50%;
}

.mo-badge-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gold-line);
}

/* 纯分隔线，不承载文字信息，理论上可以豁免非文本对比度要求；
   为了和卡内其余金色元素统一，这里同样改用不透明 --gold-line。 */
.mo-divider {
  width: 44rpx;
  height: 2rpx;
  margin: 28rpx 0 24rpx;
  background: var(--gold-line);
}

/* rgba(242,236,223,0.85) 在深卡上约 10.6:1，远超 4.5:1 门槛 */
.mo-copy {
  display: block;
  flex: 1;
  color: rgba(242, 236, 223, 0.85);
  font-family: var(--font-serif);
  font-size: 34rpx;
  line-height: 1.65;
}

.mo-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 设计稿字面值 rgba(245,242,233,0.45) 约 4.08:1，同样够不到 4.5:1；
   统一提到 0.5（约 4.71:1），与 .mo-meta 保持一致 */
.mo-bottom-left {
  color: rgba(245, 242, 233, 0.5);
  font-size: 21rpx;
}

/* 不透明 --gold-line 约 5.20:1，设计稿此处本就是不透明色，无需调整 */
.mo-bottom-right {
  flex-shrink: 0;
  color: var(--gold-line);
  font-size: 21rpx;
}

/* ── 重复线索 ──────────────────────────────────────────────
   浅纸背景上的「眉标签」统一用 --gold-ink（#8A5D29，在 --paper 上约
   4.85:1，app.wxss 顶部注释已校准），不用设计稿字面值 rgba(33,29,23,0.35)
   （约 2.12:1，不达标）或 #B8863B（约 2.74:1，同样不达标）。 */
.recurring-clues {
  margin-top: 24rpx;
}

.recurring-clues-label {
  display: block;
  color: var(--gold-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.recurring-clues-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.recurring-clue-tag {
  padding: 10rpx 20rpx;
  border-radius: 4rpx;
  background: rgba(184, 134, 59, 0.12);
  color: var(--gold-ink);
  font-size: 22rpx;
}

/* ── 阶段梦境原型条 ──────────────────────────────────────────
   设计稿里独立于卡片之外的完整入口，给了明确的 tap 区域（--tap-min）,
   与卡片底行的快捷角标并存 */
.archetype-strip {
  display: flex;
  min-height: var(--tap-min);
  align-items: center;
  justify-content: space-between;
  margin-top: 40rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid rgba(184, 134, 59, 0.4);
}

.archetype-strip-label {
  display: block;
  color: var(--gold-ink);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.archetype-strip-value {
  display: block;
  margin-top: 8rpx;
  color: #211d17;
  font-family: var(--font-serif);
  font-size: 26rpx;
}

/* 设计稿字面值 rgba(33,29,23,0.4) 约 2.4:1，同上不达标，改用 --ink-70 */
.archetype-strip-arrow {
  flex-shrink: 0;
  color: var(--ink-70);
  font-size: 22rpx;
}

/* ── 月份分组列表 ─────────────────────────────────────────── */
.archive-list {
  margin-top: 40rpx;
}

.timeline-month {
  margin-top: var(--space-block);
}

.timeline-month:first-child {
  margin-top: 0;
}

/* 与重复线索/阶段原型标签同一套「眉标签」颜色规则，统一用 --gold-ink */
.timeline-month-label {
  display: block;
  color: var(--gold-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.timeline-track {
  margin-top: 20rpx;
}

.timeline-entry {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 168rpx;
  margin: 0;
  padding: 24rpx 0;
  border: 0;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.08);
  background: transparent;
  text-align: left;
}

.timeline-entry:last-child {
  border-bottom: 0;
}

.timeline-entry::after {
  border: 0;
}

.archive-thumb-frame {
  position: relative;
  width: 76rpx;
  height: 100rpx;
  flex: 0 0 76rpx;
}

.archive-thumb {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: linear-gradient(145deg, #18202a, #68737c 62%, #e4e4dc);
}

.archive-thumb.theme-tide { background: linear-gradient(145deg, #102832, #356f78 62%, #d5e8df); }
.archive-thumb.theme-threshold { background: linear-gradient(145deg, #1c2130, #73634a 62%, #ead9aa); }
.archive-thumb.theme-shadow { background: linear-gradient(145deg, #0d0f16, #273049 62%, #a8b2c3); }
.archive-thumb.theme-falling { background: linear-gradient(145deg, #191729, #555070 62%, #ead0be); }
.archive-thumb.theme-archive { background: linear-gradient(145deg, #172033, #5c6573 62%, #e0d8c4); }
.archive-thumb.theme-hearth { background: linear-gradient(145deg, #201819, #755243 62%, #efd2a6); }
.archive-thumb.theme-moon { background: linear-gradient(145deg, #10182b, #3e517a 62%, #dfe7f1); }

.archive-thumb-image {
  width: 100%;
  height: 100%;
  background: transparent;
}

/* 无缩略图时的兜底占位：叠在彩色主题渐变（.archive-thumb 的 artwork
   底色）之上，因此仍需浅色文字来保持可读，与页面纸色主题无关 */
.archive-thumb-placeholder {
  display: flex;
  align-items: flex-end;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 7rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(5, 7, 12, 0.48));
  color: rgba(255, 255, 255, 0.72);
  font-size: 11rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.timeline-copy {
  min-width: 0;
  flex: 1;
  padding-left: 24rpx;
}

.archive-title {
  display: block;
  color: #211d17;
  font-family: var(--font-serif);
  font-size: 27rpx;
}

/* 设计稿字面值 rgba(33,29,23,0.45) 在 --paper 上实测约 2.74:1，不达标；
   改用已有的 --ink-70 token（同一底色下约 6.1:1，与 .archive-header-count
   一致），11px 小字必须过 4.5:1 */
.archive-meta {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--ink-70);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-repeat {
  display: block;
  margin-top: 8rpx;
  color: var(--gold-ink);
  font-size: var(--fs-label);
}
