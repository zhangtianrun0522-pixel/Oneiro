<view class="screen">
  <view class="brand">
    <text>ONEIRO</text>
    <text>ARCHIVE</text>
  </view>

  <text class="eyebrow">Private Dream Archive</text>
  <text class="title">你的梦境档案</text>
  <view wx:if="{{symbolFilter}}" class="filter-banner">
    <text>只看含有「{{symbolFilter}}」的梦</text>
    <text class="filter-clear" bindtap="clearFilter">清除筛选</text>
  </view>
  <text wx:if="{{hasArchive}}" class="deck-count">已记下 {{archiveCount}} 个梦</text>

  <view wx:if="{{!hasArchive}}" class="empty">
    <text>还没有记录。从刚醒来时记得的一个画面开始。</text>
  </view>

  <view wx:else class="archive-list">
    <button wx:for="{{archive}}" wx:key="id" class="archive-item" data-index="{{index}}" bindtap="openDream">
      <view class="mini-card-mark">
        <text>{{item.result ? item.result.card_no : '原梦'}}</text>
      </view>
      <view>
        <text class="archive-title">{{item.result ? item.result.title : '已保存，尚未解读'}}</text>
        <text class="archive-weather">{{item.result ? item.result.emotional_weather : item.dreamText}}</text>
        <text wx:if="{{item.result && item.result.symbols}}" class="archive-copy">{{item.result.symbols[0]}} / {{item.result.symbols[1]}} / {{item.result.symbols[2]}}</text>
      </view>
      <text class="archive-date">{{item.dateLabel}}</text>
    </button>
  </view>

  <button class="primary-button" bindtap="newDream">记下新的梦</button>
</view>
