<view class="screen">
  <!-- 设计稿 4a「牌组翻阅」去掉了 ONEIRO/ARCHIVE 品牌行与 Private Dream Archive
       英文眉，改成单行中文标题 + 计数，标题与计数 baseline 对齐、两端对齐 -->
  <view class="archive-header">
    <text class="archive-header-title">你的私人梦境牌组</text>
    <text class="archive-header-count">{{archiveCount}} 个梦</text>
  </view>

  <view wx:if="{{symbolFilter}}" class="filter-banner">
    <text>只看含有「{{symbolFilter}}」的梦</text>
    <text class="filter-clear" bindtap="clearFilter">清除筛选</text>
  </view>

  <!-- 月度观察：一个月一张，左右滑动翻阅。以前这里只有当月一张死卡，
       正因为「数据上只有一张」才刻意不做翻页——现在 buildMonthlyCards
       按月产出，滑动是真的有东西可滑。
       外层两层旋转偏移的纸色底卡（.deck-shadow）垫出「一叠牌」的厚度感。
       滑动会联动上方刻度轴和下方牌组，见 onObservationChange。 -->
  <view wx:if="{{monthlyCards.length}}" class="month-observation-deck">
    <view class="deck-shadow deck-shadow-2"></view>
    <view class="deck-shadow deck-shadow-1"></view>
    <swiper
      class="month-observation-swiper"
      current="{{activeMonthIndex}}"
      bindchange="onObservationChange"
      duration="320"
    >
      <swiper-item wx:for="{{monthlyCards}}" wx:for-item="card" wx:key="month">
        <view class="month-observation">
          <view class="mo-top">
            <view class="mo-top-left">
              <text class="mo-eyebrow">月度观察</text>
              <text class="mo-meta">{{card.monthLabel}} · {{card.dreamCount}} 个梦</text>
            </view>
            <view class="mo-badge">
              <view class="mo-badge-dot"></view>
            </view>
          </view>

          <view class="mo-divider"></view>

          <text class="mo-copy">{{card.insight}}</text>
          <!-- 重复线索只挂在当前这张卡上：它讲的是「拉长时间看还有什么反复
               出现」，是跨月的信号，挂在每一张月卡上会变成一句复读。 -->
          <text wx:if="{{card.month === insights.monthlyCard.month && insights.recurringNote}}" class="mo-recurring-note">{{insights.recurringNote}}</text>

          <view wx:if="{{card.hasEmotion}}" class="mo-bottom">
            <text class="mo-bottom-left">情绪基调 · {{card.emotion}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view wx:if="{{archiveLoadError}}" class="empty archive-load-error" bindtap="retryArchiveLoad">
    <text>暂时无法读取云端档案，点击重试</text>
  </view>

  <view wx:elif="{{!hasArchive}}" class="empty">
    <text>还没有记录。从刚醒来时记得的一个画面开始。</text>
  </view>

  <!-- 一次只显示一个月：切月份时页面完全不动，只有下面的牌组换一批。
       所以这里没有「滚到某个月」这回事——也就没有滚动位置这个第三方输入
       来跟卡片/刻度抢「当前是几月」，联动只剩 activeMonthIndex 一个真相。

       月内只放真的有梦的那天，不留空白格占位（看起来像加载出错）。缩略卡
       保持竖长比例（3:4）避免裁切不到位，日期叠在图片顶部（放顶部是为了不
       跟未解读占位卡底部的卡号文字打架）。一天多梦用叠层视觉示意。

       .month-scrubber 是一条横向月份刻度轴（左旧右新），两侧的淡色刻度就是
       「这个月前后还有多少个月」的实感。月份本身由上面的观察卡显示，这里
       不再重复一个日期牌。 -->
  <view wx:else class="calendar-list">
    <!-- 中心即选中：最高最深的那根刻度永远在屏幕正中，左右拖动是把不同的
         月份「送进」这个中心槽。所以「当前是几月」完全由滚动位置决定，
         是一个算出来的唯一结果，不存在两处各说各话。 -->
    <view class="month-scrubber">
      <view class="month-scrubber-slot"></view>
      <scroll-view
        class="month-scrubber-track"
        scroll-x="{{true}}"
        scroll-left="{{stripScrollLeft}}"
        scroll-with-animation="{{stripAnimated}}"
        enhanced="{{true}}"
        show-scrollbar="{{false}}"
        bindscroll="onStripScroll"
      >
        <view class="month-scrubber-inner">
          <view
            wx:for="{{monthStrip}}"
            wx:key="key"
            class="month-tick {{item.active ? 'is-active' : ''}}"
            data-key="{{item.key}}"
            bindtap="jumpToMonth"
          >
            <view class="month-tick-bar"></view>
            <text class="month-tick-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{activeMonthGroup}}" class="calendar-month">
      <view class="calendar-month-row">
        <view
          wx:for="{{activeMonthGroup.cells}}"
          wx:for-item="cell"
          wx:key="key"
          class="calendar-cell"
          data-day-key="{{cell.key}}"
          data-month-key="{{cell.monthKey}}"
          bindtap="expandDay"
        >
          <view class="calendar-card">
            <view wx:if="{{cell.multi}}" class="calendar-deck-shadow calendar-deck-shadow-2"></view>
            <view wx:if="{{cell.multi}}" class="calendar-deck-shadow calendar-deck-shadow-1"></view>
            <view class="calendar-card-thumb theme-{{cell.dreams[0].themeClass}}">
              <image wx:if="{{cell.dreams[0].thumbnailPath}}" class="calendar-card-image" src="{{cell.dreams[0].thumbnailPath}}" mode="aspectFill"></image>
              <view wx:else class="calendar-card-placeholder">
                <text>{{cell.dreams[0].result ? cell.dreams[0].result.card_no : '原梦'}}</text>
              </view>
              <view class="calendar-card-scrim"></view>
              <text class="calendar-card-daylabel">{{cell.day}} <text class="calendar-card-weekday">{{cell.weekdayLabel}}</text></text>
            </view>
            <text wx:if="{{cell.multi}}" class="calendar-card-count">{{cell.dreams.length}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 点某天梦卡 → 原地放大：多梦的天用 swiper 原生滑动切换相邻梦卡，
       再点一下放大的卡片进完整详情页（复用 openDream），点空白区域收回。 -->
  <view wx:if="{{expandedDayKey}}" class="calendar-expand-overlay" bindtap="collapseDay">
    <view class="calendar-expand-panel" catchtap="stopPropagation">
      <swiper class="calendar-expand-swiper" current="{{expandedDreamIndex}}" bindchange="onExpandSwiperChange">
        <swiper-item wx:for="{{expandedDreams}}" wx:for-item="dream" wx:key="id">
          <!-- 排版按「一张裱好的牌」来组织：图居中并加一圈内衬边，文字整体
               也居中跟图共用一条中轴线（之前图居中、字左对齐，两条轴打架）。
               日期提到标题上方当眉标，情绪单独一行允许折行——原来挤在一行里
               被 .archive-meta 的 nowrap 截断，最有信息量的那半句永远看不到。
               底部提示用一条细分割线收口，整体垂直居中，不再靠 margin-top
               把提示推到卡底、中间留一大块空白。 -->
          <button class="calendar-expand-card" data-index="{{dream.archiveIndex}}" bindtap="openDream">
            <view class="expand-stage">
              <view class="archive-thumb theme-{{dream.themeClass}}">
                <image wx:if="{{dream.thumbnailPath}}" class="archive-thumb-image" src="{{dream.thumbnailPath}}" mode="aspectFill"></image>
                <view wx:else class="archive-thumb-placeholder">
                  <text>{{dream.result ? dream.result.card_no : '原梦'}}</text>
                </view>
              </view>
            </view>
            <view class="expand-copy">
              <text class="expand-date">{{dream.timelineTimestamp}}</text>
              <text class="expand-title">{{dream.result ? dream.result.title : '已保存，尚未解读'}}</text>
              <text class="expand-weather">{{dream.result ? dream.result.emotional_weather : dream.dreamText}}</text>
              <text wx:if="{{dream.repeatLabel}}" class="expand-repeat">{{dream.repeatLabel}}</text>
            </view>
            <view class="expand-foot">
              <text class="expand-hint">再点一下查看完整详情 ›</text>
            </view>
          </button>
        </swiper-item>
      </swiper>
      <text wx:if="{{expandedDreams.length > 1}}" class="calendar-expand-counter">{{expandedDreamIndex + 1}} / {{expandedDreams.length}} · 左右滑动切换</text>
    </view>
  </view>

  <button class="primary-button" bindtap="newDream">记下新的梦</button>
</view>
