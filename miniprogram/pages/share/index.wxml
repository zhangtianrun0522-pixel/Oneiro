<view class="share-screen">
  <view wx:if="{{loading}}" class="share-state">
    <text class="share-state-title">正在打开梦卡</text>
  </view>

  <view wx:elif="{{errorState === 'not_found'}}" class="share-state">
    <text class="share-state-title">这张梦卡的分享链接已失效</text>
    <button class="primary-button" bindtap="startDream">记下我的梦</button>
  </view>

  <view wx:elif="{{errorState === 'unavailable'}}" class="share-state">
    <text class="share-state-title">暂时无法加载，请检查网络</text>
    <button class="primary-button" bindtap="loadShareCard">重试</button>
  </view>

  <view wx:else class="shared-card">
    <view class="card-header">
      <text>ONEIRO</text>
      <text>{{payload.cardNo}}</text>
    </view>

    <view class="dream-art theme-{{payload.cardTheme}}">
      <view class="moon"></view>
      <view class="water"></view>
      <view class="key"></view>
      <view class="bird"></view>
    </view>

    <text class="card-title">{{payload.title}}</text>
    <text class="profile-summary">{{payload.profileSummary}}</text>
    <text class="weather">{{payload.emotionalWeather}}</text>

    <view class="symbols">
      <text wx:for="{{payload.symbols}}" wx:key="*this" class="symbol">{{item}}</text>
    </view>

    <view class="ritual">
      <text class="ritual-label">TODAY'S OMEN</text>
      <text class="ritual-text">{{payload.cardInsight}}</text>
    </view>

  </view>

  <button wx:if="{{!loading && !errorState}}" class="primary-button" bindtap="startDream">记下我的梦</button>
</view>
