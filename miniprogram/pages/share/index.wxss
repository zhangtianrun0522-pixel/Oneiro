.share-screen {
  min-height: 100vh;
  padding: 48rpx 44rpx 64rpx;
  background: var(--paper);
}

.shared-card {
  position: relative;
  padding: 48rpx 38rpx 44rpx;
  border-radius: 22rpx;
  background: var(--paper-raised);
  color: var(--ink);
  box-shadow: 0 44rpx 140rpx rgba(33, 29, 23, 0.16);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 8rpx;
}

/* 卡片内的梦象图形是装饰艺术（AI 出图或 CSS 兜底图案），保持深色渐变，
   与页面纸色主题无关，同 result 页 .dream-art 的处理一致 */
.dream-art {
  position: relative;
  height: 460rpx;
  margin: 42rpx 0 38rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #18202a 0%, #68737c 58%, #e4e4dc 100%);
}

.dream-art.theme-tide {
  background: linear-gradient(145deg, #102832 0%, #356f78 58%, #d5e8df 100%);
}

.dream-art.theme-threshold {
  background: linear-gradient(145deg, #1c2130 0%, #73634a 58%, #ead9aa 100%);
}

.dream-art.theme-shadow {
  background: linear-gradient(145deg, #0d0f16 0%, #273049 56%, #a8b2c3 100%);
}

.dream-art.theme-falling {
  background: linear-gradient(145deg, #191729 0%, #555070 58%, #ead0be 100%);
}

.dream-art.theme-archive {
  background: linear-gradient(145deg, #172033 0%, #5c6573 58%, #e0d8c4 100%);
}

.dream-art.theme-hearth {
  background: linear-gradient(145deg, #201819 0%, #755243 58%, #efd2a6 100%);
}

.dream-art.theme-moon {
  background: linear-gradient(145deg, #10182b 0%, #3e517a 56%, #dfe7f1 100%);
}

.moon {
  position: absolute;
  top: -18rpx;
  right: 72rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(246, 240, 209, 0.9);
}

.water {
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -38rpx;
  height: 214rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(196, 220, 231, 0.32);
}

.key {
  position: absolute;
  left: 286rpx;
  bottom: 128rpx;
  width: 100rpx;
  height: 44rpx;
  transform: rotate(-42deg);
  border-radius: 999rpx;
  background: #efe0a0;
}

.key::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: inherit;
}

.bird {
  position: absolute;
  right: 90rpx;
  top: 222rpx;
  width: 116rpx;
  height: 48rpx;
  border-radius: 100% 100% 0 0;
  transform: rotate(-16deg);
  background: rgba(247, 250, 252, 0.76);
}

/* 分享卡标题是这张卡最「结论性」的一句，切到宋体并升到 display 档，
   全页仅此一处大字 */
.card-title {
  display: block;
  text-align: center;
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--fs-display);
  font-weight: 600;
  letter-spacing: 18rpx;
}

.profile-summary {
  display: block;
  margin-top: var(--space-tight);
  text-align: center;
  color: rgba(33, 29, 23, 0.4);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.weather {
  display: block;
  margin: var(--space-tight) auto 0;
  width: 86%;
  text-align: center;
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

.symbols {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin: var(--space-group) 0;
}

.symbol {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.14);
  border-radius: 999rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
}

.ritual {
  margin-top: var(--space-tight);
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.1);
  border-radius: 24rpx;
  background: var(--paper);
  text-align: center;
}

/* share 页唯一的朱砂点睛：仪式感最强的「今日预兆」标签，前面落一枚印章方块 */
.ritual-label {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 900;
  letter-spacing: 8rpx;
}

.ritual-label::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  background: var(--cinnabar);
  vertical-align: middle;
}

.ritual-text {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 800;
  line-height: 1.55;
}

/* .meta-hint / .oracle-line：当前 wxml 未使用（历史遗留), 一并换成纸色
   token 只为消除深色主题残留，不影响任何实际渲染 */
.meta-hint {
  margin-top: var(--space-tight);
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--paper-raised);
  color: var(--ink-55);
  font-size: var(--fs-label);
  line-height: 1.65;
  text-align: center;
}

.oracle-line {
  margin-top: var(--space-group);
  padding: 34rpx 30rpx;
  border-left: 4rpx solid rgba(184, 134, 59, 0.34);
  color: var(--ink-70);
  font-size: var(--fs-body);
  font-weight: 500;
  line-height: 1.8;
}
