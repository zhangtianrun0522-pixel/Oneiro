.share-screen {
  min-height: 100vh;
  padding: 48rpx 44rpx 64rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(159, 183, 201, 0.16), transparent 36%),
    #050609;
}

.shared-card {
  padding: 48rpx 38rpx 44rpx;
  border-radius: 22rpx;
  background: #fdfaf5;
  color: #172033;
  box-shadow: 0 44rpx 140rpx rgba(0, 0, 0, 0.42);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(23, 32, 51, 0.26);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.dream-art {
  position: relative;
  height: 460rpx;
  margin: 42rpx 0 38rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #18202a 0%, #68737c 58%, #e4e4dc 100%);
}

.dream-art.theme-tide {
  background: linear-gradient(145deg, #102832 0%, #356f78 58%, #d5e8df 100%);
}

.dream-art.theme-threshold {
  background: linear-gradient(145deg, #1c2130 0%, #73634a 58%, #ead9aa 100%);
}

.dream-art.theme-shadow {
  background: linear-gradient(145deg, #0d0f16 0%, #273049 56%, #a8b2c3 100%);
}

.dream-art.theme-falling {
  background: linear-gradient(145deg, #191729 0%, #555070 58%, #ead0be 100%);
}

.dream-art.theme-archive {
  background: linear-gradient(145deg, #172033 0%, #5c6573 58%, #e0d8c4 100%);
}

.dream-art.theme-hearth {
  background: linear-gradient(145deg, #201819 0%, #755243 58%, #efd2a6 100%);
}

.dream-art.theme-moon {
  background: linear-gradient(145deg, #10182b 0%, #3e517a 56%, #dfe7f1 100%);
}

.moon {
  position: absolute;
  top: -18rpx;
  right: 72rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(246, 240, 209, 0.9);
}

.water {
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -38rpx;
  height: 214rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(196, 220, 231, 0.32);
}

.key {
  position: absolute;
  left: 286rpx;
  bottom: 128rpx;
  width: 100rpx;
  height: 44rpx;
  transform: rotate(-42deg);
  border-radius: 999rpx;
  background: #efe0a0;
}

.key::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: inherit;
}

.bird {
  position: absolute;
  right: 90rpx;
  top: 222rpx;
  width: 116rpx;
  height: 48rpx;
  border-radius: 100% 100% 0 0;
  transform: rotate(-16deg);
  background: rgba(247, 250, 252, 0.76);
}

.card-title {
  display: block;
  text-align: center;
  color: #172033;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 18rpx;
}

.profile-summary {
  display: block;
  margin-top: 18rpx;
  text-align: center;
  color: rgba(23, 32, 51, 0.32);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.weather {
  display: block;
  margin: 18rpx auto 0;
  width: 86%;
  text-align: center;
  color: rgba(23, 32, 51, 0.54);
  font-size: 24rpx;
  line-height: 1.8;
}

.symbols {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin: 28rpx 0;
}

.symbol {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(23, 32, 51, 0.08);
  border-radius: 999rpx;
  color: rgba(23, 32, 51, 0.56);
  font-size: 20rpx;
  font-weight: 700;
}

.ritual {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(23, 32, 51, 0.06);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
  text-align: center;
}

.ritual-label {
  display: block;
  color: rgba(23, 32, 51, 0.2);
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
}

.ritual-text {
  display: block;
  margin-top: 12rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.55;
}

.meta-hint {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(159, 183, 201, 0.14);
  color: rgba(23, 32, 51, 0.52);
  font-size: 21rpx;
  line-height: 1.65;
  text-align: center;
}

.oracle-line {
  margin-top: 34rpx;
  padding: 34rpx 30rpx;
  border-left: 4rpx solid rgba(159, 183, 201, 0.34);
  color: rgba(255, 255, 255, 0.68);
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.8;
}
