<view wx:if="{{entryReady}}" class="result-screen">
  <!-- 示例必须在第一屏就自报家门。一份读起来像「系统已经很懂你」的解读，如果
       用户过几秒才发现说的不是自己，那不是惊喜，是被骗了一下。 -->
  <view wx:if="{{sampleMode}}" class="sample-banner">
    <text class="sample-banner-label">示例</text>
    <text class="sample-banner-copy">这是一个虚构的梦，用来看清解读会给出什么。它不会存进你的档案。</text>
  </view>

  <block wx:if="{{!interpretationUnavailable}}">
    <view class="dream-card-stage">
      <view class="dream-card-switcher" bindtap="toggleDreamCard">
        <view wx:if="{{!cardFlipped}}" class="dream-card-face dream-card-front card-face-fade">
          <view class="dream-art theme-{{dream.result.card_theme}} {{aiImageLocalPath || dream.result.imageUrl ? 'has-ai-image' : ''}}">
            <image
              wx:if="{{aiImageLocalPath || dream.result.imageUrl}}"
              class="dream-ai-image"
              src="{{aiImageLocalPath || dream.result.imageUrl}}"
              mode="aspectFill"
            ></image>
            <view class="moon"></view>
            <view class="shelf shelf-a"></view>
            <view class="shelf shelf-b"></view>
            <view class="water"></view>
            <view class="key"></view>
            <view class="bird"></view>
            <view wx:if="{{!cardFlipped}}" class="front-meta">
              <text class="front-brand">ONEIRO</text>
              <view class="front-record">
                <text>{{dream.result.card_no}}</text>
                <text>{{displayTimestamp}}</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:else class="dream-card-face dream-card-back card-face-fade">
          <text class="back-title">{{dream.result.title}}</text>
          <text class="back-insight">{{cardBackInsight}}</text>
          <view class="back-divider"><view></view></view>
          <text class="back-label">梦中线索</text>
          <view class="back-symbols">
            <text wx:for="{{dream.result.symbols}}" wx:key="*this">{{item}}</text>
          </view>
          <text wx:if="{{dream.result.integration_question}}" class="back-question">{{dream.result.integration_question}}</text>
        </view>
      </view>
    </view>
    <text class="card-flip-hint">{{cardFlipped ? '轻触返回画面' : '轻触查看卡背'}}</text>
    <view wx:if="{{imageStatus === 'generating'}}" class="card-image-notice">
      <text>完整画面生成中，可先阅读解读</text>
    </view>
    <view wx:if="{{imageStatus === 'ready' && (imageQualityStatus === 'queued' || imageQualityStatus === 'polling')}}" class="card-image-notice">
      <text>快速梦卡已就绪，高清画面后台优化中</text>
    </view>
    <view wx:if="{{imageQualityStatus === 'ready'}}" class="card-image-notice quality-ready-notice">
      <text>高清画面已更新</text>
    </view>
    <view wx:if="{{imageStatus === 'failed'}}" class="card-image-notice">
      <text>{{imageErrorMessage || '当前展示基础梦象'}}</text>
      <button class="image-retry" bindtap="retryDreamImage">重新生成画面</button>
    </view>

    <view wx:if="{{dream.result.symbol_milestones && dream.result.symbol_milestones[0]}}" class="milestone-pill" bindtap="openMilestoneArchive">
      <text class="milestone-copy">{{dream.result.symbol_milestones[0].symbol}} · 第 {{dream.result.symbol_milestones[0].count}} 次出现在你的梦里</text>
      <text class="milestone-edit" catchtap="correctMilestoneSymbol">纠正</text>
    </view>
  </block>

  <view class="reading grounded-reading">
    <!-- 第一层：一句核心观察 -->
    <text class="section-title">这个梦的观察</text>
    <text wx:if="{{!interpretationUnavailable}}" class="core-observation">{{dream.result.reading_hook}}</text>

    <!-- 原梦是用户自己刚写完的东西，不是他打开这一页想读的内容。梦写得越长，
         把全文顶在解读前面越是把真正的结果推下屏幕。所以长文默认只留第一行，
         需要核对时再展开——短梦（一行以内）不折叠，多一个「展开」反而是噪音。 -->
    <view class="original-dream">
      <view class="original-head" bindtap="toggleOriginalDream">
        <text class="reading-label-neutral">你记下的原梦</text>
        <text wx:if="{{dreamTextCollapsible}}" class="original-toggle">{{dreamTextExpanded ? '收起 ↑' : '展开全文 ↓'}}</text>
      </view>
      <text class="original-copy {{dreamTextCollapsible && !dreamTextExpanded ? 'is-collapsed' : ''}}">{{dream.dreamText}}</text>
    </view>

    <!-- 未生成解读时直接说明，不藏在折叠里 -->
    <view wx:if="{{interpretationUnavailable}}" class="reading-block">
      <text wx:if="{{quotaBlocked}}" class="reading-copy">这个梦已经完整保存下来了，只是今天的解读次数已经用完。明天回来，它还在这里等着被解读。</text>
      <text wx:else class="reading-copy">本次未生成解读，原梦仍已保存。语义识别只由云端大模型完成，不使用本地关键词替代。</text>
      <block wx:if="{{!quotaBlocked}}">
        <text wx:if="{{interpretationErrorCode}}" class="reading-diagnostic">诊断码 {{interpretationErrorCode}}<block wx:if="{{interpretationDiagnostics && interpretationDiagnostics.elapsedMs}}"> · {{interpretationDiagnostics.elapsedMs}}ms</block></text>
        <text wx:if="{{interpretationDiagnostics && interpretationDiagnostics.providerError}}" class="reading-diagnostic">{{interpretationDiagnostics.providerError}}</text>
      </block>
      <button class="image-retry" loading="{{retryingInterpretation}}" disabled="{{retryingInterpretation}}" bindtap="retryInterpretation">{{quotaBlocked ? '试试现在解读' : '重新解读'}}</button>
    </view>

    <!-- 第二层按「可核对性」排序：用户能当场核对的排前面，对谁都成立的降到
         折叠里。「你之前提到过」引的是用户自己确认过的原话，可核对性最高，
         有就置顶；文化象征对每个做同样梦的人都一样，因此下移。
         这里同时决定了记忆呼应能否被看见——prompt 要求它落在 underneath 或
         possible_connections，两处现在都在折叠外，不再是抛硬币。 -->
    <block wx:if="{{!interpretationUnavailable}}">
      <view wx:if="{{dream.result.referenced_life_note}}" class="reading-block life-note-reading">
        <text class="reading-label">你之前提到过</text>
        <text class="reading-copy">"{{dream.result.referenced_life_note.text}}"</text>
        <view class="life-note-footer" bindtap="openLifeNoteSource">
          <text class="life-note-date">{{dream.result.referenced_life_note.sourceDate}}</text>
          <text class="life-note-link">为什么这样理解？</text>
        </view>
      </view>

      <view wx:if="{{dream.result.underneath}}" class="reading-block psychological-reading">
        <text class="reading-label">心理视角</text>
        <text class="reading-copy">{{dream.result.underneath}}</text>
      </view>

      <!-- 唯一真正碰到用户现实的模块。零关联要说得出口：主动说这次没找到，
           比每次都硬找一个更能让人相信找到的那次。 -->
      <view class="reading-block">
        <text class="reading-label">与你有关</text>
        <block wx:if="{{possibleConnections.length}}">
          <view class="connection-list">
            <!-- 每条呼应挂着它自己的两个出口，而不是整块共用一组按钮：模型一次
                 可以给出三条，共用一组就问不清用户在说哪一条，收到的表态也就
                 无法上行成任何证据。判断必须贴着被判断的那句话。 -->
            <view wx:for="{{possibleConnections}}" wx:key="text" class="connection-entry">
              <text class="connection-item">{{item.text}}</text>
              <view class="connection-verdicts">
                <view
                  class="connection-verdict {{item.verdict === 'confirmed' ? 'is-chosen' : ''}}"
                  data-index="{{index}}"
                  data-verdict="confirmed"
                  bindtap="onConnectionVerdict"
                >是这样</view>
                <view
                  class="connection-verdict {{item.verdict === 'rejected' ? 'is-chosen' : ''}}"
                  data-index="{{index}}"
                  data-verdict="rejected"
                  bindtap="onConnectionVerdict"
                >不太像</view>
              </view>
              <!-- 表态之后必须看得见它去了哪里。不回话的按钮，用户点第二次就
                   不点了；而这两条路径去向不同，说法也不能含糊成一句「已记录」。 -->
              <text wx:if="{{item.verdict === 'confirmed'}}" class="connection-verdict-note">这条会作为背景，进入之后对你的理解。</text>
              <text wx:elif="{{item.verdict === 'rejected'}}" class="connection-verdict-note">那就在下面聊聊，说说实际是怎么回事。</text>
            </view>
          </view>
          <text class="reading-boundary">这是一种理解角度，你可以保留、修正或否定它。</text>
        </block>
        <text wx:else class="reading-copy">这次没有找到和你生活的具体呼应。梦不一定每次都指向什么。</text>
      </view>

      <view wx:if="{{metaphysicalEntryVisible && !metaphysicalReadingReady}}" class="reading-block metaphysical-reading">
        <view class="metaphysical-heading">
          <text class="reading-label">命理视角</text>
          <text class="metaphysical-caption">出生节律</text>
        </view>
        <text class="metaphysical-copy">{{metaphysicalReadingError || '想换一个角度看这个梦吗'}}</text>
        <button
          class="image-retry"
          loading="{{metaphysicalReadingLoading}}"
          disabled="{{metaphysicalReadingLoading}}"
          bindtap="openMetaphysicalReading"
        >{{metaphysicalProfileMissing ? '去资料页补充出生信息' : '从出生节律再看一次'}}</button>
      </view>

      <view wx:if="{{dream.result.metaphysical_resonance || (dream.result.metaphysical_reading && (dream.result.metaphysical_reading.temperament || dream.result.metaphysical_reading.dream_echo || dream.result.metaphysical_reading.tension || dream.result.metaphysical_reading.rhythm))}}" class="reading-block metaphysical-reading">
        <view class="metaphysical-heading">
          <text class="reading-label">命理视角</text>
          <text class="metaphysical-caption">出生节律</text>
        </view>
        <block wx:if="{{dream.result.metaphysical_reading}}">
          <view wx:if="{{dream.result.metaphysical_reading.temperament}}" class="metaphysical-subsection">
            <text class="metaphysical-subtitle">这次被调动的底色</text>
            <text class="metaphysical-copy">{{dream.result.metaphysical_reading.temperament}}</text>
          </view>
          <view wx:if="{{dream.result.metaphysical_reading.dream_echo}}" class="metaphysical-subsection">
            <text class="metaphysical-subtitle">与这个梦的呼应</text>
            <text class="metaphysical-copy">{{dream.result.metaphysical_reading.dream_echo}}</text>
          </view>
          <view wx:if="{{dream.result.metaphysical_reading.tension}}" class="metaphysical-subsection">
            <text class="metaphysical-subtitle">梦里的拉扯</text>
            <text class="metaphysical-copy">{{dream.result.metaphysical_reading.tension}}</text>
          </view>
          <view wx:if="{{dream.result.metaphysical_reading.rhythm}}" class="metaphysical-subsection metaphysical-rhythm">
            <text class="metaphysical-subtitle">当下的节奏</text>
            <text class="metaphysical-copy">{{dream.result.metaphysical_reading.rhythm}}</text>
          </view>
        </block>
        <text wx:if="{{dream.result.metaphysical_resonance}}" class="metaphysical-resonance">{{dream.result.metaphysical_resonance}}</text>
      </view>
    </block>

    <!-- 第三层：可选的补充阅读，默认收起。名字必须诚实——叫「完整解读」会
         暗示正片在里面，既贬低了外面，又保证打开后失望（里面开场是用户自己
         刚写的梦的复述）。 -->
    <view wx:if="{{!interpretationUnavailable}}" class="tier-toggle" bindtap="toggleFullReading">
      <text class="tier-toggle-label">再多看一点</text>
      <text class="tier-toggle-icon">{{showFullReading ? '收起 ↑' : '展开 ↓'}}</text>
    </view>

    <view wx:if="{{showFullReading && !interpretationUnavailable}}" class="tier-full">
      <view class="reading-block">
        <text class="reading-label-neutral">梦里发生了什么</text>
        <text class="reading-copy">{{dream.result.dream_translation}}</text>
      </view>

      <view wx:if="{{dream.result.cultural_symbolism}}" class="reading-block cultural-reading">
        <text class="reading-label-neutral">传统解梦怎么说</text>
        <text class="reading-copy">{{dream.result.cultural_symbolism}}</text>
        <text class="reading-boundary">这是传统解梦里的讲法，不是对你的判断。</text>
      </view>
    </view>

    <!-- 「今天的小行动」不藏在完整解读折叠里，设计稿把它放在折叠区之后、
         始终可见 -->
    <view wx:if="{{dream.result.one_small_act && !interpretationUnavailable}}" class="today-act">
      <text class="reading-label">今天的小行动</text>
      <text class="reading-copy">{{dream.result.one_small_act}}</text>
    </view>

    <view wx:if="{{!interpretationUnavailable && dream.status === 'ready' && !sampleMode}}" class="dream-feedback">
      <text class="feedback-question">这份解读，贴合你吗</text>
      <view class="feedback-chips">
        <button wx:for="{{feedbackOptions}}" wx:key="value" class="feedback-chip {{feedback === item.value ? 'is-selected' : ''}}" data-feedback="{{item.value}}" bindtap="chooseDreamFeedback">{{item.label}}</button>
      </view>
    </view>
  </view>

  <!-- 「未同步，稍后自动重试」反复出现却不说为什么，用户只能一直看着它。
       云函数其实每次都返回了失败原因，这里必须显示出来，否则无从排查。 -->
  <view wx:if="{{cloudSyncPending && !sampleMode}}" class="cloud-sync-notice">
    <view class="cloud-sync-copy">
      <text>{{cloudRepairing ? '云端同步中' : (qualitySyncPending ? '高清图待同步' : '未同步，稍后自动重试')}}</text>
      <text wx:if="{{cloudSyncReason && !cloudRepairing}}" class="cloud-sync-reason">{{cloudSyncReason}}</text>
    </view>
    <button wx:if="{{!cloudRepairing}}" class="image-retry" bindtap="retryCloudSync">重试同步</button>
  </view>

  <!-- 聊聊这个梦：放在阅读内容结束之后、操作栏（收藏/分享/删除）之前，
       做成一个独立可点卡片（浅底色块 + 细边框 + 明确箭头），比普通文字链更
       醒目，避免被忽略；不做成朱砂实心按钮，保持暖纸/深墨的克制调性 -->
  <!-- 被否定的呼应压过解读评价：前者指向一句具体的、用户刚刚亲手划掉的话，
       后者只是对整份解读的粗评。有更具体的东西可聊时，不该从粗评开始。 -->
  <view wx:if="{{!interpretationUnavailable && !sampleMode}}" class="dream-chat-entry {{connectionToCorrect || feedback === 'too_generic' || feedback === 'too_mystical' || feedback === 'not_grounded' ? 'has-feedback' : ''}}" bindtap="openDreamChat">
    <view class="chat-entry-copy">
      <text class="reading-label">{{connectionToCorrect ? '说说那条哪里不对' : feedback === 'too_generic' ? '从被忽略的画面聊起' : feedback === 'too_mystical' ? '只说梦里实际发生的事' : feedback === 'not_grounded' ? '从醒来后的现实联想聊起' : '聊聊这个梦'}}</text>
      <text class="chat-entry-question">{{connectionToCorrect ? '把实际的情况讲给我听，我重新理解' : feedback ? '把你的感受说具体一点' : dream.result.integration_question}}</text>
    </view>
    <view class="chat-entry-arrow-badge">
      <text class="chat-entry-arrow">→</text>
    </view>
  </view>

  <!-- 底部操作：设计稿是一行三个平级文字链（收藏 / 分享 / 删除），
       不再用实心主按钮。「保存完整解读」「再记一个梦」「梦境档案」
       设计稿没有画，收进下面一个克制的「更多」折叠，不与这一行抢视觉权重。
       未生成解读时只保留删除入口。收藏/分享前面的圆圈与斜箭头图标改用
       CSS 绘制（border/transform），不再用 Unicode 字符 ◌ ↗——真机上
       iOS 会把 ↗ 渲染成彩色 emoji、◌ 渲染成不一致的字形，字宽/基线/字重
       都跟中文文本对不齐，把这一行的间距顶得不均匀。 -->
  <!-- 示例梦没有可收藏、可分享、可删除的东西：这些按钮作用在一条不存在的记录
       上，只会让人以为自己已经有了一个梦。这里换成唯一有意义的下一步。 -->
  <view wx:if="{{sampleMode}}" class="sample-cta">
    <text class="sample-cta-copy">你的解读会长成这样，但内容只来自你自己的梦。</text>
    <button class="sample-cta-button" bindtap="leaveSample">记下我的第一个梦</button>
  </view>

  <block wx:if="{{!sampleMode}}">
  <view class="primary-actions">
    <button wx:if="{{!interpretationUnavailable}}" class="primary-action-link" bindtap="saveCard"><text class="action-icon icon-save"></text>{{cardSaved ? '已收藏梦卡' : '收藏梦卡'}}</button>
    <button wx:if="{{!interpretationUnavailable && !sharePath}}" class="primary-action-link" loading="{{sharePreparing}}" disabled="{{sharePreparing}}" bindtap="prepareShareCard"><text class="action-icon icon-share"></text>分享梦卡</button>
    <button wx:if="{{!interpretationUnavailable && sharePath}}" class="primary-action-link" open-type="share"><text class="action-icon icon-share"></text>分享梦卡</button>
    <button class="primary-action-link primary-action-delete" bindtap="deleteDream">删除梦境</button>
  </view>

  <view class="more-toggle" bindtap="toggleMoreActions">
    <text class="more-toggle-label">更多</text>
    <text class="more-toggle-icon {{showMoreActions ? 'is-open' : ''}}">⌄</text>
  </view>

  <view wx:if="{{showMoreActions}}" class="more-actions">
    <button wx:if="{{!interpretationUnavailable}}" class="text-button" bindtap="saveFullReading">保存完整解读</button>
    <button class="text-button" bindtap="newDream">再记一个梦</button>
    <button class="text-button" bindtap="openArchive">梦境档案</button>
  </view>
  </block>

  <text wx:if="{{shareImagePath}}" class="share-ready">梦卡图已准备，可保存或分享</text>
  <canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>
</view>
