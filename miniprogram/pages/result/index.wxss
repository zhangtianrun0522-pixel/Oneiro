.result-screen {
  min-height: 100vh;
  padding: 36rpx 40rpx 84rpx;
  background: var(--paper);
}

.dream-card-switcher {
  position: relative;
  width: 100%;
  height: 100%;
}

.dream-card-stage { height: 840rpx; }

.dream-card-face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 4rpx;
  box-shadow: 0 24rpx 56rpx rgba(33, 29, 23, 0.14);
}

.dream-card-front {
  background: #0a0c10;
}

/* 卡背：稳定的纵向结构，不再用绝对定位。
   标题 → 核心观察 → 分隔线 → 梦中线索 → 留给用户的问题。
   内容短时问题被 margin-top:auto 推到底部，内容长时自然向下增长并内部滚动。
   （旧实现把 .back-question 设成 absolute + bottom，曾经与「统一改 relative」
     的写法叠加导致 bottom 变成"上移一截"，把问题压在梦中线索上；现在的
     .back-question 不再声明 left/right/bottom，只靠 flex + margin-top:auto
     定位，彻底避免这个坑。） */
.dream-card-back {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 44rpx 38rpx;
  overflow-y: auto;
  background-color: #211d17;
  background-image: repeating-linear-gradient(135deg, rgba(184, 134, 59, 0.06) 0, rgba(184, 134, 59, 0.06) 1rpx, transparent 1rpx, transparent 13rpx);
  color: #f2ecdf;
}

.dream-card-back::before { position: absolute; inset: 16rpx; border: 1rpx solid rgba(184, 134, 59, 0.32); content: ''; pointer-events: none; }

.card-face-fade {
  animation: card-face-fade-in 180ms ease-out both;
}

@keyframes card-face-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.front-meta {
  position: absolute;
  z-index: 5;
  left: 34rpx;
  right: 34rpx;
  top: 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

/* 卡片「正面」始终是深色艺术图（AI 出图或 CSS 兜底梦象），与页面纸色主题
   无关，因此这里的白字是刻意保留的前景对比色，不随暖纸化改动 */
.front-meta {
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 10rpx rgba(5, 6, 9, 0.72);
}

.front-record {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  letter-spacing: 2rpx;
}

.front-brand {
  letter-spacing: 7rpx;
}

.back-title,
.back-insight,
.back-label,
.back-symbols,
.back-question {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  text-align: center;
}

/* 与 .back-question 各取一个 auto，剩余空间在"上方留白"和"问题之前"平均分配，
   避免上半拥挤、下半一大片空的失衡 */
.back-title {
  display: block;
  margin-top: auto;
  padding-top: 20rpx;
  color: #f2ecdf;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.back-insight {
  display: block;
  margin-top: 24rpx;
  color: rgba(242, 236, 223, 0.78);
  font-size: 26rpx;
  line-height: 1.75;
}

.back-divider {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.back-divider::before,
.back-divider::after {
  flex: 1;
  height: 1rpx;
  background: rgba(184, 134, 59, 0.34);
  content: '';
}

.back-divider::after {
  width: auto;
  margin-left: 0;
}

.back-divider > view {
  width: 9rpx;
  height: 9rpx;
  margin: 0 18rpx;
  flex: 0 0 9rpx;
  transform: rotate(45deg);
  background: var(--gold-line);
}

.back-label {
  display: block;
  margin-top: 28rpx;
  color: #d2a459;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

/* margin-bottom 保证内容再长也有呼吸区（flex 子项之间外边距不合并） */
.back-symbols {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  margin-bottom: 34rpx;
  color: rgba(242, 236, 223, 0.9);
  font-size: var(--fs-aux);
}

.back-symbols text {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.4);
}

.back-symbols text:not(:last-child)::after {
  display: none;
}

.back-question {
  margin-top: auto;          /* 有余量时贴底，内容长时自然接在线索之后 */
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(184, 134, 59, 0.24);
  color: rgba(242, 236, 223, 0.74);
  font-size: var(--fs-aux);
  font-style: italic;
  line-height: 1.7;
}

.card-flip-hint {
  display: block;
  margin: 24rpx 0 0;
  text-align: center;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
}

/* 顶部压一层由深到透的渐变，保证 .front-meta 的白字在任何底图
   （AI 出图或 CSS 兜底梦象）上都有足够对比度 */
.dream-art::before {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  height: 168rpx;
  background: linear-gradient(180deg, rgba(5, 6, 9, 0.58), rgba(5, 6, 9, 0));
  content: '';
  pointer-events: none;
}

.dream-art {
  position: relative;
  height: 100%;
  margin: 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #172438 0%, #425d72 62%, #d8e7ef 100%);
}

.dream-ai-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.98;
  background: #172033;
  animation: dream-image-register 680ms cubic-bezier(0.22, 0.75, 0.24, 1) both;
}

@keyframes dream-image-register {
  0% {
    opacity: 0;
    transform: scale(1.018) translate(3rpx, -2rpx);
    filter: saturate(0.45) contrast(0.9);
  }
  55% {
    opacity: 0.86;
    transform: scale(1.006) translate(-2rpx, 1rpx);
    filter: saturate(1.18) contrast(1.04);
  }
  100% {
    opacity: 0.98;
    transform: scale(1) translate(0, 0);
    filter: saturate(1) contrast(1);
  }
}

.has-ai-image .moon,
.has-ai-image .shelf,
.has-ai-image .water,
.has-ai-image .key,
.has-ai-image .bird {
  display: none;
}

.card-image-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 18rpx 0 0;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
}

.image-retry {
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: 1.4;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.image-retry::after {
  border: 0;
}

.dream-art.theme-tide {
  background: linear-gradient(145deg, #102832 0%, #356f78 58%, #d5e8df 100%);
}

.dream-art.theme-threshold {
  background: linear-gradient(145deg, #1c2130 0%, #73634a 58%, #ead9aa 100%);
}

.dream-art.theme-shadow {
  background: linear-gradient(145deg, #0d0f16 0%, #273049 56%, #a8b2c3 100%);
}

.dream-art.theme-falling {
  background: linear-gradient(145deg, #191729 0%, #555070 58%, #ead0be 100%);
}

.dream-art.theme-archive {
  background: linear-gradient(145deg, #172033 0%, #5c6573 58%, #e0d8c4 100%);
}

.dream-art.theme-hearth {
  background: linear-gradient(145deg, #201819 0%, #755243 58%, #efd2a6 100%);
}

.dream-art.theme-moon {
  background: linear-gradient(145deg, #10182b 0%, #3e517a 56%, #dfe7f1 100%);
}

.dream-art.theme-mist {
  background: linear-gradient(145deg, #18202a 0%, #68737c 58%, #e4e4dc 100%);
}

/* 下移，避开顶部的 ONEIRO / 编号 / 时间戳条 —— 原本白字正好压在
   淡黄色月亮上，读不出来 */
.moon {
  position: absolute;
  top: 104rpx;
  right: 60rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(246, 240, 209, 0.9);
}

.theme-shadow .moon,
.theme-falling .moon {
  opacity: 0.58;
}

.theme-hearth .moon,
.theme-threshold .moon {
  background: rgba(249, 219, 152, 0.82);
}

.shelf {
  position: absolute;
  left: 92rpx;
  right: 92rpx;
  height: 330rpx;
  border-left: 6rpx solid rgba(216, 231, 239, 0.28);
  border-right: 6rpx solid rgba(216, 231, 239, 0.28);
}

.theme-tide .shelf {
  border-color: rgba(220, 242, 235, 0.2);
}

.theme-shadow .shelf {
  border-color: rgba(190, 204, 226, 0.18);
}

.theme-hearth .shelf,
.theme-threshold .shelf {
  border-color: rgba(255, 230, 180, 0.2);
}

.shelf::before,
.shelf::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(216, 231, 239, 0.22);
}

.theme-tide .shelf::before,
.theme-tide .shelf::after {
  background: rgba(220, 242, 235, 0.18);
}

.theme-shadow .shelf::before,
.theme-shadow .shelf::after {
  background: rgba(190, 204, 226, 0.16);
}

.theme-hearth .shelf::before,
.theme-hearth .shelf::after,
.theme-threshold .shelf::before,
.theme-threshold .shelf::after {
  background: rgba(255, 230, 180, 0.18);
}

.shelf::before {
  top: 110rpx;
}

.shelf::after {
  top: 220rpx;
}

.shelf-a {
  top: 118rpx;
}

.shelf-b {
  top: 118rpx;
  left: 260rpx;
}

.water {
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -38rpx;
  height: 214rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(196, 220, 231, 0.32);
}

.theme-tide .water {
  height: 250rpx;
  background: rgba(186, 228, 224, 0.42);
}

.theme-shadow .water {
  background: rgba(88, 104, 135, 0.28);
}

.theme-hearth .water {
  background: rgba(222, 156, 106, 0.24);
}

.theme-falling .water {
  bottom: -72rpx;
  height: 270rpx;
  background: rgba(230, 195, 190, 0.32);
}

.key {
  position: absolute;
  left: 286rpx;
  bottom: 138rpx;
  width: 100rpx;
  height: 44rpx;
  transform: rotate(-42deg);
  border-radius: 999rpx;
  background: #efe0a0;
}

.theme-shadow .key {
  background: #c3c8d7;
}

.theme-hearth .key,
.theme-threshold .key {
  background: #f1c979;
}

.theme-tide .key {
  background: #d7e8c9;
}

.key::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: #efe0a0;
}

.theme-shadow .key::after {
  background: #c3c8d7;
}

.theme-hearth .key::after,
.theme-threshold .key::after {
  background: #f1c979;
}

.theme-tide .key::after {
  background: #d7e8c9;
}

.bird {
  position: absolute;
  right: 90rpx;
  top: 252rpx;
  width: 116rpx;
  height: 48rpx;
  border-radius: 100% 100% 0 0;
  transform: rotate(-16deg);
  background: rgba(247, 250, 252, 0.76);
}

.theme-shadow .bird {
  background: rgba(184, 194, 214, 0.54);
}

.theme-hearth .bird,
.theme-threshold .bird {
  background: rgba(255, 236, 199, 0.64);
}

.reading,
.grounded-reading {
  margin-top: var(--space-block);
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.reading-block { margin-top: var(--space-group); }

.milestone-pill {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: var(--space-tight);
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.34);
  border-radius: 2rpx;
  background: var(--paper-raised);
}

.milestone-copy {
  flex: 1;
  min-width: 0;
  color: rgba(122, 84, 33, 0.8);
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.5;
}

.milestone-edit {
  flex: 0 0 auto;
  padding: 8rpx 4rpx;
  color: rgba(122, 84, 33, 0.8);
  font-size: var(--fs-label);
}

.original-dream {
  padding: 28rpx 26rpx;
  border-left: 4rpx solid rgba(184, 134, 59, 0.6);
  background: var(--paper-raised);
}

.original-copy {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.connection-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: var(--space-tight);
}

.connection-item {
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.reading-boundary {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  line-height: 1.65;
}

/* 文化象征 / 心理视角：不再用卡片框，纯段落呈现 */
.cultural-reading,
.psychological-reading {
  padding: 0;
  border-left: 0;
  background: transparent;
}

.dream-chat-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-top: var(--space-group);
  padding: 28rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.16);
  border-radius: 2rpx;
  background: transparent;
}

.chat-entry-copy {
  flex: 1;
  min-width: 0;
}

.chat-entry-question {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.65;
}

.chat-entry-arrow {
  flex: 0 0 52rpx;
  color: var(--gold-line);
  font-size: 40rpx;
  text-align: center;
}

/* result 页唯一的朱砂点睛：进入解读区第一眼看到的标题，前面落一枚印章方块 */
.section-title {
  display: block;
  margin-bottom: var(--space-tight);
  color: var(--ink);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 8rpx;
  margin-right: 10rpx;
  background: var(--cinnabar);
  vertical-align: middle;
}

.reading-copy {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.metaphysical-reading {
  padding: 26rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.5);
  background: var(--paper-raised);
}

.metaphysical-subsection {
  margin-top: var(--space-tight);
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
}

.metaphysical-subtitle {
  display: block;
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.metaphysical-copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.metaphysical-rhythm {
  padding-bottom: 4rpx;
}

.life-note-reading {
  padding: 26rpx;
  border-left: 3rpx solid rgba(184, 134, 59, 0.5);
  background: var(--paper-raised);
}

.life-note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: var(--space-tight);
}

.life-note-date {
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.life-note-link {
  margin-left: auto;
  color: var(--gold-line);
  font-size: var(--fs-label);
}

.life-note-link::after {
  content: " →";
}

.alternative-reading {
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
}

.reading-label {
  display: block;
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 900;
  letter-spacing: 2rpx;
}

.primary-button + .ghost-button {
  margin-top: var(--space-tight);
}

.text-button {
  flex: 1;
  height: 82rpx;
  padding: 0;
  border: 1rpx solid rgba(33, 29, 23, 0.2);
  border-radius: 0;
  background: transparent;
  color: rgba(33, 29, 23, 0.68);
  font-size: var(--fs-aux);
  line-height: 82rpx;
}

.text-button::after {
  border: 0;
}

.share-ready {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  text-align: center;
}

/* 「删除这个梦」不再用朱砂表达危险，降为深墨文字链，与 profile 的
   .clear-field 处理保持一致 */
.delete-button {
  height: 72rpx;
  margin-top: var(--space-tight);
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 72rpx;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.delete-button::after {
  border: 0;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 450px;
  height: 600px;
}

.metaphysical-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.metaphysical-caption {
  color: rgba(33, 29, 23, 0.46);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.metaphysical-resonance {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.72);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

.result-screen .primary-button {
  border-color: #211d17;
  background: #211d17;
  color: #f2ecdf;
}

/* ── 三级阅读结构 ───────────────────────────────────────────────
   第一层 核心观察 → 聊聊这个梦 → 第二层 三个视角 → 第三层 完整展开
   ───────────────────────────────────────────────────────────── */
/* 「核心观察」是这页最重要的一句结论，改用宋体承接梦卡的书卷气，
   字号提到与 .zone-title / .mo-title 同级的标题档 */
.core-observation {
  display: block;
  margin-bottom: var(--space-group);
  color: var(--ink);
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  line-height: 1.5;
}

/* 「三个视角」是第二层阅读的入口，前面留出一整块的疏朗，用旧金线收口 */
.tier-label {
  display: block;
  margin: var(--space-block) 0 4rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid rgba(184, 134, 59, 0.4);
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

.tier-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-group);
  border: 1rpx solid rgba(33, 29, 23, 0.2);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  font-weight: 700;
}

.tier-toggle-icon {
  font-size: var(--fs-aux);
  line-height: 1;
  transition: transform 200ms ease;
}

.tier-toggle-icon.is-open { transform: rotate(180deg); }

.tier-full { margin-top: 8rpx; }

/* ── 底部操作：一个主操作 + 一个次操作，其余收进「更多」 ── */
.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-group);
  color: var(--ink-55);
  font-size: var(--fs-label);
  font-weight: 700;
}

.more-toggle-icon {
  font-size: var(--fs-aux);
  line-height: 1;
  transition: transform 200ms ease;
}

.more-toggle-icon.is-open { transform: rotate(180deg); }

.more-actions {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid rgba(184, 134, 59, 0.4);
}

.more-actions .text-button {
  width: 100% !important;
  min-height: var(--tap-min);
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.08);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: var(--tap-min);
}

.more-actions .delete-button {
  border-bottom: 0;
  color: var(--ink-70);
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.share-button { margin-top: var(--space-tight); }
