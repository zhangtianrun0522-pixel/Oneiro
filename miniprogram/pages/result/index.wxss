.result-screen {
  min-height: 100vh;
  padding: 48rpx 44rpx 64rpx;
  background:
    radial-gradient(circle at 50% 0%, rgba(159, 183, 201, 0.16), transparent 36%),
    #050609;
}

.dream-card {
  min-height: 1030rpx;
  padding: 48rpx 38rpx 44rpx;
  border-radius: 22rpx;
  background: #fdfaf5;
  color: #172033;
  box-shadow: 0 44rpx 140rpx rgba(0, 0, 0, 0.42);
}

.card-header,
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(23, 32, 51, 0.26);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.dream-art {
  position: relative;
  height: 610rpx;
  margin: 46rpx 0 44rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #172438 0%, #425d72 62%, #d8e7ef 100%);
}

.moon {
  position: absolute;
  top: -18rpx;
  right: 72rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(246, 240, 209, 0.9);
}

.shelf {
  position: absolute;
  left: 92rpx;
  right: 92rpx;
  height: 330rpx;
  border-left: 6rpx solid rgba(216, 231, 239, 0.28);
  border-right: 6rpx solid rgba(216, 231, 239, 0.28);
}

.shelf::before,
.shelf::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(216, 231, 239, 0.22);
}

.shelf::before {
  top: 110rpx;
}

.shelf::after {
  top: 220rpx;
}

.shelf-a {
  top: 118rpx;
}

.shelf-b {
  top: 118rpx;
  left: 260rpx;
}

.water {
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -38rpx;
  height: 214rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(196, 220, 231, 0.32);
}

.key {
  position: absolute;
  left: 286rpx;
  bottom: 138rpx;
  width: 100rpx;
  height: 44rpx;
  transform: rotate(-42deg);
  border-radius: 999rpx;
  background: #efe0a0;
}

.key::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: #efe0a0;
}

.bird {
  position: absolute;
  right: 90rpx;
  top: 252rpx;
  width: 116rpx;
  height: 48rpx;
  border-radius: 100% 100% 0 0;
  transform: rotate(-16deg);
  background: rgba(247, 250, 252, 0.76);
}

.card-title {
  display: block;
  text-align: center;
  color: #172033;
  font-size: 58rpx;
  font-weight: 600;
  letter-spacing: 18rpx;
}

.weather {
  display: block;
  margin: 26rpx auto 0;
  width: 86%;
  text-align: center;
  color: rgba(23, 32, 51, 0.54);
  font-size: 24rpx;
  line-height: 1.8;
}

.symbols {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
  margin: 28rpx 0;
}

.symbol {
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(23, 32, 51, 0.08);
  border-radius: 999rpx;
  color: rgba(23, 32, 51, 0.56);
  font-size: 20rpx;
  font-weight: 700;
}

.ritual {
  margin-top: 22rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(23, 32, 51, 0.06);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.42);
  text-align: center;
}

.ritual-label {
  display: block;
  color: rgba(23, 32, 51, 0.2);
  font-size: 16rpx;
  font-weight: 900;
  letter-spacing: 10rpx;
}

.ritual-text {
  display: block;
  margin-top: 12rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 800;
}

.card-footer {
  justify-content: center;
  margin-top: 30rpx;
}

.reading {
  margin-top: 44rpx;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.035);
}

.section-title {
  display: block;
  margin-bottom: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
}

.reading-copy {
  display: block;
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.45);
  font-size: 26rpx;
  line-height: 1.9;
}

.question {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: rgba(159, 183, 201, 0.1);
  color: rgba(255, 255, 255, 0.6);
  font-size: 26rpx;
  line-height: 1.8;
}

.share-button {
  margin-top: 22rpx;
}
