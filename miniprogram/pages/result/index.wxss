.result-screen {
  min-height: 100vh;
  padding: 36rpx 40rpx 84rpx;
  background-color: var(--paper);
  /* 这三个根节点都是不透明的满屏块，会盖住 page 上铺的 --paper-noise。
     原本只写 background: var(--paper)，纸纹到这三屏就断了 —— 解读页与
     分享页恰恰是最需要纸感的两屏。与 app.wxss 的 .screen 保持同一套写法。 */
  background-image: var(--paper-noise);
  background-repeat: repeat;
  background-size: 64rpx 64rpx;
}

.dream-card-switcher {
  position: relative;
  width: 100%;
  height: 100%;
}

.dream-card-stage { height: 840rpx; }

.dream-card-face {
  position: absolute;
  inset: 0;
  overflow: hidden;
  border-radius: 4rpx;
  box-shadow: 0 24rpx 56rpx rgba(33, 29, 23, 0.14);
}

.dream-card-front {
  background: #0a0c10;
}

/* 卡背：稳定的纵向结构，不再用绝对定位。
   标题 → 核心观察 → 分隔线 → 梦中线索 → 留给用户的问题。
   内容短时问题被 margin-top:auto 推到底部，内容长时自然向下增长并内部滚动。
   （旧实现把 .back-question 设成 absolute + bottom，曾经与「统一改 relative」
     的写法叠加导致 bottom 变成"上移一截"，把问题压在梦中线索上；现在的
     .back-question 不再声明 left/right/bottom，只靠 flex + margin-top:auto
     定位，彻底避免这个坑。） */
.dream-card-back {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 44rpx 38rpx;
  overflow-y: auto;
  background-color: #211d17;
  background-image: repeating-linear-gradient(135deg, rgba(184, 134, 59, 0.06) 0, rgba(184, 134, 59, 0.06) 1rpx, transparent 1rpx, transparent 13rpx);
  color: #f2ecdf;
}

.dream-card-back::before { position: absolute; inset: 16rpx; border: 1rpx solid rgba(184, 134, 59, 0.32); content: ''; pointer-events: none; }

.card-face-fade {
  animation: card-face-fade-in 180ms ease-out both;
}

@keyframes card-face-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.front-meta {
  position: absolute;
  z-index: 5;
  left: 34rpx;
  right: 34rpx;
  top: 32rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

/* 卡片「正面」始终是深色艺术图（AI 出图或 CSS 兜底梦象），与页面纸色主题
   无关，因此这里的白字是刻意保留的前景对比色，不随暖纸化改动 */
.front-meta {
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 10rpx rgba(5, 6, 9, 0.72);
}

.front-record {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  letter-spacing: 2rpx;
}

.front-brand {
  letter-spacing: 7rpx;
}

.back-title,
.back-insight,
.back-label,
.back-symbols,
.back-question {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
  text-align: center;
}

/* 与 .back-question 各取一个 auto，剩余空间在"上方留白"和"问题之前"平均分配，
   避免上半拥挤、下半一大片空的失衡 */
.back-title {
  display: block;
  margin-top: auto;
  padding-top: 20rpx;
  color: #f2ecdf;
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.back-insight {
  display: block;
  margin-top: 24rpx;
  color: rgba(242, 236, 223, 0.78);
  font-size: 26rpx;
  line-height: 1.75;
}

.back-divider {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.back-divider::before,
.back-divider::after {
  flex: 1;
  height: 1rpx;
  background: rgba(184, 134, 59, 0.34);
  content: '';
}

.back-divider::after {
  width: auto;
  margin-left: 0;
}

.back-divider > view {
  width: 9rpx;
  height: 9rpx;
  margin: 0 18rpx;
  flex: 0 0 9rpx;
  transform: rotate(45deg);
  background: var(--gold-line);
}

.back-label {
  display: block;
  margin-top: 28rpx;
  color: #d2a459;
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 4rpx;
}

/* margin-bottom 保证内容再长也有呼吸区（flex 子项之间外边距不合并） */
.back-symbols {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 18rpx;
  margin-bottom: 34rpx;
  color: rgba(242, 236, 223, 0.9);
  font-size: var(--fs-aux);
}

.back-symbols text {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.4);
}

.back-symbols text:not(:last-child)::after {
  display: none;
}

.back-question {
  margin-top: auto;          /* 有余量时贴底，内容长时自然接在线索之后 */
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(184, 134, 59, 0.24);
  color: rgba(242, 236, 223, 0.74);
  font-size: var(--fs-aux);
  font-style: italic;
  line-height: 1.7;
}

.card-flip-hint {
  display: block;
  margin: 24rpx 0 0;
  text-align: center;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  letter-spacing: 3rpx;
}

/* 顶部压一层由深到透的渐变，保证 .front-meta 的白字在任何底图
   （AI 出图或 CSS 兜底梦象）上都有足够对比度 */
.dream-art::before {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  left: 0;
  height: 168rpx;
  background: linear-gradient(180deg, rgba(5, 6, 9, 0.58), rgba(5, 6, 9, 0));
  content: '';
  pointer-events: none;
}

.dream-art {
  position: relative;
  height: 100%;
  margin: 0;
  overflow: hidden;
  border-radius: 22rpx;
  background: linear-gradient(145deg, #172438 0%, #425d72 62%, #d8e7ef 100%);
}

.dream-ai-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.98;
  background: #172033;
  animation: dream-image-register 680ms cubic-bezier(0.22, 0.75, 0.24, 1) both;
}

@keyframes dream-image-register {
  0% {
    opacity: 0;
    transform: scale(1.018) translate(3rpx, -2rpx);
    filter: saturate(0.45) contrast(0.9);
  }
  55% {
    opacity: 0.86;
    transform: scale(1.006) translate(-2rpx, 1rpx);
    filter: saturate(1.18) contrast(1.04);
  }
  100% {
    opacity: 0.98;
    transform: scale(1) translate(0, 0);
    filter: saturate(1) contrast(1);
  }
}

.has-ai-image .moon,
.has-ai-image .shelf,
.has-ai-image .water,
.has-ai-image .key,
.has-ai-image .bird {
  display: none;
}

.card-image-notice {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  margin: 18rpx 0 0;
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
}

.image-retry {
  width: auto;
  min-width: 0;
  height: auto;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--gold-line);
  font-size: var(--fs-label);
  font-weight: 800;
  line-height: 1.4;
  text-decoration: underline;
  text-underline-offset: 6rpx;
}

.image-retry::after {
  border: 0;
}

.dream-art.theme-tide {
  background: linear-gradient(145deg, #102832 0%, #356f78 58%, #d5e8df 100%);
}

.dream-art.theme-threshold {
  background: linear-gradient(145deg, #1c2130 0%, #73634a 58%, #ead9aa 100%);
}

.dream-art.theme-shadow {
  background: linear-gradient(145deg, #0d0f16 0%, #273049 56%, #a8b2c3 100%);
}

.dream-art.theme-falling {
  background: linear-gradient(145deg, #191729 0%, #555070 58%, #ead0be 100%);
}

.dream-art.theme-archive {
  background: linear-gradient(145deg, #172033 0%, #5c6573 58%, #e0d8c4 100%);
}

.dream-art.theme-hearth {
  background: linear-gradient(145deg, #201819 0%, #755243 58%, #efd2a6 100%);
}

.dream-art.theme-moon {
  background: linear-gradient(145deg, #10182b 0%, #3e517a 56%, #dfe7f1 100%);
}

.dream-art.theme-mist {
  background: linear-gradient(145deg, #18202a 0%, #68737c 58%, #e4e4dc 100%);
}

/* 下移，避开顶部的 ONEIRO / 编号 / 时间戳条 —— 原本白字正好压在
   淡黄色月亮上，读不出来 */
.moon {
  position: absolute;
  top: 104rpx;
  right: 60rpx;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(246, 240, 209, 0.9);
}

.theme-shadow .moon,
.theme-falling .moon {
  opacity: 0.58;
}

.theme-hearth .moon,
.theme-threshold .moon {
  background: rgba(249, 219, 152, 0.82);
}

.shelf {
  position: absolute;
  left: 92rpx;
  right: 92rpx;
  height: 330rpx;
  border-left: 6rpx solid rgba(216, 231, 239, 0.28);
  border-right: 6rpx solid rgba(216, 231, 239, 0.28);
}

.theme-tide .shelf {
  border-color: rgba(220, 242, 235, 0.2);
}

.theme-shadow .shelf {
  border-color: rgba(190, 204, 226, 0.18);
}

.theme-hearth .shelf,
.theme-threshold .shelf {
  border-color: rgba(255, 230, 180, 0.2);
}

.shelf::before,
.shelf::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 6rpx;
  background: rgba(216, 231, 239, 0.22);
}

.theme-tide .shelf::before,
.theme-tide .shelf::after {
  background: rgba(220, 242, 235, 0.18);
}

.theme-shadow .shelf::before,
.theme-shadow .shelf::after {
  background: rgba(190, 204, 226, 0.16);
}

.theme-hearth .shelf::before,
.theme-hearth .shelf::after,
.theme-threshold .shelf::before,
.theme-threshold .shelf::after {
  background: rgba(255, 230, 180, 0.18);
}

.shelf::before {
  top: 110rpx;
}

.shelf::after {
  top: 220rpx;
}

.shelf-a {
  top: 118rpx;
}

.shelf-b {
  top: 118rpx;
  left: 260rpx;
}

.water {
  position: absolute;
  left: -20rpx;
  right: -20rpx;
  bottom: -38rpx;
  height: 214rpx;
  border-radius: 50% 50% 0 0;
  background: rgba(196, 220, 231, 0.32);
}

.theme-tide .water {
  height: 250rpx;
  background: rgba(186, 228, 224, 0.42);
}

.theme-shadow .water {
  background: rgba(88, 104, 135, 0.28);
}

.theme-hearth .water {
  background: rgba(222, 156, 106, 0.24);
}

.theme-falling .water {
  bottom: -72rpx;
  height: 270rpx;
  background: rgba(230, 195, 190, 0.32);
}

.key {
  position: absolute;
  left: 286rpx;
  bottom: 138rpx;
  width: 100rpx;
  height: 44rpx;
  transform: rotate(-42deg);
  border-radius: 999rpx;
  background: #efe0a0;
}

.theme-shadow .key {
  background: #c3c8d7;
}

.theme-hearth .key,
.theme-threshold .key {
  background: #f1c979;
}

.theme-tide .key {
  background: #d7e8c9;
}

.key::after {
  content: "";
  position: absolute;
  right: -8rpx;
  top: -24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  background: #efe0a0;
}

.theme-shadow .key::after {
  background: #c3c8d7;
}

.theme-hearth .key::after,
.theme-threshold .key::after {
  background: #f1c979;
}

.theme-tide .key::after {
  background: #d7e8c9;
}

.bird {
  position: absolute;
  right: 90rpx;
  top: 252rpx;
  width: 116rpx;
  height: 48rpx;
  border-radius: 100% 100% 0 0;
  transform: rotate(-16deg);
  background: rgba(247, 250, 252, 0.76);
}

.theme-shadow .bird {
  background: rgba(184, 194, 214, 0.54);
}

.theme-hearth .bird,
.theme-threshold .bird {
  background: rgba(255, 236, 199, 0.64);
}

.reading,
.grounded-reading {
  margin-top: var(--space-block);
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.reading-block { margin-top: var(--space-group); }

.milestone-pill {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: var(--space-tight);
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.34);
  border-radius: 2rpx;
  background: var(--paper-raised);
}

.milestone-copy {
  flex: 1;
  min-width: 0;
  color: rgba(122, 84, 33, 0.8);
  font-size: var(--fs-label);
  font-weight: 700;
  line-height: 1.5;
}

.milestone-edit {
  flex: 0 0 auto;
  padding: 8rpx 4rpx;
  color: rgba(122, 84, 33, 0.8);
  font-size: var(--fs-label);
}

/* 设计稿里「你记下的原梦」不再是带纸纹的卡片块，标签在外、
   只有引文本身带左侧细线缩进 */
.original-dream {
  margin-top: var(--space-group);
}

.original-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.original-toggle {
  flex: 0 0 auto;
  padding-left: 16rpx;
  color: var(--gold-ink);
  font-size: 22rpx;
  font-weight: 700;
}

.original-copy {
  display: block;
  margin-top: var(--space-tight);
  padding-left: 24rpx;
  border-left: 4rpx solid rgba(184, 134, 59, 0.4);
  color: var(--ink-70);
  font-size: 26rpx;
  line-height: 1.8;
}

/* 折叠态只留第一行。-webkit-line-clamp 需要配合 -webkit-box 才生效；
   边框和内边距是元素自身的盒模型属性，换 display 不影响，左侧竖线保持不变。 */
.original-copy.is-collapsed {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

/* 每条呼应从一行文字变成了一个可判断的单元（正文 + 两个出口 + 回执），
   条目间距因此从 18rpx 拉开到 32rpx：不然上一条的按钮会贴在下一条的正文上，
   读起来像那组按钮属于下面那句话。 */
.connection-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-top: var(--space-tight);
}

.connection-item {
  display: block;
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

/* 「是这样 / 不太像」和下面「这份解读，贴合你吗」的 chip 是同一类动作——
   都是用户对我们说的话做表态——所以共用一套形状与选中态，只按更贴身的
   尺度收小一号。 */
.connection-verdicts {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.connection-verdict {
  min-height: 52rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  border-radius: 26rpx;
  color: var(--ink-70);
  font-size: 22rpx;
  line-height: 52rpx;
}

.connection-verdict.is-chosen {
  border-color: var(--gold-line);
  background: rgba(184, 134, 59, 0.12);
  color: var(--gold-ink);
}

.connection-verdict-note {
  display: block;
  margin-top: 12rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.6;
}

/* 字面量 rgba(33,29,23,0.42) 约 2.6:1，改用 --ink-70（6.1:1） */
.reading-boundary {
  display: block;
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.65;
}

/* 文化象征 / 心理视角 / 命理视角：设计稿里三个视角是纯文字平铺，
   不再有图标、卡片框或分组标题 */
.cultural-reading,
.psychological-reading {
  padding: 0;
  border-left: 0;
  background: transparent;
}

/* 聊聊这个梦：现在是操作栏之上的独立可点卡片，不再是页面最底部的两行
   朴素文字链——用户反馈那样太容易被忽略。浅底色块（--paper-raised）+
   --gold-line 低透明度描边，读起来像「一张递过来的卡片」，而不是朱砂
   实心的营销按钮。整块都在 bindtap 区域内，加上内边距后自然高度已远
   超 --tap-min，这里仍显式声明 min-height 以确保底线。 */
.dream-chat-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-block);
  padding: 28rpx 26rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.34);
  border-radius: 4rpx;
  background: var(--paper-raised);
}

.chat-entry-copy {
  flex: 1;
  min-width: 0;
}

.chat-entry-question {
  display: block;
  margin-top: 8rpx;
  color: var(--ink);
  font-size: 26rpx;
  line-height: 1.6;
}

/* 箭头装到一个细边圆徽章里，比孤零零的 → 字符更明确地指示「这里可以点进去」，
   同时保持克制——只用边框和旧金墨色，不填充强调色 */
.chat-entry-arrow-badge {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.34);
  border-radius: 50%;
}

.chat-entry-arrow {
  color: var(--gold-ink);
  font-size: 28rpx;
  line-height: 1;
}

/* 「这个梦的观察」：设计稿是 11px 旧金小标签 + 常规字重正文，
   不再是大号宋体展示字，也不再叠朱砂点睛方块 */
.section-title {
  display: block;
  margin-bottom: 16rpx;
  color: var(--gold-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.reading-copy {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.reading-diagnostic {
  display: block;
  margin-top: 14rpx;
  color: rgba(33, 29, 23, 0.48);
  font-size: 22rpx;
  letter-spacing: 0;
}

/* 命理视角内容更丰富（多个子结构），但外层不再套卡片背景/边框，
   与文化象征、心理视角保持同一套「纯文字」视觉语言 */
.metaphysical-reading {
  padding: 0;
  border-left: 0;
  background: transparent;
}

.metaphysical-subsection {
  margin-top: var(--space-tight);
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
}

.metaphysical-subtitle {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.metaphysical-copy {
  display: block;
  margin-top: 10rpx;
  color: rgba(33, 29, 23, 0.76);
  font-size: var(--fs-aux);
  line-height: 1.82;
}

.metaphysical-rhythm {
  padding-bottom: 4rpx;
}

/* 「你之前提到过」同样去卡片化，只保留左侧细线做从属提示 */
.life-note-reading {
  padding-left: 24rpx;
  border-left: 2rpx solid rgba(184, 134, 59, 0.4);
  background: transparent;
}

.life-note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: var(--space-tight);
}

.life-note-date {
  color: var(--ink-70);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.life-note-link {
  margin-left: auto;
  color: var(--gold-ink);
  font-size: var(--fs-label);
}

.life-note-link::after {
  content: " →";
}

.alternative-reading {
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
}

/* 「文化象征 / 心理视角 / 命理视角 / 今天的小行动 / 聊聊这个梦」：编辑视角类
   标签，设计稿字面量 rgba(184,134,59,0.9) 在暖纸底上只有 2.45:1，达不到
   4.5:1，改用已校准过的 --gold-ink（4.84:1），其余规格照抄设计稿。
   「聊聊这个梦」现在是独立卡片入口，用这个更醒目的旧金标签而不是中性墨色，
   帮助它在页面上被看见 */
.reading-label {
  display: block;
  color: var(--gold-ink);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 「你记下的原梦 / 梦里发生了什么 / 与你有关 / 另一种可能」：
   设计稿里这一组是中性墨色标签，字面量 rgba(33,29,23,0.4) 只有约 2.4:1，
   改用 --ink-70（6.1:1）保证达标 */
.reading-label-neutral {
  display: block;
  color: var(--ink-70);
  font-size: 22rpx;
  font-weight: 700;
}

.today-act {
  margin-top: var(--space-group);
  padding: var(--space-group) 0 0;
  border-top: 1rpx solid rgba(33, 29, 23, 0.08);
}

/* 反馈精修区承接初版解读：留白、细线和旧金文字提供层级，不引入高饱和强调色。 */
.dream-refinement {
  margin-top: var(--space-block);
  padding: 30rpx 26rpx 28rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.34);
  border-radius: 4rpx;
  background: var(--paper-raised);
}

.refinement-question {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 27rpx;
  line-height: 1.65;
}

.refinement-input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 164rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  border-radius: 2rpx;
  background: var(--paper);
  color: var(--ink);
  font-size: var(--fs-aux);
  line-height: 1.7;
}

.refinement-placeholder {
  color: var(--ink-55);
}

.refinement-submit {
  width: 100%;
  min-height: var(--tap-min);
  margin: 20rpx 0 0 !important;
  padding: 0 24rpx;
  border: 1rpx solid var(--gold-ink);
  border-radius: 2rpx;
  background: transparent;
  color: var(--gold-ink);
  font-size: var(--fs-aux);
  font-weight: 700;
  line-height: var(--tap-min);
}

.refinement-submit::after {
  border: 0;
}

.refinement-submit[disabled] {
  opacity: 0.55;
}

.refinement-complete {
  margin-top: 24rpx;
  padding: 20rpx 0 0 22rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.1);
  border-left: 3rpx solid rgba(184, 134, 59, 0.52);
}

.refinement-status {
  display: block;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 2rpx;
}

.refinement-answer {
  display: block;
  margin-top: 10rpx;
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: 1.75;
}

.refinement-retry {
  display: inline-block;
  min-height: 52rpx;
  margin: 18rpx 0 0 !important;
  padding: 0 18rpx;
  border: 1rpx solid rgba(184, 134, 59, 0.55);
  border-radius: 2rpx;
  background: transparent;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  line-height: 50rpx;
}

.refinement-retry::after {
  border: 0;
}

/* 底部操作：一行三个平级文字链，替代原来的实心主按钮 + 文字链组合。
   前两个用 --ink-70（6.1:1）而非设计稿字面量 rgba(33,29,23,0.45)
   （约 2.7:1，不达标）；删除用 --cinnabar-ink 实色（5.0:1）而非
   字面量 rgba(193,68,59,0.55)（约 2.2:1，同样不达标）。

   真机坑：这一行原本靠 Unicode 字符 ◌ / ↗ 当图标用，模拟器里三个链
   间距看着均匀，iOS 真机上 ↗（U+2197）会被系统渲染成彩色 emoji、
   ◌（U+25CC）渲染成不一致的字形——字宽、基线、字重都跟中文文本对不上，
   把间距顶得参差不齐。现在改成纯 CSS 画的图标（.action-icon 系列，见
   下方），不依赖任何 Unicode 符号的字形渲染，真机/模拟器表现一致。

   另一个坑（app.wxss 顶部按钮说明已记录过一次）：微信 button 内置
   width:184px 和 margin-left/right:auto 都只认 !important——auto 外
   边距进了 flex 行会把剩余空间均分掉，几个文字链会被摊开成等距分布，
   即使容器只写了 gap。这里 .primary-action-link 显式 margin:0
   !important，避免继承内置 auto margin 把三个链的间距顶乱。 */
/* 三个入口等宽分栏、各自居中：原来是靠固定间距左对齐排下来的，右边留出一整块
   空白，读起来像最后一个按钮掉了，而不是一行完整的操作。 */
.primary-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(33, 29, 23, 0.08);
}

.primary-action-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin: 0 !important;
  flex: 1 1 0;
  min-width: 0;
  min-height: var(--tap-min);
  padding: 0 4rpx;
  color: var(--ink-70);
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1;
}

.primary-action-link[disabled] {
  opacity: 0.5;
}

.primary-action-delete {
  color: var(--cinnabar-ink);
}

/* CSS 绘制的图标：圆圈（收藏）与斜箭头（分享），代替 Unicode 字符 ◌ ↗。
   currentColor 跟随各按钮自己的文字色（收藏/分享是 --ink-70，删除没有
   图标不受影响），尺寸固定，不吃字体渲染的变量。 */
.action-icon {
  flex: 0 0 auto;
  box-sizing: border-box;
}

.icon-save {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.icon-share {
  position: relative;
  width: 18rpx;
  height: 18rpx;
}

.icon-share::before {
  position: absolute;
  left: 1rpx;
  top: 10rpx;
  width: 13rpx;
  height: 2rpx;
  background: currentColor;
  content: '';
  transform: rotate(-45deg);
  transform-origin: left center;
}

.icon-share::after {
  position: absolute;
  right: 0;
  top: 0;
  width: 8rpx;
  height: 8rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  content: '';
}

.text-button {
  margin: 0 !important;
  flex: 1;
  height: 82rpx;
  padding: 0;
  border: 1rpx solid rgba(33, 29, 23, 0.2);
  border-radius: 0;
  background: transparent;
  color: rgba(33, 29, 23, 0.68);
  font-size: var(--fs-aux);
  line-height: 82rpx;
}

.text-button::after {
  border: 0;
}

.share-ready {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.42);
  font-size: var(--fs-label);
  text-align: center;
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 450px;
  height: 600px;
}

.metaphysical-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

/* 「出生节律」小字注解：字面量 rgba(33,29,23,0.46) 约 2.8:1，改用
   --ink-70（6.1:1） */
.metaphysical-caption {
  color: var(--ink-70);
  font-size: var(--fs-label);
  letter-spacing: 2rpx;
}

.metaphysical-resonance {
  display: block;
  margin-top: var(--space-tight);
  color: rgba(33, 29, 23, 0.72);
  font-size: var(--fs-aux);
  line-height: 1.8;
}

/* ── 三级阅读结构 ───────────────────────────────────────────────
   第一层 核心观察 → 第二层 三个视角（平铺，无分组标题）→
   第三层 完整展开 → 今天的小行动 → 聊聊这个梦 → 底部操作
   ───────────────────────────────────────────────────────────── */
/* 「核心观察」按设计稿是常规字重正文，不再是大号宋体展示字 */
.core-observation {
  display: block;
  margin-bottom: 40rpx;
  color: #211d17;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.7;
}

/* 「完整解读」折叠行：设计稿是 space-between 的一行文字，
   左侧标题 12.5px semi-bold，右侧展开/收起 12px，不再是居中的整块边框按钮 */
.tier-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: var(--tap-min);
  margin-top: var(--space-group);
  padding-top: var(--space-group);
  border-top: 1rpx solid rgba(33, 29, 23, 0.08);
}

.tier-toggle-label {
  color: #211d17;
  font-size: 25rpx;
  font-weight: 600;
}

.tier-toggle-icon {
  color: var(--ink-70);
  font-size: 24rpx;
  line-height: 1;
}

.tier-full { margin-top: var(--space-tight); }

/* ── 底部操作：一个主操作 + 一个次操作，其余收进「更多」 ── */
.more-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: var(--tap-min);
  margin-top: var(--space-group);
  color: var(--ink-55);
  font-size: var(--fs-label);
  font-weight: 700;
}

.more-toggle-icon {
  font-size: var(--fs-aux);
  line-height: 1;
  transition: transform 200ms ease;
}

.more-toggle-icon.is-open { transform: rotate(180deg); }

.more-actions {
  display: flex;
  flex-direction: column;
  border-top: 1rpx solid rgba(184, 134, 59, 0.4);
}

.more-actions .text-button {
  width: 100% !important;
  min-height: var(--tap-min);
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.08);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  line-height: var(--tap-min);
}

.more-actions .text-button:last-child {
  border-bottom: 0;
}
.dream-feedback {
  margin-top: var(--space-group);
  padding-top: var(--space-group);
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
}

.feedback-question {
  display: block;
  color: var(--ink-70);
  font-size: var(--fs-label);
}

.feedback-chips {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.feedback-chip {
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.18);
  border-radius: 28rpx;
  background: transparent;
  color: var(--ink-70);
  font-size: 23rpx;
  line-height: 56rpx;
}

.feedback-chip.is-selected {
  border-color: var(--gold-line);
  background: rgba(184, 134, 59, 0.12);
  color: var(--gold-ink);
}

.cloud-sync-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-group);
  padding: 18rpx 20rpx;
  border-left: 3rpx solid var(--gold-line);
  background: rgba(184, 134, 59, 0.08);
  color: var(--ink-70);
  font-size: 23rpx;
}

.cloud-sync-copy {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.cloud-sync-reason {
  display: block;
  margin-top: 6rpx;
  color: var(--ink-45, rgba(33, 29, 23, 0.45));
  font-size: 20rpx;
  word-break: break-all;
}

.dream-chat-entry.has-feedback {
  border-color: rgba(184, 134, 59, 0.65);
  background: rgba(184, 134, 59, 0.08);
}

/* 示例梦。整块用比正文更轻的墨色 + 一条朱砂细线，读起来是「旁白」而不是内容
   的一部分——它必须在扫一眼时就和真实解读区分开。 */
.sample-banner {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: var(--space-group);
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--cinnabar);
  background: var(--paper-raised);
}

.sample-banner-label {
  flex: none;
  color: var(--cinnabar-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.sample-banner-copy {
  flex: 1;
  min-width: 0;
  color: var(--ink-70);
  font-size: var(--fs-label);
  line-height: 1.7;
}

.sample-cta {
  margin-top: var(--space-block);
}

.sample-cta-copy {
  display: block;
  margin-bottom: var(--space-tight);
  color: var(--ink-55);
  font-size: var(--fs-label);
  line-height: 1.7;
  text-align: center;
}

.sample-cta-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: var(--tap-min);
  border: 1rpx solid var(--ink);
  border-radius: 2rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 1rpx;
}
