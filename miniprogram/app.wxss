page {
  /* ── 设计 token ──────────────────────────────────────────────
     暖纸 / 深墨 / 朱砂 / 旧金。朱砂与旧金都在暖纸上做过对比度校准：
       #c1443b 4.29:1 → 只用于图形与大字，不用于小号正文
       #b8863b 2.74:1 → 不达标，栏目标题一律用 --gold-ink 8a5d29 (4.85:1)
       #b8863b 保留给细线、边框等非文字元素
     ─────────────────────────────────────────────────────────── */
  --paper: #f2ecdf;
  --paper-raised: #fbf6ec;
  --ink: #211d17;
  --ink-70: rgba(33, 29, 23, 0.72);
  --ink-55: rgba(33, 29, 23, 0.58);
  --cinnabar: #c1443b;
  --cinnabar-ink: #b23a32;
  --gold-line: #b8863b;
  --gold-ink: #8a5d29;

  /* 纸纹：64×64 灰度噪点 PNG（node 脚本生成，逐像素 alpha ≤ 3.5%），
     以 background-image 平铺在暖纸底色之上，制造「远看均匀、近看有纤维感」
     的质地。体积 1.4KB / base64 1860 字符，远低于 2KB 上限。 */
  --paper-noise: url("data:image/png;base64,");

  /* 字号：五档，从「栏目眉」到「每页至多一处」的大字，拉开梯度而不是
     挤在 22–28rpx 的窄带里 */
  --fs-label: 22rpx;
  --fs-aux: 26rpx;
  --fs-body: 30rpx;
  --fs-title: 38rpx;
  --fs-display: 52rpx;

  /* 字族：日常书写用无衬线，庄重结论/仪式性文字（页面 hero、区块标题、
     卡名、核心观察、分享卡标题）显式切到宋体 + 600 字重 */
  --font-sans: "PingFang SC", "Helvetica Neue", sans-serif;
  --font-serif: "Noto Serif SC", "Songti SC", STSong, serif;

  /* 间距：三档，制造「疏可走马、密不透风」的节奏。
     block=顶级区块之间，group=区块内分组，tight=标题与紧随正文之间 */
  --space-block: 72rpx;
  --space-group: 40rpx;
  --space-tight: 16rpx;

  /* 触控最小尺寸 */
  --tap-min: 88rpx;

  min-height: 100vh;
  background-color: var(--paper);
  background-image: var(--paper-noise);
  background-repeat: repeat;
  background-size: 64rpx 64rpx;
  color: var(--ink);
  font-family: var(--font-sans);
}

view,
text,
button,
textarea,
input {
  box-sizing: border-box;
}

/* 微信 button 内置 width: 184px 且优先级高于页面 wxss 的普通声明
   （height 不受影响），因此凡是要给 button 设宽度的地方都必须带 !important。
   这里先统一复位成 auto，避免任何新增 button 悄悄继承 184px。

   同类坑：内置样式还带 margin-left/right: auto（用于块级居中）。放进 flex
   行时 auto 外边距会均分吞掉容器的全部剩余空间，几个文字链按钮会被摊开成
   等距分布，看起来像设了 space-around——即使容器只写了 gap。这里不能统一
   复位：margin 同样只认 !important，而全局 !important 会打败页面里那些
   刻意用 margin:0 auto 居中的按钮（如首页语音圆环）。因此凡是把 button
   放进 flex 行的地方，都要在该类上显式写 margin: 0 !important。 */
button {
  width: auto !important;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

/* 底部导航已改用微信原生 tabBar，由框架自行预留高度与安全区，
   页面只需留常规的收尾留白 */
.screen {
  min-height: 100vh;
  padding: 56rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  background-color: var(--paper);
  background-image: var(--paper-noise);
  background-repeat: repeat;
  background-size: 64rpx 64rpx;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-block);
  color: rgba(33, 29, 23, 0.64);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 5rpx;
}

/* 全局统一：栏目小标题一律旧金墨色，不再各页各色 */
.eyebrow {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: var(--space-tight);
  color: #211d17;
  font-family: var(--font-serif);
  font-size: var(--fs-title);
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.copy {
  margin-top: var(--space-tight);
  color: var(--ink-70);
  font-size: var(--fs-aux);
  letter-spacing: 0;
  line-height: 1.9;
}

/* 每屏只允许一个实心主按钮 */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: var(--tap-min);
  margin-top: var(--space-group);
  border: 1rpx solid var(--ink);
  border-radius: 2rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: var(--tap-min);
  border: 1rpx solid rgba(33, 29, 23, 0.34);
  border-radius: 2rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 0;
}

.field-label {
  display: block;
  margin: var(--space-group) 0 var(--space-tight);
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.field {
  width: 100%;
  min-height: 86rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.22);
  color: rgba(33, 29, 23, 0.82);
  font-size: var(--fs-body);
  letter-spacing: 0;
}

.muted {
  color: rgba(33, 29, 23, 0.46);
}
