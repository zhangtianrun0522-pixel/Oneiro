page {
  min-height: 100vh;
  background: #f2ecdf;
  color: #211d17;
  font-family: "Noto Serif SC", "Songti SC", STSong, "PingFang SC", serif;
}

view,
text,
button,
textarea,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  padding: 56rpx 40rpx 148rpx;
  background: #f2ecdf;
}

.brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 64rpx;
  color: rgba(33, 29, 23, 0.64);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.eyebrow {
  color: rgba(173, 64, 54, 0.74);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 24rpx;
  color: #211d17;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.copy {
  margin-top: 24rpx;
  color: rgba(33, 29, 23, 0.62);
  font-size: 24rpx;
  letter-spacing: 0;
  line-height: 1.9;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin-top: 36rpx;
  border: 1rpx solid #211d17;
  border-radius: 2rpx;
  background: #211d17;
  color: #f2ecdf;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  border: 1rpx solid rgba(33, 29, 23, 0.34);
  border-radius: 2rpx;
  color: rgba(33, 29, 23, 0.72);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.field-label {
  display: block;
  margin: 34rpx 0 16rpx;
  color: rgba(173, 64, 54, 0.72);
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.field {
  width: 100%;
  min-height: 86rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.22);
  color: rgba(33, 29, 23, 0.82);
  font-size: 28rpx;
  letter-spacing: 0;
}

.muted {
  color: rgba(33, 29, 23, 0.46);
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
  background: rgba(242, 236, 223, 0.96);
  backdrop-filter: blur(12px);
}

.bottom-nav-item {
  position: relative;
  min-width: 120rpx;
  padding: 10rpx 0 16rpx;
  color: rgba(33, 29, 23, 0.48);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.bottom-nav-item.active {
  color: #211d17;
}

.bottom-nav-item.active::after {
  position: absolute;
  right: 34rpx;
  bottom: 4rpx;
  left: 34rpx;
  height: 3rpx;
  background: #ad4036;
  content: "";
}
