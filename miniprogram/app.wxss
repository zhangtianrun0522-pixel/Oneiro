page {
  /* ── 设计 token ──────────────────────────────────────────────
     暖纸 / 深墨 / 朱砂 / 旧金。朱砂与旧金都在暖纸上做过对比度校准：
       #c1443b 4.29:1 → 只用于图形与大字，不用于小号正文
       #b8863b 2.74:1 → 不达标，栏目标题一律用 --gold-ink 8a5d29 (4.85:1)
       #b8863b 保留给细线、边框等非文字元素
     ─────────────────────────────────────────────────────────── */
  --paper: #f2ecdf;
  --paper-raised: #fbf6ec;
  --ink: #211d17;
  --ink-70: rgba(33, 29, 23, 0.72);
  --ink-55: rgba(33, 29, 23, 0.58);
  --cinnabar: #c1443b;
  --cinnabar-ink: #b23a32;
  --gold-line: #b8863b;
  --gold-ink: #8a5d29;

  /* 字号：辅助 ≥22rpx，正文 27–30rpx */
  --fs-label: 22rpx;
  --fs-aux: 24rpx;
  --fs-body: 28rpx;

  /* 触控最小尺寸 */
  --tap-min: 88rpx;

  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  font-family: "Noto Serif SC", "Songti SC", STSong, "PingFang SC", serif;
}

view,
text,
button,
textarea,
input {
  box-sizing: border-box;
}

/* 微信 button 内置 width: 184px 且优先级高于页面 wxss 的普通声明
   （height 不受影响），因此凡是要给 button 设宽度的地方都必须带 !important。
   这里先统一复位成 auto，避免任何新增 button 悄悄继承 184px。 */
button {
  width: auto !important;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

/* 底部固定导航高度 ≈ 82rpx + 安全区，这里统一预留，页面不要再单独覆写 */
.screen {
  min-height: 100vh;
  padding: 56rpx 40rpx calc(168rpx + env(safe-area-inset-bottom));
  background: var(--paper);
}

/* 没有底部导航的页面用这个，省掉多余留白 */
.screen.no-nav {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 64rpx;
  color: rgba(33, 29, 23, 0.64);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

/* 全局统一：栏目小标题一律旧金墨色，不再各页各色 */
.eyebrow {
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 3rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 24rpx;
  color: #211d17;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.copy {
  margin-top: 24rpx;
  color: var(--ink-70);
  font-size: var(--fs-aux);
  letter-spacing: 0;
  line-height: 1.9;
}

/* 每屏只允许一个实心主按钮 */
.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: var(--tap-min);
  margin-top: 36rpx;
  border: 1rpx solid var(--ink);
  border-radius: 2rpx;
  background: var(--ink);
  color: var(--paper);
  font-size: var(--fs-aux);
  font-weight: 800;
  letter-spacing: 1rpx;
}

.ghost-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  min-height: var(--tap-min);
  border: 1rpx solid rgba(33, 29, 23, 0.34);
  border-radius: 2rpx;
  color: var(--ink-70);
  font-size: var(--fs-label);
  font-weight: 700;
  letter-spacing: 0;
}

.field-label {
  display: block;
  margin: 34rpx 0 16rpx;
  color: var(--gold-ink);
  font-size: var(--fs-label);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.field {
  width: 100%;
  min-height: 86rpx;
  border-bottom: 1rpx solid rgba(33, 29, 23, 0.22);
  color: rgba(33, 29, 23, 0.82);
  font-size: 28rpx;
  letter-spacing: 0;
}

.muted {
  color: rgba(33, 29, 23, 0.46);
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  justify-content: space-around;
  padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(33, 29, 23, 0.12);
  background: rgba(242, 236, 223, 0.96);
  backdrop-filter: blur(12px);
}

/* 主导航：整块达到最小触控高度，文字提到 22rpx 并加深 */
.bottom-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 140rpx;
  min-height: var(--tap-min);
  padding: 0;
  color: var(--ink-55);
  font-size: var(--fs-label);
  letter-spacing: 1rpx;
}

.bottom-nav-item.active {
  color: var(--ink);
  font-weight: 700;
}

.bottom-nav-item.active::after {
  position: absolute;
  right: 34rpx;
  bottom: 12rpx;
  left: 34rpx;
  height: 3rpx;
  background: var(--cinnabar);
  content: "";
}
